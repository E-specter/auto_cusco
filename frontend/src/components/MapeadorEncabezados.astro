---
/**
 * Markup for the header mapper (docs/mapeador-encabezados-interfaz.md §3).
 * Behaviour lives in `scripts/mapeador-encabezados.ts`: the page renders this,
 * listens for `mapeocambiado` on the root and then calls `montarMapeador`.
 * Every id inside carries the root's `id`.
 */
import Icon from './Icon.astro';
import '../styles/mapeador.css';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="mapeador" id={id} data-mapeador>
  <p class="mono muted mapeador__contexto" data-contexto></p>

  <div class="notice notice--success" data-listo hidden>
    <Icon name="circle-check" size={20} />
    <div class="mapeador__listo">
      <p data-listo-texto></p>
      <button
        type="button"
        class="btn btn--sm btn--quiet"
        aria-expanded="false"
        aria-controls={`${id}-cuerpo`}
        data-ver-columnas
        data-i18n="mapeador.vista.verColumnas"
      >
        Ver columnas
      </button>
    </div>
  </div>

  <div class="notice notice--danger" data-resumen hidden>
    <Icon name="triangle-alert" size={20} />
    <ul class="mapeador__resumen" data-resumen-lista></ul>
  </div>

  <div class="mapeador__cuerpo" id={`${id}-cuerpo`} data-cuerpo>
    <div class="mapeador__barra">
      <div class="segmented" role="group" aria-label="Mostrar" data-i18n-attr="aria-label:mapeador.vista.mostrar" data-filtro>
        <button type="button" class="segmented__item" aria-pressed="true" data-filtro-opcion="revisar"></button>
        <button type="button" class="segmented__item" aria-pressed="false" data-filtro-opcion="todas"></button>
      </div>
      <button type="button" class="btn btn--sm" data-aceptar-todas hidden></button>
    </div>
    <p class="field__hint" data-i18n="mapeador.vista.hintUso">
      Un campo se usa en una sola columna. Para pasarlo a otra, primero deja la suya en «No cargar».
    </p>
    <p class="visually-hidden" aria-live="polite" data-anuncio></p>
    <p class="visually-hidden" role="status" data-anuncio-busqueda></p>

    <div class="table-scroll">
      <table class="table table--apilable mapeador__tabla">
        <caption class="visually-hidden" data-i18n="mapeador.vista.caption">Columnas del archivo</caption>
        <thead>
          <tr>
            <th scope="col" data-i18n="mapeador.vista.col.columna">Col.</th>
            <th scope="col" data-i18n="mapeador.vista.col.encabezado">Encabezado del archivo</th>
            <th scope="col" data-i18n="mapeador.vista.col.ejemplos">Ejemplos</th>
            <th scope="col" data-i18n="mapeador.vista.col.estado">Estado</th>
            <th scope="col" data-i18n="mapeador.vista.col.campo">Campo de carga</th>
          </tr>
        </thead>
        <tbody data-filas></tbody>
      </table>
    </div>
  </div>

  <!-- RF-64: shown only if the page passes `crearCampo` and a column can still be used. Not a <form>: the mapper may sit inside one. -->
  <div class="mapeador__adicional" data-adicional hidden>
    <p class="mapeador__adicionalPregunta">
      <span data-i18n="mapeador.vista.adicional.pregunta">¿Una columna trae un dato que no está en la lista?</span>
      <button
        type="button"
        class="btn btn--sm"
        aria-expanded="false"
        aria-controls={`${id}-adicional-panel`}
        data-adicional-abrir
        data-i18n="mapeador.vista.adicional.abrir"
      >
        Crear un campo adicional
      </button>
    </p>

    <div class="panel mapeador__adicionalPanel" id={`${id}-adicional-panel`} role="group" aria-labelledby={`${id}-adicional-titulo`} data-adicional-panel hidden>
      <div class="panel__head">
        <h3 class="panel__title" id={`${id}-adicional-titulo`} data-i18n="mapeador.vista.adicional.titulo">Crear un campo adicional</h3>
      </div>
      <div class="panel__body mapeador__adicionalCuerpo">
        <div class="field">
          <label class="field__label" for={`${id}-adicional-columna`} data-i18n="mapeador.vista.adicional.columna">Columna del archivo</label>
          <select class="input" id={`${id}-adicional-columna`} aria-describedby={`${id}-adicional-ejemplos ${id}-adicional-columna-error`} data-adicional-columna></select>
          <p class="field__hint mono" id={`${id}-adicional-ejemplos`} data-adicional-ejemplos></p>
          <p class="field__error" id={`${id}-adicional-columna-error`} data-adicional-columna-error></p>
        </div>

        <div class="field">
          <label class="field__label" for={`${id}-adicional-nombre`} data-i18n="mapeador.vista.adicional.nombre">Nombre del campo</label>
          <input
            class="input"
            type="text"
            id={`${id}-adicional-nombre`}
            maxlength="80"
            autocomplete="off"
            aria-describedby={`${id}-adicional-nombre-hint ${id}-adicional-nombre-error`}
            data-adicional-nombre
          />
          <p class="field__hint" id={`${id}-adicional-nombre-hint`} data-i18n="mapeador.vista.adicional.nombreHint">
            Así lo verás en Cartera, en los textos y en las columnas de carga. Se puede cambiar después.
          </p>
          <p class="field__error" id={`${id}-adicional-nombre-error`} data-adicional-nombre-error></p>
          <p class="mapeador__adicionalUsar" data-adicional-usar-hueco></p>
        </div>

        <fieldset class="field mapeador__tipo" aria-describedby={`${id}-adicional-tipo-hint`}>
          <legend class="field__label" data-i18n="mapeador.vista.adicional.tipo">Tipo de dato</legend>
          <div class="mapeador__tipoOpciones">
            <label class="mapeador__tipoOpcion">
              <input type="radio" name={`${id}-adicional-tipo`} value="texto" data-adicional-tipo />
              <span data-i18n="mapeador.vista.adicional.tipo.texto">Texto</span>
            </label>
            <label class="mapeador__tipoOpcion">
              <input type="radio" name={`${id}-adicional-tipo`} value="numero" data-adicional-tipo />
              <span data-i18n="mapeador.vista.adicional.tipo.numero">Número</span>
            </label>
            <label class="mapeador__tipoOpcion">
              <input type="radio" name={`${id}-adicional-tipo`} value="fecha" data-adicional-tipo />
              <span data-i18n="mapeador.vista.adicional.tipo.fecha">Fecha</span>
            </label>
          </div>
          <p class="field__hint" id={`${id}-adicional-tipo-hint`} data-i18n="mapeador.vista.adicional.tipoHint">
            No se puede cambiar después: para otro tipo, se crea otro campo. Un valor que no sea de este tipo queda vacío y se avisa en su fila.
          </p>
        </fieldset>

        <p class="notice notice--info">
          <Icon name="info" size={20} />
          <span data-i18n="mapeador.vista.adicional.persistencia">El campo queda en el catálogo para las próximas sábanas, aunque canceles esta carga.</span>
        </p>
        <p class="field__error" role="alert" data-adicional-error></p>

        <div class="mapeador__adicionalAcciones">
          <button type="button" class="btn" data-adicional-cancelar data-i18n="mapeador.vista.adicional.cancelar">Cancelar</button>
          <button type="button" class="btn btn--primary" data-adicional-crear>
            <span class="btn__spinner" aria-hidden="true"></span>
            <span class="btn__label" data-i18n="mapeador.vista.adicional.crear">Crear campo</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="notice notice--info" data-advertencias hidden>
    <Icon name="info" size={20} />
    <details class="mapeador__advertencias">
      <summary data-advertencias-titulo></summary>
      <ul data-advertencias-lista></ul>
    </details>
  </div>
</div>
