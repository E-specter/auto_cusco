---
/**
 * MOWA MES follow-up (T-MM-F3): what happened after a campaign was generated.
 * The month's consumption of the SMS limit, the campaigns with their files and
 * exclusions, and the sent report MES returns, reconciled against the load.
 *
 * "Sent" is only what MES reports with status "enviado" (decision E-1). The
 * per-id match count says whether an id belongs to the campaign, never how
 * much was sent, so the screen never labels it as sent.
 */
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/mowa-mes.css';
---

<Shell
  title="Seguimiento de MOWA MES — auto_cusco"
  description="Campañas generadas para MOWA MES, sus archivos y exclusiones, la conciliación del reporte de enviados y el consumo del límite mensual."
>
  <div class="page">
    <header class="page__head">
      <p class="eyebrow" data-i18n="mowaMes.eyebrow">Canales · MOWA MES</p>
      <h1 class="page__title" data-i18n="mowaMes.seguimiento.title">Seguimiento de MOWA MES</h1>
      <p class="page__intro" data-i18n="mowaMes.seguimiento.intro">
        Las campañas generadas, sus archivos, el reporte de enviados que devuelve MES y el consumo del límite mensual.
      </p>
    </header>

    <section class="standIn" data-offline hidden aria-labelledby="mm-offline-title">
      <h2 class="standIn__title" id="mm-offline-title" data-i18n="console.offline.title">Sin conexión con la API</h2>
      <p class="standIn__body" data-i18n="console.offline.body">
        No se pudo contactar con el backend. Comprueba que esté en marcha y vuelve a intentarlo.
      </p>
      <button type="button" class="btn btn--primary" data-reintentar>
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__label" data-i18n="console.offline.retry">Reintentar</span>
      </button>
    </section>

    <div class="mm__contenido" data-contenido hidden>
      <!-- ---- Monthly SMS limit (RF-MM-01) ---------------------------------- -->
      <section class="panel" aria-labelledby="mm-limite-title">
        <div class="panel__head">
          <!-- The only panel title with an icon: it names a gauge (RF-MM-36, §4.1). -->
          <h2 class="panel__title mm-titulo-icono" id="mm-limite-title">
            <Icon name="gauge" size={20} />
            <span data-i18n="mowaMes.seguimiento.limite.title">Límite mensual</span>
          </h2>
          <div class="row mm-mes">
            <button
              type="button"
              class="btn btn--sm btn--icon"
              data-mes-anterior
              data-i18n-attr="aria-label:mowaMes.seguimiento.limite.anterior,title:mowaMes.seguimiento.limite.anterior"
              aria-label="Mes anterior"
              title="Mes anterior"
            >
              <Icon name="chevron-left" size={16} />
            </button>
            <output class="mono mm-mes__valor" data-mes aria-live="polite"></output>
            <button
              type="button"
              class="btn btn--sm btn--icon"
              data-mes-siguiente
              data-i18n-attr="aria-label:mowaMes.seguimiento.limite.siguiente,title:mowaMes.seguimiento.limite.siguiente"
              aria-label="Mes siguiente"
              title="Mes siguiente"
            >
              <Icon name="chevron-right" size={16} />
            </button>
          </div>
        </div>
        <div class="panel__body mm-form">
          <dl class="mm-cifras" data-limite-cifras></dl>
          <!-- The usage, as a bar: the share is already written in «Uso del límite», so this is only to see it. -->
          <div class="mm-uso" aria-hidden="true">
            <div class="mm-uso__relleno" data-limite-barra data-tono="normal"></div>
          </div>
          <p class="mm-costo-mes" data-costo-mes>
            <Icon name="coins" size={16} class="mm-costo-mes__icono" />
            <span data-i18n="mowaMes.seguimiento.costoMes">Costo del mes:</span>{' '}
            <strong class="mm-costo-mes__valor" data-costo-mes-valor></strong>{' '}
            <span class="muted" data-costo-mes-nota hidden></span>
          </p>
          <p class="notice notice--danger" data-limite-excedido hidden>
            <Icon name="triangle-alert" size={20} />
            <span data-limite-excedido-texto></span>
          </p>
          <p class="field__hint" data-i18n="mowaMes.seguimiento.limite.nota">
            Cada campaña cuenta en el mes de su fecha de envío, con productos y supervisión.
          </p>
        </div>
      </section>

      <!-- ---- Campaigns ------------------------------------------------------ -->
      <section class="panel" aria-labelledby="mm-campanas-title">
        <div class="panel__head">
          <h2 class="panel__title" id="mm-campanas-title" data-i18n="mowaMes.seguimiento.campanas.title">Campañas</h2>
          <p class="mono muted mm-nota" data-campanas-cuenta aria-live="polite"></p>
        </div>
        <!-- Active or discarded (RF-MM-31): one list that changes view, kept in the URL (`?vista=`). -->
        <div class="panel__body mm-vistas">
          <div
            class="segmented"
            role="group"
            data-vistas
            data-i18n-attr="aria-label:mowaMes.seguimiento.vista.etiqueta"
            aria-label="Mostrar"
          >
            <button type="button" class="segmented__item" data-vista="activas" aria-pressed="true"></button>
            <button type="button" class="segmented__item" data-vista="descartadas" aria-pressed="false"></button>
          </div>
          <p class="mono muted mm-nota" data-campanas-aviso role="status"></p>
        </div>
        <!-- Only in the discarded view: the month they are listed by, and what that view leaves out (RF-MM-32). -->
        <div class="panel__body mm-descartadas" data-descartadas-controles hidden>
          <div class="field">
            <label class="field__label" for="mm-descartadas-mes">
              <Icon name="calendar" size={16} />
              <span data-i18n="mowaMes.seguimiento.descartadas.mes">Mes de gestión</span>
            </label>
            <select class="input" id="mm-descartadas-mes" data-descartadas-mes></select>
            <p class="field__hint" data-i18n="mowaMes.seguimiento.descartadas.hint">
              Las campañas descartadas no cuentan en el límite, el costo ni las cifras del mes.
            </p>
          </div>
        </div>
        <!-- Above the list: how many of its campaigns still wait for the sent report (RF-MM-33). -->
        <div class="panel__body" data-pendientes hidden>
          <p class="notice notice--warning" role="status">
            <Icon name="triangle-alert" size={20} />
            <span data-pendientes-texto></span>
          </p>
        </div>
        <div data-campanas>
          <p class="empty" data-i18n="common.loading">Cargando</p>
        </div>
        <div class="pager" data-pager data-campanas-pager hidden>
          <button type="button" class="btn btn--sm" data-page-prev>
            <Icon name="chevron-left" size={16} />
            <span data-i18n="console.incidencias.prev">Anteriores</span>
          </button>
          <p class="mono muted pager__rango" data-page-range aria-live="polite"></p>
          <button type="button" class="btn btn--sm" data-page-next>
            <span data-i18n="console.incidencias.next">Siguientes</span>
            <Icon name="chevron-right" size={16} />
          </button>
        </div>
      </section>

      <!-- ---- Selected campaign -------------------------------------------- -->
      <section class="panel" aria-labelledby="mm-detalle-title">
        <div class="panel__head">
          <h2 class="panel__title" id="mm-detalle-title" data-detalle-titulo data-i18n="mowaMes.seguimiento.detalle.titleNinguna">
            Detalle de la campaña
          </h2>
          <p class="mono muted mm-nota" data-detalle-meta></p>
        </div>

        <div class="panel__body">
          <p class="empty" data-detalle-vacio data-i18n="mowaMes.seguimiento.detalle.vacio">
            Elige una campaña para ver su detalle.
          </p>

          <div class="mm-detalle" data-detalle-cuerpo hidden>
            <!-- A campaign with no report imported yet: the next step, and the way to it (RF-MM-33). -->
            <p class="notice notice--warning mm-pendiente" data-pendiente-aviso hidden>
              <Icon name="triangle-alert" size={20} />
              <span data-i18n="mowaMes.seguimiento.pendiente.aviso">
                Falta importar el reporte de enviados de MES. Cuando la campaña se haya enviado, descárgalo de MES e impórtalo aquí.
              </span>
              <button type="button" class="btn btn--sm" data-pendiente-importar>
                <Icon name="upload" size={16} />
                <span data-i18n="mowaMes.seguimiento.pendiente.importar">Importar el reporte</span>
              </button>
            </p>

            <dl class="mm-cifras" data-detalle-cifras></dl>

            <h3 class="mm-subtitulo mm-subtitulo--icono">
              <Icon name="files" size={16} />
              <span data-i18n="mowaMes.seguimiento.archivos.title">Archivos de carga</span>
            </h3>
            <div data-archivos></div>
            <p class="mono muted mm-nota" data-descarga-estado role="status"></p>

            <h3 class="mm-subtitulo" data-reporte-titulo data-i18n="mowaMes.seguimiento.reporte.title">Reporte de enviados</h3>
            <p class="field__hint" data-reporte-descartada hidden data-i18n="mowaMes.seguimiento.descartada.importar">
              Esta campaña está descartada: restáurala para importar su reporte.
            </p>
            <form class="mm-form" data-form-reporte novalidate>
              <p class="field__hint" data-i18n="mowaMes.seguimiento.reporte.intro">
                Sube el reporte que descargas de MES para esta campaña. Cada id de MES del archivo queda asociado a ella.
              </p>
              <div class="field">
                <span class="field__label" id="mm-reporte-label" data-i18n="mowaMes.seguimiento.reporte.archivo">
                  Archivo del reporte
                </span>
                <div class="filepick">
                  <input
                    class="filepick__input"
                    id="mm-reporte"
                    name="archivo"
                    type="file"
                    accept=".xlsx,.xlsb,.xls,.ods,.csv,.tsv,.txt,.json"
                    aria-labelledby="mm-reporte-label"
                    aria-describedby="mm-reporte-hint"
                  />
                  <label class="filepick__button" for="mm-reporte" data-i18n="mowaMes.seguimiento.reporte.elegir">
                    Elegir archivo
                  </label>
                  <span class="filepick__name mono" data-reporte-nombre data-i18n="mowaMes.seguimiento.reporte.sinArchivo">
                    Ningún archivo elegido
                  </span>
                </div>
                <p class="field__hint" id="mm-reporte-hint" data-i18n="mowaMes.seguimiento.reporte.hint">
                  El reporte que descargas de MES, en Excel (.xlsx, .xlsb, .xls, .ods), CSV (.csv, .tsv, .txt) o JSON, hasta 32 MB.
                </p>
              </div>
              <p class="field__error" id="mm-reporte-error" data-reporte-error role="alert"></p>
              <div class="mm-form__foot">
                <button type="submit" class="btn btn--primary" data-reporte-importar>
                  <span class="btn__spinner" aria-hidden="true"></span>
                  <Icon name="upload" size={16} />
                  <span class="btn__label" data-i18n="mowaMes.seguimiento.reporte.importar">Importar reporte</span>
                </button>
                <p class="mono muted" data-reporte-estado role="status"></p>
              </div>
            </form>

            <h3 class="mm-subtitulo" data-i18n="mowaMes.seguimiento.conciliacion.title">Conciliación</h3>
            <div class="mm-detalle" data-conciliacion></div>

            <h3 class="mm-subtitulo mm-subtitulo--icono">
              <Icon name="ban" size={16} />
              <span data-i18n="mowaMes.seguimiento.exclusiones.title">Exclusiones</span>
            </h3>
            <div class="mm-exclusiones__controles">
              <label class="field__label" for="mm-exclusiones-filtro" data-i18n="mowaMes.seguimiento.exclusiones.filtro">Motivo</label>
              <select class="input" id="mm-exclusiones-filtro" data-exclusiones-filtro></select>
              <p class="mono muted mm-nota" data-exclusiones-cuenta aria-live="polite"></p>
            </div>
            <div data-exclusiones></div>
            <div class="pager" data-pager data-exclusiones-pager hidden>
              <button type="button" class="btn btn--sm" data-page-prev>
                <Icon name="chevron-left" size={16} />
                <span data-i18n="console.incidencias.prev">Anteriores</span>
              </button>
              <p class="mono muted pager__rango" data-page-range aria-live="polite"></p>
              <button type="button" class="btn btn--sm" data-page-next>
                <span data-i18n="console.incidencias.next">Siguientes</span>
                <Icon name="chevron-right" size={16} />
              </button>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- ---- A MES id already imported: replace it? ------------------------ -->
  <dialog class="dialog" data-dialog="reemplazar" aria-labelledby="mm-reemplazar-title">
    <div class="dialog__head">
      <div>
        <h2 id="mm-reemplazar-title" data-i18n="mowaMes.seguimiento.reemplazar.title">Este reporte ya estaba importado</h2>
        <p class="muted dialog__intro" data-i18n="mowaMes.seguimiento.reemplazar.body">
          Si reemplazas, las filas de ese id de MES se sustituyen por las del archivo nuevo y la conciliación se recalcula.
        </p>
      </div>
    </div>
    <div class="dialog__body">
      <p class="notice notice--warning">
        <Icon name="triangle-alert" size={20} />
        <span data-reemplazar-detalle></span>
      </p>
    </div>
    <div class="dialog__foot">
      <button type="button" class="btn" data-close data-reemplazar-cancelar data-i18n="mowaMes.seguimiento.reemplazar.cancelar">
        No reemplazar
      </button>
      <button type="button" class="btn btn--danger" data-reemplazar-confirmar data-i18n="mowaMes.seguimiento.reemplazar.confirmar">
        Reemplazar
      </button>
    </div>
  </dialog>

  <!-- Discard, restore or delete a campaign (RF-MM-31, RF-MM-32): one dialog for the three. -->
  <dialog class="dialog" data-dialog="confirmar" aria-labelledby="mm-confirmar-title">
    <div class="dialog__head">
      <h2 id="mm-confirmar-title" data-confirmar-titulo></h2>
    </div>
    <div class="dialog__body">
      <p data-confirmar-cuerpo></p>
      <p class="notice notice--warning" data-confirmar-reporte hidden>
        <Icon name="triangle-alert" size={20} />
        <span data-i18n="mowaMes.confirmar.descartar.conReporte">
          Esta campaña ya tiene reporte de enviados. Si se envió, su consumo deja de contar en el límite del mes.
        </span>
      </p>
      <div data-confirmar-eliminar hidden>
        <p class="notice notice--danger">
          <Icon name="triangle-alert" size={20} />
          <span data-confirmar-peligro></span>
        </p>
        <label class="choice choice--check">
          <input type="checkbox" data-confirmar-casilla />
          <span class="choice__body">
            <span class="choice__title" data-i18n="mowaMes.confirmar.eliminar.casilla">Entiendo que no se puede deshacer</span>
          </span>
        </label>
      </div>
      <p class="field__error" data-confirmar-error role="alert"></p>
    </div>
    <div class="dialog__foot">
      <button type="button" class="btn" data-close data-confirmar-cancelar data-i18n="mowaMes.confirmar.cancelar">
        Cancelar
      </button>
      <button type="button" class="btn btn--primary" data-confirmar-aceptar>
        <span class="btn__spinner" aria-hidden="true"></span>
        <span data-confirmar-icono></span>
        <span class="btn__label" data-confirmar-etiqueta></span>
      </button>
    </div>
  </dialog>

  <!-- The icons of a row's tags and actions: rendered once here, cloned per row. -->
  <template data-icono-pendiente><Icon name="hourglass" size={16} /></template>
  <template data-icono-archivar><Icon name="archive" size={16} /></template>
  <template data-icono-restaurar><Icon name="archive-restore" size={16} /></template>
  <template data-icono-ver><Icon name="eye" size={16} /></template>
  <template data-icono-descargar><Icon name="download" size={16} /></template>
  <!-- The labels of the detail's figures (RF-MM-36, §3.1): the same icon for the same concept across the module. -->
  <template data-icono-cargados><Icon name="file-up" size={16} /></template>
  <template data-icono-supervision><Icon name="user-check" size={16} /></template>
  <template data-icono-excluidos><Icon name="ban" size={16} /></template>
  <template data-icono-advertencias><Icon name="triangle-alert" size={16} /></template>
  <template data-icono-costo><Icon name="coins" size={16} /></template>
  <template data-icono-eliminar><Icon name="trash-2" size={16} /></template>

  <!-- ---- Generic failure ---------------------------------------------- -->
  <dialog class="dialog" data-dialog="error" aria-labelledby="mm-error-title">
    <div class="dialog__head">
      <h2 id="mm-error-title" data-i18n="common.error">Algo salió mal</h2>
    </div>
    <div class="dialog__body">
      <p class="notice notice--danger">
        <Icon name="circle-alert" size={20} />
        <span data-error-body></span>
      </p>
    </div>
    <div class="dialog__foot">
      <button type="button" class="btn btn--primary" data-close data-i18n="common.close">Cerrar</button>
    </div>
  </dialog>
</Shell>

<script>
  import { ApiError, NetworkError, mensajeDeError } from '../../lib/api';
  import { $, ocupado } from '../../lib/dom';
  import { pintarPaginador } from '../../lib/paginacion';
  import { celda, celdaDeFila, cifra, tabla, vacio } from '../../lib/tabla-dom';
  import {
    consumoLimite,
    descargarArchivoCampana,
    descartarCampana,
    eliminarCampana,
    importarReporte,
    listarCampanas,
    listarDescartadas,
    listarExclusiones,
    obtenerCampana,
    obtenerConciliacion,
    restaurarCampana,
    type ArchivoCampana,
    type Campana,
    type CodigoMowaMes,
    type Conciliacion,
    type ConsumoLimite,
    type EstadoConteo,
    type EstadoCosto,
    type EstadoCostoEstimado,
    type ListaCampanas,
    type ListaDescartadas,
    type PaginaExclusiones,
  } from '../../lib/api-mowa-mes';
  import { guardarArchivo } from '../../lib/descargas';
  import { openWhenFree } from '../../lib/dialogs';
  import {
    formatBytes,
    formatDate,
    formatDateTime,
    formatMes,
    formatMesGestion,
    formatNumber,
    formatSoles,
    formatTarifa,
  } from '../../lib/format';
  import { applyTranslations, locale, t, traducirPorPrefijo } from '../../lib/i18n';
  import { presentarCosto, traducirCodigo, type PresentacionCosto } from '../../lib/mowa-mes';
  import {
    CODIGOS_EXCLUSION,
    advertirAlDescartar,
    anchoDeLaBarra,
    busquedaConVista,
    campanaDeLaUrl,
    detalleDeExclusion,
    elegirMesDescartadas,
    fechaDeDescarte,
    filasConciliacion,
    leerResumenDescarga,
    mesDe,
    moverMes,
    nombreArchivo,
    opcionesDeMeses,
    ordenarEstados,
    pendienteVisible,
    rangoPagina,
    tonoDelUso,
    usoDelLimite,
    vistaDeLaUrl,
    type VistaCampanas,
  } from '../../lib/mowa-mes-seguimiento';

  const POR_PAGINA_CAMPANAS = 20;
  const POR_PAGINA_EXCLUSIONES = 50;

  const estado = {
    mes: mesDe(new Date()),
    consumo: null as ConsumoLimite | null,
    campanas: null as ListaCampanas | null,
    desplazamientoCampanas: 0,
    /** Active or discarded: what `?vista=` says, and what the buttons change. */
    vista: vistaDeLaUrl(window.location.search) as VistaCampanas,
    /** The discarded campaigns of `mesDescartadas`, with every month that has any and how many there are in all. */
    descartadas: null as ListaDescartadas | null,
    mesDescartadas: '',
    campanaId: null as number | null,
    /** The campaign a link asked for when it is not on the page of the list (an older one). */
    campanaAparte: null as Campana | null,
    conciliacion: null as Conciliacion | null,
    exclusiones: null as PaginaExclusiones | null,
    codigo: '' as CodigoMowaMes | '',
    desplazamientoExclusiones: 0,
  };

  const dialogos = {
    reemplazar: $<HTMLDialogElement>('[data-dialog="reemplazar"]'),
    confirmar: $<HTMLDialogElement>('[data-dialog="confirmar"]'),
    error: $<HTMLDialogElement>('[data-dialog="error"]'),
  };

  document.querySelectorAll<HTMLElement>('[data-close]').forEach((boton) => {
    boton.addEventListener('click', () => boton.closest('dialog')?.close());
  });

  // ---- Shared helpers -----------------------------------------------------------

  function mostrarError(error: unknown): void {
    $<HTMLElement>('[data-error-body]').textContent = mensajeDeError(error);
    void openWhenFree(dialogos.error);
  }

  function avisar(nodo: HTMLElement, texto: string): void {
    nodo.textContent = texto;
    window.setTimeout(() => {
      if (nodo.textContent === texto) nodo.textContent = '';
    }, 4000);
  }

  // ---- Costs (RF-MM-24): the API sends the amounts worked out, as text --------------------------

  const AYUDA_SIN_TARIFA = 'mowaMes.costo.noDisponible.ayuda';

  /** The words for a cost that is not an amount. The state decides, never a null amount. */
  function textoDeCosto(presentacion: Exclude<PresentacionCosto, { tipo: 'monto' }>): string {
    return t(presentacion.tipo === 'pendiente' ? 'mowaMes.costo.pendiente' : 'mowaMes.costo.noDisponible');
  }

  /** An amount sits in the numeric column; the two other states are muted text, not a number. */
  function celdaCosto(estadoCosto: EstadoCosto | EstadoCostoEstimado, monto: string | null): HTMLTableCellElement {
    const presentacion = presentarCosto(estadoCosto, monto);
    if (presentacion.tipo === 'monto') return celda('td', formatSoles(presentacion.valor), 'num');
    const nodo = celda('td', textoDeCosto(presentacion), 'muted');
    if (presentacion.tipo === 'no_disponible') {
      const ayuda = t(AYUDA_SIN_TARIFA);
      nodo.title = ayuda;
      nodo.setAttribute('aria-description', ayuda);
    }
    return nodo;
  }

  function cifraDeCosto(
    etiqueta: string,
    estadoCosto: EstadoCosto | EstadoCostoEstimado,
    monto: string | null,
    tarifa: string | null,
  ): HTMLElement {
    const presentacion = presentarCosto(estadoCosto, monto);
    const pista = tarifa === null ? undefined : t('mowaMes.costo.tarifa', { tarifa: formatTarifa(tarifa) });
    // The label carries the cost's icon whether the value is an amount or not (§3.2: the value stays muted text).
    if (presentacion.tipo === 'monto') return cifra(etiqueta, formatSoles(presentacion.valor), pista, false, icono('costo'));
    return cifra(
      etiqueta,
      textoDeCosto(presentacion),
      presentacion.tipo === 'no_disponible' ? t(AYUDA_SIN_TARIFA) : pista,
      true,
      icono('costo'),
    );
  }

  /** What the real cost is now: the loaded reconciliation is fresher than the list row. */
  function costoRealVigente(campana: Campana): { estado: EstadoCosto; monto: string | null } {
    const conciliacion = estado.conciliacion;
    return conciliacion && conciliacion.campana_id === campana.id
      ? { estado: conciliacion.costo_real_estado, monto: conciliacion.costo_real }
      : { estado: campana.costo_real_estado, monto: campana.costo_real };
  }

  function textoEstados(estados: readonly EstadoConteo[]): string {
    return estados.length === 0
      ? '—'
      : ordenarEstados(estados)
          .map((e) => `${e.estado} ${formatNumber(e.cantidad)}`)
          .join('  ·  ');
  }

  /** The API pages by offset: the range of what came back, out of the total. */
  function pintarPaginas(
    raiz: HTMLElement,
    pagina: { total: number; desplazamiento: number },
    enPagina: number,
  ): void {
    const rango = rangoPagina(pagina.desplazamiento, enPagina, pagina.total);
    pintarPaginador(raiz, rango && { ...rango, total: pagina.total });
  }

  // ---- Monthly limit -----------------------------------------------------------

  /** The usage bar: how much of the limit is loaded, in the tone of how close it is (accent, signal, danger). */
  function pintarBarraDeUso(consumo: ConsumoLimite | null): void {
    const barra = $<HTMLElement>('[data-limite-barra]');
    barra.dataset.tono = consumo ? tonoDelUso(consumo) : 'normal';
    barra.style.inlineSize = `${consumo ? anchoDeLaBarra(consumo) : 0}%`;
  }

  function pintarLimite(): void {
    $<HTMLElement>('[data-mes]').textContent = formatMesGestion(estado.mes);
    const host = $<HTMLElement>('[data-limite-cifras]');
    host.replaceChildren();
    const consumo = estado.consumo;
    pintarBarraDeUso(consumo);
    if (!consumo) return;

    const uso = new Intl.NumberFormat(locale(), { style: 'percent', maximumFractionDigits: 1 }).format(
      usoDelLimite(consumo),
    );
    host.append(
      cifra(t('mowaMes.seguimiento.limite.cargados'), formatNumber(consumo.cargados_mes)),
      cifra(t('mowaMes.seguimiento.limite.limite'), formatNumber(consumo.limite)),
      cifra(t('mowaMes.seguimiento.limite.disponible'), formatNumber(consumo.disponible)),
      cifra(t('mowaMes.seguimiento.limite.uso'), uso),
    );

    // The month's cost, and how many campaigns it leaves out for having no stored rate.
    // The figure in the scale of the limit's; the note only when some campaign has no rate.
    $<HTMLElement>('[data-costo-mes-valor]').textContent = formatSoles(consumo.costo_mes);
    const nota = $<HTMLElement>('[data-costo-mes-nota]');
    nota.hidden = consumo.campanas_sin_tarifa === 0;
    nota.textContent =
      consumo.campanas_sin_tarifa === 0
        ? ''
        : `· ${
            consumo.campanas_sin_tarifa === 1
              ? t('mowaMes.seguimiento.costoMes.sinTarifaUna')
              : t('mowaMes.seguimiento.costoMes.sinTarifa', { n: formatNumber(consumo.campanas_sin_tarifa) })
          }`;

    $<HTMLElement>('[data-limite-excedido]').hidden = !consumo.excedido;
    $<HTMLElement>('[data-limite-excedido-texto]').textContent = t('mowaMes.seguimiento.limite.excedido', {
      cargados: formatNumber(consumo.cargados_mes),
      limite: formatNumber(consumo.limite),
    });
  }

  async function cambiarMes(delta: -1 | 1): Promise<void> {
    const mes = moverMes(estado.mes, delta);
    estado.mes = mes;
    $<HTMLElement>('[data-mes]').textContent = formatMesGestion(mes);
    try {
      const consumo = await consumoLimite(mes);
      // A quick double click may have moved on; paint only the month in view.
      if (estado.mes !== mes) return;
      estado.consumo = consumo;
      pintarLimite();
    } catch (caido) {
      mostrarError(caido);
    }
  }

  $<HTMLButtonElement>('[data-mes-anterior]').addEventListener('click', () => void cambiarMes(-1));
  $<HTMLButtonElement>('[data-mes-siguiente]').addEventListener('click', () => void cambiarMes(1));

  // ---- Campaigns ---------------------------------------------------------------

  const campanaActual = (): Campana | null =>
    estado.campanas?.campanas.find((c) => c.id === estado.campanaId) ??
    estado.descartadas?.campanas.find((c) => c.id === estado.campanaId) ??
    (estado.campanaAparte?.id === estado.campanaId ? estado.campanaAparte : null);

  /** The campaigns the list shows now, in its order. */
  const campanasDeLaVista = (): Campana[] =>
    (estado.vista === 'activas' ? estado.campanas?.campanas : estado.descartadas?.campanas) ?? [];

  /** The tag of a campaign whose sent report has not been imported yet (RF-MM-33). */
  function etiquetaPendiente(): HTMLElement {
    const etiqueta = document.createElement('span');
    etiqueta.className = 'tag tag--advertencia mm-pendiente__tag';
    etiqueta.append(icono('pendiente'), document.createTextNode(t('mowaMes.estado.pendienteReporte')));
    return etiqueta;
  }

  /** Above the list: how many campaigns, of the whole list and not only this page, still wait for their report. */
  function pintarPendientes(pagina: ListaCampanas): void {
    const cuantas = pagina.total_pendientes;
    $<HTMLElement>('[data-pendientes]').hidden = cuantas === 0 || estado.vista !== 'activas';
    $<HTMLElement>('[data-pendientes-texto]').textContent =
      cuantas === 0
        ? ''
        : t(cuantas === 1 ? 'mowaMes.seguimiento.pendientesUna' : 'mowaMes.seguimiento.pendientes', {
            n: formatNumber(cuantas),
          });
  }

  /** A template's icon, cloned for one more use. */
  function icono(
    nombre:
      | 'pendiente'
      | 'archivar'
      | 'restaurar'
      | 'eliminar'
      | 'ver'
      | 'descargar'
      | 'cargados'
      | 'supervision'
      | 'excluidos'
      | 'advertencias'
      | 'costo',
  ): Node {
    return $<HTMLTemplateElement>(`template[data-icono-${nombre}]`).content.cloneNode(true);
  }

  /** The tag of a discarded campaign and, under it, the day it was set aside (RF-MM-32). */
  function marcaDeDescartada(descartadaEn: string): Node[] {
    const etiqueta = document.createElement('span');
    etiqueta.className = 'tag tag--neutral mm-descartada__tag';
    etiqueta.append(icono('archivar'), document.createTextNode(t('mowaMes.estado.descartada')));
    const cuando = document.createElement('span');
    cuando.className = 'mono muted mm-descartada__el';
    cuando.textContent = t('mowaMes.seguimiento.descartadas.el', { fecha: fechaDeDescarte(descartadaEn) });
    return [etiqueta, cuando];
  }

  /** «Activas (N) · Descartadas (M)»: N from the active list, M from the discarded one (its only source). */
  function pintarVistas(): void {
    const totales = { activas: estado.campanas?.total ?? 0, descartadas: estado.descartadas?.total_descartadas ?? 0 };
    document.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((boton) => {
      const vista = boton.dataset.vista as VistaCampanas;
      boton.textContent = t(`mowaMes.seguimiento.vista.${vista}`, { n: formatNumber(totales[vista]) });
      boton.setAttribute('aria-pressed', String(vista === estado.vista));
    });
  }

  /** The months that have discarded campaigns, newest first, as the filter's options. */
  function pintarMesesDescartadas(): void {
    const selector = $<HTMLSelectElement>('[data-descartadas-mes]');
    const opciones = opcionesDeMeses(estado.descartadas?.meses ?? []);
    selector.replaceChildren(...opciones.map(({ valor, texto }) => new Option(texto, valor)));
    selector.value = estado.mesDescartadas;
    $<HTMLElement>('[data-descartadas-controles]').hidden = estado.vista !== 'descartadas' || opciones.length === 0;
  }

  function accionDeCampana(accion: Accion, campana: Campana): HTMLButtonElement {
    const boton = document.createElement('button');
    boton.type = 'button';
    boton.className = accion === 'eliminar' ? 'btn btn--sm btn--danger' : 'btn btn--sm';
    boton.append(icono(ACCIONES[accion].icono), document.createTextNode(t(`mowaMes.accion.${accion}`)));
    boton.setAttribute('aria-label', t(ACCIONES[accion].titulo, { id: campana.id }));
    boton.addEventListener('click', () => void pedirConfirmacion(accion, campana));
    return boton;
  }

  function pintarCampanas(): void {
    const host = $<HTMLElement>('[data-campanas]');
    const cuenta = $<HTMLElement>('[data-campanas-cuenta]');
    const paginador = $<HTMLElement>('[data-campanas-pager]');
    host.replaceChildren();
    const pagina = estado.campanas;
    if (!pagina) return;
    pintarPendientes(pagina);
    pintarVistas();
    pintarMesesDescartadas();

    const enDescartadas = estado.vista === 'descartadas';
    const lista = campanasDeLaVista();
    const total = enDescartadas ? lista.length : pagina.total;
    cuenta.textContent =
      total === 1
        ? t('mowaMes.seguimiento.campanas.cuentaUno')
        : t('mowaMes.seguimiento.campanas.cuenta', { total: formatNumber(total) });

    if (lista.length === 0) {
      host.append(vacio(t(enDescartadas ? 'mowaMes.seguimiento.descartadas.vacio' : 'mowaMes.seguimiento.campanas.vacio')));
      paginador.hidden = true;
      return;
    }

    const { envoltorio, cuerpo } = tabla('mm-campanas__tabla', [
      [t('mowaMes.seguimiento.campanas.col.id'), true],
      [t('mowaMes.seguimiento.campanas.col.creada'), false],
      [t('mowaMes.seguimiento.campanas.col.descripcion'), false],
      [t('mowaMes.seguimiento.campanas.col.envio'), false],
      [t('mowaMes.seguimiento.campanas.col.productos'), true],
      [t('mowaMes.seguimiento.campanas.col.supervision'), true],
      [t('mowaMes.seguimiento.campanas.col.total'), true],
      [t('mowaMes.seguimiento.campanas.col.costoEstimado'), true],
      [t('mowaMes.seguimiento.campanas.col.costoReal'), true],
      [t('mowaMes.seguimiento.campanas.col.excluidos'), true],
      [t('mowaMes.seguimiento.campanas.col.archivos'), true],
      [t('mowaMes.seguimiento.campanas.col.accion'), false],
    ]);

    lista.forEach((campana) => {
      const fila = document.createElement('tr');
      fila.dataset.seleccionada = String(campana.id === estado.campanaId);
      fila.dataset.campanaFila = String(campana.id);

      const ver = document.createElement('button');
      ver.type = 'button';
      ver.className = 'btn btn--sm';
      ver.append(icono('ver'), document.createTextNode(t('mowaMes.seguimiento.campanas.ver')));
      ver.setAttribute('aria-label', t('mowaMes.seguimiento.campanas.verAria', { id: campana.id }));
      ver.setAttribute('aria-pressed', String(campana.id === estado.campanaId));
      ver.addEventListener('click', () => void elegirCampana(campana.id));
      const acciones = document.createElement('div');
      acciones.className = 'mm-acciones';
      acciones.append(ver);
      if (campana.descartada_en === null) acciones.append(accionDeCampana('descartar', campana));
      else acciones.append(accionDeCampana('restaurar', campana), accionDeCampana('eliminar', campana));
      const accion = document.createElement('td');
      accion.append(acciones);

      // A discarded campaign never shows as pending: it is out of the count and the way to import is closed.
      const descripcion = celda('td', campana.descripcion);
      if (pendienteVisible(campana)) descripcion.append(etiquetaPendiente());
      if (campana.descartada_en !== null) descripcion.append(...marcaDeDescartada(campana.descartada_en));

      fila.append(
        celda('td', String(campana.id), 'num'),
        celda('td', formatDateTime(campana.creado_en), 'mono'),
        descripcion,
        celda('td', formatDate(campana.fecha_envio), 'mono'),
        celda('td', formatNumber(campana.productos_cargados), 'num'),
        celda('td', formatNumber(campana.supervision_cargados), 'num'),
        celda('td', formatNumber(campana.total_cargados), 'num'),
        celdaCosto(campana.costo_estimado_estado, campana.costo_estimado),
        celdaCosto(campana.costo_real_estado, campana.costo_real),
        celda('td', formatNumber(campana.excluidos), 'num'),
        celda('td', formatNumber(campana.archivos.length), 'num'),
        accion,
      );
      cuerpo.append(fila);
    });

    host.append(envoltorio);
    // The API does not page the discarded ones: a month's worth fits in one list.
    if (enDescartadas) paginador.hidden = true;
    else pintarPaginas(paginador, pagina, pagina.campanas.length);
  }

  async function cargarCampanas(): Promise<void> {
    estado.campanas = await listarCampanas({
      limite: POR_PAGINA_CAMPANAS,
      desplazamiento: estado.desplazamientoCampanas,
    });
    pintarCampanas();
  }

  /**
   * The discarded campaigns of the month in view. Without a month chosen (or when the chosen one has no more)
   * it opens on the most recent; the first answer already says which months there are.
   */
  async function cargarDescartadas(): Promise<void> {
    let lista = await listarDescartadas(estado.mesDescartadas || undefined);
    const mes = elegirMesDescartadas(lista.meses, estado.mesDescartadas);
    if (mes !== estado.mesDescartadas) {
      estado.mesDescartadas = mes;
      if (mes) lista = await listarDescartadas(mes);
    }
    estado.descartadas = lista;
    pintarCampanas();
  }

  async function cambiarVista(vista: VistaCampanas, enHistorial: boolean): Promise<void> {
    if (vista === estado.vista) return;
    estado.vista = vista;
    if (enHistorial) {
      window.history.pushState(null, '', `${window.location.pathname}${busquedaConVista(window.location.search, vista)}`);
    }
    pintarCampanas();
    if (vista === 'descartadas') {
      try {
        await cargarDescartadas();
      } catch (caido) {
        mostrarError(caido);
      }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((boton) => {
    boton.addEventListener('click', () => void cambiarVista(boton.dataset.vista as VistaCampanas, true));
  });
  // Back and forward restore the view the URL names.
  window.addEventListener('popstate', () => void cambiarVista(vistaDeLaUrl(window.location.search), false));

  $<HTMLSelectElement>('[data-descartadas-mes]').addEventListener('change', (evento) => {
    estado.mesDescartadas = (evento.currentTarget as HTMLSelectElement).value;
    void cargarDescartadas().catch(mostrarError);
  });

  // ---- Discard, restore, delete (RF-MM-31, RF-MM-32) ------------------------------------------------

  type Accion = 'descartar' | 'restaurar' | 'eliminar';

  const ACCIONES: Record<
    Accion,
    {
      titulo: string;
      cuerpo: string;
      hecho: string;
      icono: 'archivar' | 'restaurar' | 'eliminar';
      clase: string;
      llamar: (id: number) => Promise<unknown>;
    }
  > = {
    descartar: {
      titulo: 'mowaMes.confirmar.descartar.titulo',
      cuerpo: 'mowaMes.confirmar.descartar.cuerpo',
      hecho: 'mowaMes.seguimiento.descartada',
      icono: 'archivar',
      clase: 'btn btn--primary',
      llamar: descartarCampana,
    },
    restaurar: {
      titulo: 'mowaMes.confirmar.restaurar.titulo',
      cuerpo: 'mowaMes.confirmar.restaurar.cuerpo',
      hecho: 'mowaMes.seguimiento.restaurada',
      icono: 'restaurar',
      clase: 'btn btn--primary',
      llamar: restaurarCampana,
    },
    eliminar: {
      titulo: 'mowaMes.confirmar.eliminar.tituloCampana',
      cuerpo: 'mowaMes.confirmar.eliminar.cuerpoCampana',
      hecho: 'mowaMes.seguimiento.eliminada',
      icono: 'eliminar',
      clase: 'btn btn--danger',
      llamar: eliminarCampana,
    },
  };

  const confirmacion = { accion: null as Accion | null, campana: null as Campana | null };
  const aceptar = $<HTMLButtonElement>('[data-confirmar-aceptar]');
  const casilla = $<HTMLInputElement>('[data-confirmar-casilla]');
  const errorConfirmar = $<HTMLElement>('[data-confirmar-error]');

  /** Deleting for good waits for the checkbox; the other two are ready as soon as they open. */
  function actualizarAceptar(): void {
    aceptar.disabled = confirmacion.accion === 'eliminar' && !casilla.checked;
  }

  casilla.addEventListener('change', actualizarAceptar);

  /** The words of a campaign error: its code's text, or the server's own sentence for a code this build lacks. */
  function textoDeErrorDeCampana(error: unknown): string {
    return error instanceof ApiError && error.codigo
      ? traducirPorPrefijo('mowaMes.errorCampana', error.codigo, mensajeDeError(error))
      : mensajeDeError(error);
  }

  async function pedirConfirmacion(accion: Accion, campana: Campana): Promise<void> {
    const config = ACCIONES[accion];
    confirmacion.accion = accion;
    confirmacion.campana = campana;
    $<HTMLElement>('[data-confirmar-titulo]').textContent = t(config.titulo, { id: campana.id });
    const cuerpo = $<HTMLElement>('[data-confirmar-cuerpo]');
    cuerpo.hidden = accion === 'eliminar';
    cuerpo.textContent = accion === 'eliminar' ? '' : t(config.cuerpo);
    $<HTMLElement>('[data-confirmar-reporte]').hidden = !(accion === 'descartar' && advertirAlDescartar(campana));
    $<HTMLElement>('[data-confirmar-eliminar]').hidden = accion !== 'eliminar';
    $<HTMLElement>('[data-confirmar-peligro]').textContent = accion === 'eliminar' ? t(config.cuerpo) : '';
    casilla.checked = false;
    errorConfirmar.textContent = '';
    aceptar.className = config.clase;
    $<HTMLElement>('[data-confirmar-icono]').replaceChildren(icono(config.icono));
    $<HTMLElement>('[data-confirmar-etiqueta]').textContent = t(`mowaMes.accion.${accion}`);
    actualizarAceptar();
    await openWhenFree(dialogos.confirmar);
    // Neither discarding nor deleting is what Enter should do by accident.
    $<HTMLButtonElement>('[data-confirmar-cancelar]').focus();
  }

  /** The detail of a campaign that just left its view has nothing left to show. */
  function cerrarDetalle(): void {
    estado.campanaId = null;
    estado.campanaAparte = null;
    estado.conciliacion = null;
    estado.exclusiones = null;
    reiniciarReporte();
    pintarDetalle();
    pintarConciliacion();
    pintarExclusiones();
  }

  /** Both lists and the month's consumption: any of the three actions changes all of them. */
  async function recargarTodo(): Promise<void> {
    await Promise.all([
      cargarCampanas(),
      cargarDescartadas(),
      consumoLimite(estado.mes).then((consumo) => {
        estado.consumo = consumo;
        pintarLimite();
      }),
    ]);
    // The last row of a page may have been the one that left.
    if (estado.campanas?.campanas.length === 0 && estado.desplazamientoCampanas > 0) {
      estado.desplazamientoCampanas = Math.max(0, estado.desplazamientoCampanas - POR_PAGINA_CAMPANAS);
      await cargarCampanas();
    }
  }

  /** Focus goes to the row that took the place of the one that left or, with none, to the views control. */
  function enfocarSiguiente(id: number | null): void {
    const fila = id === null ? null : document.querySelector<HTMLElement>(`[data-campana-fila="${id}"] button`);
    (fila ?? document.querySelector<HTMLElement>('[data-vista][aria-pressed="true"]'))?.focus();
  }

  aceptar.addEventListener('click', async () => {
    const { accion, campana } = confirmacion;
    if (!accion || !campana) return;
    errorConfirmar.textContent = '';
    const lista = campanasDeLaVista();
    const siguiente = lista[lista.findIndex((c) => c.id === campana.id) + 1]?.id ?? null;
    ocupado(aceptar, true);
    try {
      await ACCIONES[accion].llamar(campana.id);
      dialogos.confirmar.close();
      if (estado.campanaId === campana.id) cerrarDetalle();
      await recargarTodo();
      pintarDetalle();
      avisar($<HTMLElement>('[data-campanas-aviso]'), t(ACCIONES[accion].hecho, { id: campana.id }));
      enfocarSiguiente(siguiente);
    } catch (caido) {
      errorConfirmar.textContent = textoDeErrorDeCampana(caido);
      // The lists may be out of date (another tab got there first): read them again, quietly.
      if (caido instanceof ApiError) void recargarTodo().catch(() => undefined);
    } finally {
      ocupado(aceptar, false);
      actualizarAceptar();
    }
  });

  async function moverCampanas(delta: -1 | 1): Promise<void> {
    estado.desplazamientoCampanas = Math.max(0, estado.desplazamientoCampanas + delta * POR_PAGINA_CAMPANAS);
    try {
      await cargarCampanas();
    } catch (caido) {
      mostrarError(caido);
    }
  }

  const paginadorCampanas = $<HTMLElement>('[data-campanas-pager]');
  paginadorCampanas.querySelector('[data-page-prev]')!.addEventListener('click', () => void moverCampanas(-1));
  paginadorCampanas.querySelector('[data-page-next]')!.addEventListener('click', () => void moverCampanas(1));

  // ---- Selected campaign -------------------------------------------------------

  function pintarDetalle(): void {
    const campana = campanaActual();
    const titulo = $<HTMLElement>('[data-detalle-titulo]');
    $<HTMLElement>('[data-detalle-vacio]').hidden = Boolean(campana);
    $<HTMLElement>('[data-detalle-cuerpo]').hidden = !campana;
    $<HTMLElement>('[data-pendiente-aviso]').hidden = !campana || !pendienteVisible(campana);
    // A discarded campaign takes no report until it is restored.
    const descartada = campana?.descartada_en != null;
    $<HTMLElement>('[data-reporte-titulo]').hidden = descartada;
    $<HTMLElement>('[data-reporte-descartada]').hidden = !descartada;
    formReporte.hidden = descartada;

    if (!campana) {
      titulo.dataset.i18n = 'mowaMes.seguimiento.detalle.titleNinguna';
      titulo.textContent = t('mowaMes.seguimiento.detalle.titleNinguna');
      $<HTMLElement>('[data-detalle-meta]').textContent = '';
      return;
    }

    // Interpolated, so the generic re-translation pass must leave it alone.
    delete titulo.dataset.i18n;
    titulo.textContent = t('mowaMes.seguimiento.detalle.title', { id: campana.id });
    $<HTMLElement>('[data-detalle-meta]').textContent = t('mowaMes.seguimiento.detalle.meta', {
      corte: formatDate(campana.fecha_corte),
      envio: formatDate(campana.fecha_envio),
      mes: formatMes(campana.mes_imputacion),
      speech: campana.speech.nombre,
    });

    const cifras = $<HTMLElement>('[data-detalle-cifras]');
    cifras.replaceChildren(
      cifra(t('mowaMes.seguimiento.detalle.productos'), formatNumber(campana.productos_cargados)),
      cifra(t('mowaMes.seguimiento.detalle.supervision'), formatNumber(campana.supervision_cargados), undefined, false, icono('supervision')),
      cifra(t('mowaMes.seguimiento.detalle.total'), formatNumber(campana.total_cargados), undefined, false, icono('cargados')),
      cifra(t('mowaMes.seguimiento.detalle.excluidos'), formatNumber(campana.excluidos), undefined, false, icono('excluidos')),
      cifra(t('mowaMes.seguimiento.detalle.advertencias'), formatNumber(campana.advertencias), undefined, false, icono('advertencias')),
      cifraDeCosto(
        t('mowaMes.seguimiento.detalle.costoEstimado'),
        campana.costo_estimado_estado,
        campana.costo_estimado,
        campana.tarifa_sms,
      ),
      cifraDeCosto(
        t('mowaMes.seguimiento.detalle.costoReal'),
        costoRealVigente(campana).estado,
        costoRealVigente(campana).monto,
        campana.tarifa_sms,
      ),
    );

    pintarArchivos(campana);
  }

  function pintarArchivos(campana: Campana): void {
    const host = $<HTMLElement>('[data-archivos]');
    host.replaceChildren();
    const { envoltorio, cuerpo } = tabla('mm-archivos__tabla', [
      [t('mowaMes.seguimiento.archivos.col.numero'), true],
      [t('mowaMes.seguimiento.archivos.col.nombre'), false],
      [t('mowaMes.seguimiento.archivos.col.filas'), true],
      [t('mowaMes.seguimiento.archivos.col.supervision'), true],
      [t('mowaMes.seguimiento.archivos.col.bytes'), true],
      [t('mowaMes.seguimiento.archivos.col.accion'), false],
    ]);

    campana.archivos.forEach((archivo) => {
      const fila = document.createElement('tr');
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.className = 'btn btn--sm';
      const spinner = document.createElement('span');
      spinner.className = 'btn__spinner';
      spinner.setAttribute('aria-hidden', 'true');
      const etiqueta = document.createElement('span');
      etiqueta.className = 'btn__label';
      etiqueta.textContent = t('mowaMes.seguimiento.archivos.descargar');
      boton.append(spinner, icono('descargar'), etiqueta);
      boton.setAttribute('aria-label', t('mowaMes.seguimiento.archivos.descargarAria', { n: archivo.numero }));
      boton.addEventListener('click', () => void descargar(campana, archivo, boton));
      const accion = document.createElement('td');
      accion.append(boton);

      fila.append(
        celda('td', String(archivo.numero), 'num'),
        celda('td', archivo.nombre, 'mono mm-nombre'),
        celda('td', formatNumber(archivo.filas), 'num'),
        celda('td', formatNumber(archivo.supervision), 'num'),
        celda('td', formatBytes(archivo.bytes), 'num'),
        accion,
      );
      cuerpo.append(fila);
    });

    host.append(envoltorio);
  }

  async function descargar(campana: Campana, archivo: ArchivoCampana, boton: HTMLButtonElement): Promise<void> {
    ocupado(boton, true);
    try {
      const descargado = await descargarArchivoCampana(campana.id, archivo.numero);
      guardarArchivo(descargado.blob, nombreArchivo(descargado.nombre, campana.id, archivo.numero));
      const resumen = leerResumenDescarga(descargado.resumen);
      avisar(
        $<HTMLElement>('[data-descarga-estado]'),
        t('mowaMes.seguimiento.archivos.descargado', {
          archivo: resumen.archivo ?? archivo.numero,
          total: resumen.total ?? campana.archivos.length,
          filas: formatNumber(resumen.filas ?? archivo.filas),
          supervision: formatNumber(resumen.supervision ?? archivo.supervision),
        }),
      );
    } catch (caido) {
      mostrarError(caido);
    } finally {
      ocupado(boton, false);
    }
  }

  $<HTMLButtonElement>('[data-pendiente-importar]').addEventListener('click', () => {
    inputReporte.scrollIntoView({ block: 'center' });
    inputReporte.focus();
  });

  async function elegirCampana(id: number): Promise<void> {
    estado.campanaId = id;
    estado.conciliacion = null;
    estado.exclusiones = null;
    estado.codigo = '';
    estado.desplazamientoExclusiones = 0;
    selectFiltro.value = '';
    reiniciarReporte();
    pintarCampanas();
    pintarDetalle();
    pintarConciliacion();
    pintarExclusiones();

    try {
      const [conciliacion] = await Promise.all([obtenerConciliacion(id), cargarExclusiones()]);
      if (estado.campanaId !== id) return;
      estado.conciliacion = conciliacion;
      pintarConciliacion();
      pintarDetalle();
    } catch (caido) {
      mostrarError(caido);
    }
  }

  // ---- Sent report -------------------------------------------------------------

  const formReporte = $<HTMLFormElement>('[data-form-reporte]');
  const inputReporte = $<HTMLInputElement>('#mm-reporte');
  const nombreReporte = $<HTMLElement>('[data-reporte-nombre]');
  const errorReporte = $<HTMLElement>('[data-reporte-error]');

  function limpiarErrorReporte(): void {
    errorReporte.textContent = '';
    inputReporte.removeAttribute('aria-invalid');
    inputReporte.setAttribute('aria-describedby', 'mm-reporte-hint');
  }

  function fallarReporte(texto: string): void {
    errorReporte.textContent = texto;
    inputReporte.setAttribute('aria-invalid', 'true');
    inputReporte.setAttribute('aria-describedby', 'mm-reporte-hint mm-reporte-error');
  }

  function reiniciarReporte(): void {
    formReporte.reset();
    nombreReporte.dataset.i18n = 'mowaMes.seguimiento.reporte.sinArchivo';
    nombreReporte.textContent = t('mowaMes.seguimiento.reporte.sinArchivo');
    limpiarErrorReporte();
  }

  inputReporte.addEventListener('change', () => {
    limpiarErrorReporte();
    const archivo = inputReporte.files?.[0];
    if (!archivo) return;
    nombreReporte.textContent = archivo.name;
    delete nombreReporte.dataset.i18n;
  });

  async function importar(reemplazar: boolean): Promise<void> {
    const id = estado.campanaId;
    if (id === null) return;
    limpiarErrorReporte();

    const archivo = inputReporte.files?.[0];
    if (!archivo) {
      fallarReporte(t('mowaMes.seguimiento.reporte.error.archivo'));
      inputReporte.focus();
      return;
    }

    const boton = $<HTMLButtonElement>('[data-reporte-importar]');
    ocupado(boton, true);
    try {
      const conciliacion = await importarReporte(id, archivo, reemplazar);
      if (estado.campanaId !== id) return;
      estado.conciliacion = conciliacion;
      pintarConciliacion();
      pintarDetalle();
      // The list row carries the real cost too, and it just changed.
      void cargarCampanas().then(pintarDetalle).catch(mostrarError);
      avisar($<HTMLElement>('[data-reporte-estado]'), t('mowaMes.seguimiento.reporte.importado'));
    } catch (caido) {
      if (caido instanceof ApiError && caido.status === 409 && caido.codigo === 'campana_descartada') {
        fallarReporte(textoDeErrorDeCampana(caido));
      } else if (caido instanceof ApiError && caido.status === 409 && !reemplazar) {
        $<HTMLElement>('[data-reemplazar-detalle]').textContent = caido.detail;
        // Replacing overwrites imported rows, so keeping them is what Enter does.
        void openWhenFree(dialogos.reemplazar).then(() =>
          $<HTMLButtonElement>('[data-reemplazar-cancelar]').focus(),
        );
      } else if (caido instanceof ApiError && caido.status === 413) {
        fallarReporte(t('mowaMes.seguimiento.reporte.error.grande'));
      } else if (caido instanceof ApiError && caido.status === 400) {
        fallarReporte(caido.detail || t('common.errorBody'));
      } else {
        fallarReporte(mensajeDeError(caido));
      }
    } finally {
      ocupado(boton, false);
    }
  }

  formReporte.addEventListener('submit', (evento) => {
    evento.preventDefault();
    void importar(false);
  });

  $<HTMLButtonElement>('[data-reemplazar-confirmar]').addEventListener('click', () => {
    dialogos.reemplazar.close();
    void importar(true);
  });

  // ---- Reconciliation ----------------------------------------------------------

  function pintarConciliacion(): void {
    const host = $<HTMLElement>('[data-conciliacion]');
    host.replaceChildren();
    const conciliacion = estado.conciliacion;
    if (!conciliacion) {
      host.append(vacio(t('common.loading')));
      return;
    }
    if (conciliacion.reportes.length === 0) {
      host.append(vacio(t('mowaMes.seguimiento.conciliacion.vacio')));
      return;
    }

    conciliacion.advertencias.forEach((advertencia) => {
      const aviso = document.createElement('p');
      aviso.className = 'notice notice--warning';
      aviso.textContent = t('mowaMes.seguimiento.conciliacion.advertenciaId', {
        motivo: traducirCodigo(advertencia.codigo, advertencia.detalle),
        id: advertencia.mes_id,
      });
      host.append(aviso);
    });

    const grupos = tabla('mm-conciliacion__tabla', [
      [t('mowaMes.seguimiento.conciliacion.col.grupo'), false],
      [t('mowaMes.seguimiento.conciliacion.col.cargados'), true],
      [t('mowaMes.seguimiento.conciliacion.col.enviados'), true],
      [t('mowaMes.seguimiento.conciliacion.col.noEnviados'), true],
      [t('mowaMes.seguimiento.conciliacion.col.estados'), false],
    ]);
    filasConciliacion(conciliacion).forEach(({ grupo, cifras }) => {
      const fila = document.createElement('tr');
      fila.dataset.grupo = grupo;
      fila.append(
        celdaDeFila(t(`mowaMes.seguimiento.conciliacion.grupo.${grupo}`)),
        celda('td', formatNumber(cifras.cargados), 'num'),
        celda('td', formatNumber(cifras.enviados), 'num'),
        celda('td', formatNumber(cifras.no_enviados), 'num'),
        celda('td', textoEstados(cifras.por_estado), 'mono mm-estados'),
      );
      grupos.cuerpo.append(fila);
    });
    host.append(grupos.envoltorio);

    const nota = document.createElement('p');
    nota.className = 'field__hint';
    nota.textContent = t('mowaMes.seguimiento.conciliacion.nota');
    host.append(nota);

    const sin = document.createElement('p');
    sin.className = 'mm-conciliacion__sin';
    sin.textContent = t('mowaMes.seguimiento.conciliacion.sinCorrespondencia', {
      n: formatNumber(conciliacion.sin_correspondencia),
    });
    if (conciliacion.sin_correspondencia > 0) {
      const estados = document.createElement('span');
      estados.className = 'mono mm-estados';
      estados.textContent = `  ${textoEstados(conciliacion.sin_correspondencia_por_estado)}`;
      sin.append(estados);
    }
    host.append(sin);

    const costo = document.createElement('p');
    costo.className = 'mm-conciliacion__costo';
    const real = presentarCosto(conciliacion.costo_real_estado, conciliacion.costo_real);
    costo.textContent =
      real.tipo === 'monto'
        ? t('mowaMes.seguimiento.conciliacion.costoReal', {
            monto: formatSoles(real.valor),
            enviados: formatNumber(conciliacion.total.enviados),
            tarifa: formatTarifa(conciliacion.tarifa_sms),
          })
        : t('mowaMes.seguimiento.conciliacion.costoRealSin', { motivo: textoDeCosto(real) });
    host.append(costo);

    const ids = tabla('mm-ids__tabla', [
      [t('mowaMes.seguimiento.conciliacion.col.mesId'), false],
      [t('mowaMes.seguimiento.conciliacion.col.filas'), true],
      [t('mowaMes.seguimiento.conciliacion.col.coinciden'), true],
    ]);
    conciliacion.por_id.forEach((porId) => {
      const fila = document.createElement('tr');
      fila.append(
        celda('td', String(porId.mes_id), 'mono'),
        celda('td', formatNumber(porId.filas), 'num'),
        celda('td', formatNumber(porId.con_correspondencia), 'num'),
      );
      ids.cuerpo.append(fila);
    });
    const tituloIds = document.createElement('h4');
    tituloIds.className = 'field__label';
    tituloIds.textContent = t('mowaMes.seguimiento.conciliacion.ids');
    const notaIds = document.createElement('p');
    notaIds.className = 'field__hint';
    notaIds.textContent = t('mowaMes.seguimiento.conciliacion.idsNota');
    host.append(tituloIds, ids.envoltorio, notaIds);

    const tituloReportes = document.createElement('h4');
    tituloReportes.className = 'field__label';
    tituloReportes.textContent = t('mowaMes.seguimiento.conciliacion.reportes');
    const lista = document.createElement('ul');
    lista.className = 'mono mm-reportes';
    conciliacion.reportes.forEach((reporte) => {
      const item = document.createElement('li');
      item.textContent = t('mowaMes.seguimiento.conciliacion.reporte', {
        id: reporte.mes_id,
        archivo: reporte.nombre_archivo,
        filas: formatNumber(reporte.filas),
        fecha: formatDateTime(reporte.importado_en),
      });
      lista.append(item);
    });
    host.append(tituloReportes, lista);
  }

  // ---- Exclusions --------------------------------------------------------------

  const selectFiltro = $<HTMLSelectElement>('[data-exclusiones-filtro]');

  function pintarFiltro(): void {
    const elegido = selectFiltro.value;
    selectFiltro.replaceChildren();
    const todos = document.createElement('option');
    todos.value = '';
    todos.textContent = t('mowaMes.seguimiento.exclusiones.todos');
    selectFiltro.append(todos);
    CODIGOS_EXCLUSION.forEach((codigo) => {
      const opcion = document.createElement('option');
      opcion.value = codigo;
      opcion.textContent = t(`mowaMes.seguimiento.exclusiones.motivo.${codigo}`);
      selectFiltro.append(opcion);
    });
    selectFiltro.value = elegido;
  }

  function pintarExclusiones(): void {
    const host = $<HTMLElement>('[data-exclusiones]');
    const cuenta = $<HTMLElement>('[data-exclusiones-cuenta]');
    const paginador = $<HTMLElement>('[data-exclusiones-pager]');
    host.replaceChildren();
    const pagina = estado.exclusiones;
    if (!pagina) {
      cuenta.textContent = '';
      paginador.hidden = true;
      return;
    }

    cuenta.textContent =
      pagina.total === 1
        ? t('mowaMes.seguimiento.exclusiones.cuentaUno')
        : t('mowaMes.seguimiento.exclusiones.cuenta', { total: formatNumber(pagina.total) });

    if (pagina.exclusiones.length === 0) {
      host.append(
        vacio(t(estado.codigo ? 'mowaMes.seguimiento.exclusiones.vacioFiltro' : 'mowaMes.seguimiento.exclusiones.vacio')),
      );
      paginador.hidden = true;
      return;
    }

    const { envoltorio, cuerpo } = tabla('mm-exclusiones__tabla', [
      [t('mowaMes.seguimiento.exclusiones.col.pagare'), false],
      [t('mowaMes.seguimiento.exclusiones.col.motivo'), false],
      [t('mowaMes.seguimiento.exclusiones.col.detalle'), false],
    ]);
    pagina.exclusiones.forEach((exclusion) => {
      const fila = document.createElement('tr');
      const motivo = document.createElement('td');
      const tag = document.createElement('span');
      tag.className = 'tag tag--error';
      tag.textContent = t(`mowaMes.seguimiento.exclusiones.motivo.${exclusion.codigo}`);
      motivo.append(tag);
      fila.append(
        celda('td', exclusion.pagare, 'mono'),
        motivo,
        celda('td', detalleDeExclusion(exclusion)),
      );
      cuerpo.append(fila);
    });
    host.append(envoltorio);
    pintarPaginas(paginador, pagina, pagina.exclusiones.length);
  }

  async function cargarExclusiones(): Promise<void> {
    const id = estado.campanaId;
    if (id === null) return;
    const pagina = await listarExclusiones(id, {
      codigo: estado.codigo || undefined,
      limite: POR_PAGINA_EXCLUSIONES,
      desplazamiento: estado.desplazamientoExclusiones,
    });
    if (estado.campanaId !== id) return;
    estado.exclusiones = pagina;
    pintarExclusiones();
  }

  async function recargarExclusiones(): Promise<void> {
    try {
      await cargarExclusiones();
    } catch (caido) {
      mostrarError(caido);
    }
  }

  selectFiltro.addEventListener('change', () => {
    estado.codigo = selectFiltro.value as CodigoMowaMes | '';
    estado.desplazamientoExclusiones = 0;
    void recargarExclusiones();
  });

  const paginadorExclusiones = $<HTMLElement>('[data-exclusiones-pager]');
  paginadorExclusiones.querySelector('[data-page-prev]')!.addEventListener('click', () => {
    estado.desplazamientoExclusiones = Math.max(0, estado.desplazamientoExclusiones - POR_PAGINA_EXCLUSIONES);
    void recargarExclusiones();
  });
  paginadorExclusiones.querySelector('[data-page-next]')!.addEventListener('click', () => {
    estado.desplazamientoExclusiones += POR_PAGINA_EXCLUSIONES;
    void recargarExclusiones();
  });

  // ---- Boot --------------------------------------------------------------------

  function sinConexion(si: boolean): void {
    $<HTMLElement>('[data-offline]').hidden = !si;
    $<HTMLElement>('[data-contenido]').hidden = si;
    document.dispatchEvent(new CustomEvent('healthchanged'));
  }

  /** Opens the campaign the URL names, even if it is not on this page of the list. `false` if there is none. */
  async function abrirPedida(id: number | null): Promise<boolean> {
    if (id === null) return false;
    if (!estado.campanas?.campanas.some((campana) => campana.id === id)) {
      try {
        estado.campanaAparte = await obtenerCampana(id);
      } catch {
        return false;
      }
    }
    await elegirCampana(id);
    return true;
  }

  async function arrancar(): Promise<void> {
    try {
      const [consumo, campanas, descartadas] = await Promise.all([
        consumoLimite(estado.mes),
        listarCampanas({ limite: POR_PAGINA_CAMPANAS, desplazamiento: estado.desplazamientoCampanas }),
        // Its totals feed the counter of the views even while the active list is the one in view.
        listarDescartadas(),
      ]);
      estado.consumo = consumo;
      estado.campanas = campanas;
      estado.descartadas = descartadas;
      estado.mesDescartadas = elegirMesDescartadas(descartadas.meses, estado.mesDescartadas);
      // Opened on the discarded view (`?vista=descartadas`): the month it opens on is the newest.
      if (estado.vista === 'descartadas' && estado.mesDescartadas) {
        estado.descartadas = await listarDescartadas(estado.mesDescartadas);
      }
      sinConexion(false);
      pintarFiltro();
      pintarLimite();
      pintarCampanas();
      pintarDetalle();
      // `?campana=<id>` opens that one (the link of «Para subir a MES»); otherwise the most recent, which is
      // where a follow-up usually starts.
      const primera = campanas.campanas[0];
      if (estado.campanaId === null && !(await abrirPedida(campanaDeLaUrl(window.location.search)))) {
        if (primera) await elegirCampana(primera.id);
      }
    } catch (caido) {
      if (caido instanceof NetworkError) {
        sinConexion(true);
      } else {
        sinConexion(false);
        mostrarError(caido);
      }
    }
  }

  const reintentar = $<HTMLButtonElement>('[data-reintentar]');
  reintentar.addEventListener('click', async () => {
    ocupado(reintentar, true);
    try {
      await arrancar();
    } finally {
      ocupado(reintentar, false);
    }
  });

  // A language switch repaints what the script drew.
  document.addEventListener('languagechange', () => {
    applyTranslations();
    pintarFiltro();
    pintarLimite();
    pintarCampanas();
    pintarDetalle();
    pintarConciliacion();
    pintarExclusiones();
  });

  void arrancar();
</script>
