  } from '../../lib/mowa-mes-borrador-campana';
  import { enlaceEditarEnCartera, seleccionDeLaUrl } from '../../lib/volver';

  /** Same debounce the speech and portfolio screens use. */
  const ESPERA_PREVISUALIZACION = 400;

  const estado = {
    seleccion: null as EstadoSeleccion | null,
    supervisionConfigurada: null as ConfiguracionSupervision | null,
    configuracion: null as ConfiguracionMowaMes | null,
    plantillaEditada: false,
    versionesSpeech: [] as VersionSpeech[],
    siguienteDia: null as string | null,
    fechasMultiples: [''] as string[],
    supervisoresPropios: [] as SupervisorBorrador[],
    descripcionEditada: false,
    previsualizacion: null as PrevisualizacionCampana | null,
    paginaExclusiones: 1,
    paginaMuestra: 1,
    error404: null as string | null,
    huellaInvalida: false,
    /** No speech version is enabled: there is nothing to build a campaign with (RF-MM-29). */
    sinSpeech: false,
    campanaCreada: null as Campana | null,
  };

  const dialogos = {
    limite: $<HTMLDialogElement>('[data-dialog="limite"]'),
    error: $<HTMLDialogElement>('[data-dialog="error"]'),
  };

  document.querySelectorAll<HTMLElement>('[data-close]').forEach((boton) => {
    boton.addEventListener('click', () => boton.closest('dialog')?.close());
  });

  // ---- Shared helpers -----------------------------------------------------------

  function mostrarError(texto: string): void {
    $<HTMLElement>('[data-error-body]').textContent = texto;
    void openWhenFree(dialogos.error);
  }

  function botonIcono(etiqueta: string, direccion: 'arriba' | 'abajo'): HTMLButtonElement {
    const nodo = document.createElement('button');
    nodo.type = 'button';
    nodo.className = 'btn btn--sm btn--icon supervisores-mover';
    nodo.setAttribute('aria-label', etiqueta);
    nodo.title = etiqueta;
    const plantilla = $<HTMLTemplateElement>(`template[data-icono-${direccion}]`);
    nodo.append(plantilla.content.cloneNode(true));
    return nodo;
  }

  function botonQuitar(etiqueta: string): HTMLButtonElement {
    const nodo = document.createElement('button');
    nodo.type = 'button';
    nodo.className = 'btn btn--sm btn--icon';
    nodo.setAttribute('aria-label', etiqueta);
    nodo.title = etiqueta;
    nodo.append($<HTMLTemplateElement>('template[data-icono-quitar]').content.cloneNode(true));
    return nodo;
  }

  // ---- Reading the form into a CampanaBorrador -----------------------------------

  function seleccionUsable(): { usable: true } | { usable: false; motivo: string } {
    const sel = estado.seleccion;
    if (!sel || !sel.fechaCorte) return { usable: false, motivo: t('mowaMes.campana.guardia.sinFecha') };
    if (!sel.aplicable || sel.incompletas > 0) return { usable: false, motivo: t('mowaMes.campana.guardia.noAplica') };
    if (sel.consulta.cantidad === null) return { usable: false, motivo: t('mowaMes.campana.guardia.sinCantidad') };
    return { usable: true };
  }

  function programacionElegida(): ProgramacionBorrador {
    const modo = ($<HTMLInputElement>('input[name="programacion"]:checked')?.value ?? 'hora_determinada') as ProgramacionCampana;
    const fechas =
      modo === 'enviar_ahora'
        ? []
        : modo === 'hora_determinada'
          ? [$<HTMLInputElement>('#mm-fecha-unica').value]
          : [...estado.fechasMultiples];
    return { modo, fechas };
  }

  /** `''` when the field still holds the configured template: that is "use the configured one". */
  function plantillaElegida(): string {
    const escrita = $<HTMLInputElement>('#mm-plantilla').value;
    return escrita.trim() === (estado.configuracion?.plantilla_nombre_archivo ?? '').trim() ? '' : escrita;
  }

  /** The unknown-variable note for what is typed; the API's 400 stays the final word. */
  function pintarPlantilla(): boolean {
    const nota = notaVariablesDesconocidas($<HTMLInputElement>('#mm-plantilla').value, estado.configuracion?.variables_plantilla ?? []);
    $<HTMLElement>('[data-plantilla-error]').textContent = nota;
    $<HTMLInputElement>('#mm-plantilla').setAttribute('aria-invalid', String(nota !== ''));
    return nota === '';
  }

  function leerBorrador(): CampanaBorrador | null {
    const sel = estado.seleccion;
    const usable = seleccionUsable();
    if (!usable.usable || !sel) return null;

    const speechValor = $<HTMLSelectElement>('#mm-speech').value;
    const modoSupervisores = $<HTMLInputElement>('input[name="supervisores_modo"]:checked')?.value ?? 'defecto';

    return {
      seleccion: {
        fechaCorte: sel.fechaCorte!,
        filtros: sel.consulta.filtros,
        orden: sel.consulta.orden,
        cantidad: sel.consulta.cantidad!,
        seleccionId: sel.guardada?.id ?? null,
      },
      descripcion: $<HTMLInputElement>('#mm-descripcion').value,
      plantillaNombreArchivo: plantillaElegida(),
      herramientas: {
        keyword: $<HTMLInputElement>('[data-herramienta-keyword]').checked,
        blacklistIndecopi: $<HTMLInputElement>('[data-herramienta-blacklist]').checked,
      },
      programacion: programacionElegida(),
      speechId: speechValor === '' ? null : Number(speechValor),
      whatsapp: $<HTMLInputElement>('#mm-whatsapp').value,
      supervisores: modoSupervisores === 'propios' ? estado.supervisoresPropios.map((s) => ({ ...s })) : null,
    };
  }

  // ---- Guard banner and form visibility ------------------------------------------

  function pintarGuardia(): void {
    const guardia = $<HTMLElement>('[data-guardia]');
    const formulario = $<HTMLElement>('[data-formulario]');
    const panelPrevisualizacion = $<HTMLElement>('[data-panel-previsualizacion]');
    const usable = seleccionUsable();

    guardia.hidden = usable.usable;
    guardia.textContent = usable.usable ? '' : usable.motivo;
    formulario.hidden = !usable.usable;
    if (!usable.usable) panelPrevisualizacion.hidden = true;
  }

  // ---- Speech and supervisors setup ----------------------------------------------

  function pintarSpeech(): void {
    const select = $<HTMLSelectElement>('#mm-speech');
    const valorPrevio = select.value;
    select.replaceChildren();
    // Only the enabled versions are offered; the Speech original too only while it is enabled.
    const opciones = opcionesDeCampana(estado.versionesSpeech);
    estado.sinSpeech = opciones.length === 0;
    if (estado.sinSpeech) {
      select.append(new Option(t('mowaMes.campana.speech.ninguna'), ''));
    } else {
      opciones.forEach(({ valor, version }) => {
        select.append(new Option(version.original ? t('mowaMes.campana.speech.original') : version.nombre, valor));
      });
    }
    select.disabled = estado.sinSpeech;
    // The one that was chosen while it is still offered; else the first enabled one.
    select.value = preseleccionDeCampana(opciones, valorPrevio);
    $<HTMLElement>('[data-speech-ninguna]').hidden = !estado.sinSpeech;
    pintarEstadoCrear();
  }

  function pintarSupervisoresPropios(foco?: number): void {
    const host = $<HTMLElement>('[data-supervisores-lista]');
    host.replaceChildren();
    const procedencias = estado.supervisionConfigurada?.procedencias ?? [];

    if (estado.supervisoresPropios.length === 0) {
      host.append(vacio(t('supervisores.ninguno')));
      return;
    }

    const { envoltorio, cuerpo } = tabla('supervisores__tabla', [
      [t('supervisores.col.orden'), true],
      [t('supervisores.col.numero'), false],
      [t('supervisores.col.procedencia'), false],
      [t('supervisores.col.acciones'), false],
    ], { apilable: true });

    estado.supervisoresPropios.forEach((supervisor, indice) => {
      const total = estado.supervisoresPropios.length;
      const fila = document.createElement('tr');

      const numero = document.createElement('input');
      numero.className = 'input supervisores__numero';
      numero.type = 'text';
      numero.inputMode = 'numeric';
      numero.autocomplete = 'off';
      numero.maxLength = 20;
      numero.value = supervisor.numero;
      numero.setAttribute('aria-label', t('supervisores.numero', { n: indice + 1 }));
      numero.addEventListener('input', () => {
        estado.supervisoresPropios[indice] = { ...supervisor, numero: numero.value };
        programarPrevisualizacion();
      });

      const select = document.createElement('select');
      select.className = 'input';
      select.setAttribute('aria-label', t('supervisores.procedenciaDe', { n: indice + 1 }));
      const opciones = [...procedencias];
      if (!opciones.includes(supervisor.procedencia)) opciones.unshift(supervisor.procedencia);
      opciones.forEach((nombre) => {
        const opcion = document.createElement('option');
        opcion.value = nombre;
        opcion.textContent = nombre.trim() === '' ? t('supervisores.sinNombre') : nombre;
        select.append(opcion);
      });
      select.value = supervisor.procedencia;
      select.addEventListener('change', () => {
        estado.supervisoresPropios[indice] = { ...supervisor, procedencia: select.value };
        programarPrevisualizacion();
      });

      const subir = botonIcono(t('supervisores.subir', { n: indice + 1 }), 'arriba');
      subir.disabled = indice === 0;
      subir.addEventListener('click', () => {
        estado.supervisoresPropios = moverElemento(estado.supervisoresPropios, indice, -1);
        pintarSupervisoresPropios();
        programarPrevisualizacion();
      });

      const bajar = botonIcono(t('supervisores.bajar', { n: indice + 1 }), 'abajo');
      bajar.disabled = indice === total - 1;
      bajar.addEventListener('click', () => {
        estado.supervisoresPropios = moverElemento(estado.supervisoresPropios, indice, 1);
        pintarSupervisoresPropios();
        programarPrevisualizacion();
      });

      const quitar = botonQuitar(t('supervisores.quitar', { n: indice + 1 }));
      quitar.addEventListener('click', () => {
        estado.supervisoresPropios = estado.supervisoresPropios.filter((_, i) => i !== indice);
        pintarSupervisoresPropios();
        programarPrevisualizacion();
      });

      const acciones = document.createElement('td');
      const envoltorioAcciones = document.createElement('span');
      envoltorioAcciones.className = 'supervisores-fila__acciones';
      envoltorioAcciones.append(subir, bajar, quitar);
      acciones.append(envoltorioAcciones);

      const celdaNumero = document.createElement('td');
      celdaNumero.append(numero);
      const celdaProcedencia = document.createElement('td');
      celdaProcedencia.append(select);

      fila.append(celda('td', String(indice + 1), 'num'), celdaNumero, celdaProcedencia, acciones);
      cuerpo.append(fila);
    });

    host.append(envoltorio);
    if (foco !== undefined) {
      host.querySelectorAll<HTMLInputElement>('.supervisores__numero')[foco]?.focus();
    }
  }

  document.querySelectorAll<HTMLInputElement>('[data-supervisores-modo]').forEach((radio) => {
    radio.addEventListener('change', () => {
      const propios = $<HTMLElement>('[data-supervisores-propios]');
      propios.hidden = radio.value !== 'propios' || !radio.checked;
      if (radio.value === 'propios' && radio.checked && estado.supervisoresPropios.length === 0) {
        estado.supervisoresPropios = (estado.supervisionConfigurada?.supervisores ?? []).map((s) => ({
          numero: s.numero,
          procedencia: s.procedencia,
        }));
        pintarSupervisoresPropios();
      }
      programarPrevisualizacion();
    });
  });

  $<HTMLButtonElement>('[data-agregar-supervisor]').addEventListener('click', () => {
    const procedencia = estado.supervisionConfigurada?.procedencias[0] ?? '';
    estado.supervisoresPropios = [...estado.supervisoresPropios, { numero: '', procedencia }];
    pintarSupervisoresPropios(estado.supervisoresPropios.length - 1);
    programarPrevisualizacion();
  });

  // ---- Scheduling -----------------------------------------------------------------

  function pintarProgramacion(): void {
    const modo = $<HTMLInputElement>('input[name="programacion"]:checked')?.value ?? 'hora_determinada';
    $<HTMLElement>('[data-programacion-unica]').hidden = modo !== 'hora_determinada';
    $<HTMLElement>('[data-programacion-multiples]').hidden = modo !== 'diferentes_horas';
  }

  function pintarFechasMultiples(foco?: number): void {
    const lista = $<HTMLOListElement>('[data-fechas-multiples]');
    lista.replaceChildren();
    estado.fechasMultiples.forEach((valor, indice) => {
      const item = document.createElement('li');
      item.className = 'supervisores-fila';

      const input = document.createElement('input');
      input.className = 'input mono supervisores-fila__texto';
      input.type = 'datetime-local';
      input.value = valor;
      input.setAttribute('aria-label', t('mowaMes.campana.programacion.fechaN', { n: indice + 1 }));
      input.addEventListener('input', () => {
        estado.fechasMultiples[indice] = input.value;
        programarPrevisualizacion();
      });

      const quitar = botonQuitar(t('mowaMes.campana.programacion.quitarFecha', { n: indice + 1 }));
      quitar.disabled = estado.fechasMultiples.length <= 1;
      quitar.addEventListener('click', () => {
        estado.fechasMultiples = estado.fechasMultiples.filter((_, i) => i !== indice);
        pintarFechasMultiples();
        programarPrevisualizacion();
      });

      const acciones = document.createElement('span');
      acciones.className = 'supervisores-fila__acciones';
      acciones.append(quitar);

      item.append(input, acciones);
      lista.append(item);
    });
    if (foco !== undefined) {
      lista.querySelectorAll<HTMLInputElement>('input[type="datetime-local"]')[foco]?.focus();
    }
  }

  document.querySelectorAll<HTMLInputElement>('[data-programacion-radio]').forEach((radio) => {
    radio.addEventListener('change', () => {
      pintarProgramacion();
      programarPrevisualizacion();
    });
  });

  $<HTMLButtonElement>('[data-agregar-fecha]').addEventListener('click', () => {
    estado.fechasMultiples = [...estado.fechasMultiples, ''];
    pintarFechasMultiples(estado.fechasMultiples.length - 1);
    programarPrevisualizacion();
  });

  // ---- Preview ----------------------------------------------------------------------

  let temporizadorPrevisualizacion = 0;
  let controlPrevisualizacion: AbortController | null = null;

  function programarPrevisualizacion(espera = ESPERA_PREVISUALIZACION): void {
    window.clearTimeout(temporizadorPrevisualizacion);
    temporizadorPrevisualizacion = window.setTimeout(() => void previsualizar(), espera);
  }

  function pintarProblemasCliente(problemas: ReturnType<typeof problemasCampana>): void {
    const nodo = $<HTMLElement>('[data-problemas-cliente]');
    nodo.textContent = problemas.map(textoDeProblemaCampana).join(' ');
  }

  function pintarCifras(previa: PrevisualizacionCampana): void {
    const host = $<HTMLElement>('[data-cifras]');
    host.replaceChildren(
      cifra(t('mowaMes.campana.cifras.disponibles'), formatNumber(previa.disponibles)),
      cifra(t('mowaMes.campana.cifras.solicitados'), formatNumber(previa.solicitados)),
      cifra(t('mowaMes.campana.cifras.evaluados'), formatNumber(previa.evaluados)),
      cifra(t('mowaMes.seguimiento.detalle.productos'), formatNumber(previa.productos_cargados)),
      cifra(t('mowaMes.seguimiento.detalle.supervision'), formatNumber(previa.supervision_cargados), undefined, false, icono('supervision')),
      cifra(t('mowaMes.seguimiento.detalle.total'), formatNumber(previa.total_cargados), undefined, false, icono('cargados')),
      cifra(t('mowaMes.seguimiento.detalle.excluidos'), formatNumber(previa.excluidos), undefined, false, icono('excluidos')),
      // The API sends the amount already worked out, as text: only formatted here.
      cifra(
        t('mowaMes.campana.costo.estimado'),
        formatSoles(previa.costo_estimado),
        t('mowaMes.campana.costo.hint', { n: formatNumber(previa.total_cargados), tarifa: formatTarifa(previa.tarifa_sms) }),
        false,
        icono('costo'),
      ),
    );

    // The first file's name is the API's, never worked out here; `[campana]` marks the id it does not have yet.
    $<HTMLElement>('[data-nombre-archivo]').hidden = previa.nombre_primer_archivo === null;
    $<HTMLElement>('[data-nombre-primer-archivo]').textContent = previa.nombre_primer_archivo ?? '';
    $<HTMLElement>('[data-nombre-estimado]').hidden = previa.nombre_primer_archivo === null || !previa.nombre_estimado;

    const limiteHost = $<HTMLElement>('[data-limite-cifras]');
    limiteHost.replaceChildren(
      cifra(t('mowaMes.seguimiento.limite.cargados'), formatNumber(previa.limite.cargados_mes)),
      cifra(t('mowaMes.seguimiento.limite.limite'), formatNumber(previa.limite.limite)),
      cifra(t('mowaMes.seguimiento.limite.disponible'), formatNumber(previa.limite.disponible)),
    );
    $<HTMLElement>('[data-limite-esta-campana]').textContent = t('mowaMes.campana.limite.estaCampana', {
      n: formatNumber(previa.limite.esta_campana),
    });
    const excedido = $<HTMLElement>('[data-limite-excedido]');
    excedido.hidden = !previa.limite.excedido;
    excedido.textContent = mensajeLimiteExcedido(previa.limite);
  }

  /**
   * Repaint without stealing focus: it only moves when it was inside a pager
   * that just disabled the button it was on or disappeared (last page reached,
   * or a fresh preview with a single page). It then goes to the other button,
   * or to the table's heading when there is no pager left.
   */
  function conFocoDePaginador(pintar: () => void): void {
    const activo = document.activeElement;
    const paginador = [...document.querySelectorAll<HTMLElement>('[data-exclusiones-pager], [data-muestra-pager]')].find(
      (nodo) => activo !== null && nodo.contains(activo),
    );
    pintar();
    if (!paginador) return;
    const ahora = document.activeElement;
    const perdido =
      ahora === null ||
      ahora === document.body ||
      (ahora instanceof HTMLButtonElement && ahora.disabled) ||
      paginador.hidden;
    if (!perdido) return;
    const habilitado = paginador.hidden
      ? null
      : [...paginador.querySelectorAll<HTMLButtonElement>('button')].find((boton) => !boton.disabled);
    const titulo = paginador.matches('[data-exclusiones-pager]')
      ? $<HTMLElement>('[data-exclusiones-titulo]')
      : $<HTMLElement>('[data-muestra-titulo]');
    (habilitado ?? titulo).focus();
  }

  function pintarExclusiones(previa: PrevisualizacionCampana): void {
    const host = $<HTMLElement>('[data-exclusiones]');
    const paginador = $<HTMLElement>('[data-exclusiones-pager]');
    const aviso = $<HTMLElement>('[data-exclusiones-truncadas]');
    const filas = previa.exclusiones.exclusiones;
    const total = previa.exclusiones.total;

    // The heading always carries the real total; the list may hold only the
    // first 100 of them.
    $<HTMLElement>('[data-exclusiones-total]').textContent = t('mowaMes.campana.exclusiones.total', {
      total: formatNumber(total),
    });
    aviso.hidden = total <= filas.length;
    aviso.textContent = aviso.hidden
      ? ''
      : t('mowaMes.campana.exclusiones.truncadas', {
          mostradas: formatNumber(filas.length),
          total: formatNumber(total),
        });

    host.replaceChildren();
    if (total === 0) {
      host.append(vacio(t('mowaMes.campana.exclusiones.vacio')));
      paginador.hidden = true;
      return;
    }
    const pagina = paginar(filas, estado.paginaExclusiones);
    estado.paginaExclusiones = pagina.pagina;
    const { envoltorio, cuerpo } = tabla('mm-exclusiones__tabla', [
      [t('mowaMes.seguimiento.exclusiones.col.pagare'), false],
      [t('mowaMes.seguimiento.exclusiones.col.motivo'), false],
    ], { apilable: true });
    pagina.filas.forEach((exclusion) => {
      const fila = document.createElement('tr');
      const motivo = document.createElement('td');
      const tag = document.createElement('span');
      tag.className = 'tag tag--error';
      // Same short label as the follow-up screen's exclusions table; the tag
      // is a pill and carries data, not a sentence.
      tag.textContent = t(`mowaMes.seguimiento.exclusiones.motivo.${exclusion.codigo}`);
      motivo.append(tag);
      // This table has no Detail column: the additional fields that were missing go in the same cell, after
      // the tag, as plain text, always on their own line under it (`.mm-exclusion__campos`).
      const campos = exclusion.codigo === 'falta_campo_adicional' ? listaDeCampos(exclusion.campos) : null;
      if (campos !== null) {
        const nombres = document.createElement('span');
        nombres.className = 'mm-exclusion__campos';
        nombres.textContent = campos;
        motivo.append(' ', nombres);
      }
      motivo.dataset.etiqueta = t('mowaMes.seguimiento.exclusiones.col.motivo');
      fila.append(celda('td', exclusion.pagare, 'mono', t('mowaMes.seguimiento.exclusiones.col.pagare')), motivo);
      cuerpo.append(fila);
    });
    host.append(envoltorio);
    pintarPaginador(paginador, pagina);
  }

  function pintarMuestra(previa: PrevisualizacionCampana): void {
    const host = $<HTMLElement>('[data-muestra]');
    const paginador = $<HTMLElement>('[data-muestra-pager]');
    host.replaceChildren();
    if (previa.muestra.length === 0) {
      host.append(vacio(t('mowaMes.campana.muestra.vacio')));
      paginador.hidden = true;
      return;
    }
    const pagina = paginar(previa.muestra, estado.paginaMuestra);
    estado.paginaMuestra = pagina.pagina;
    const { envoltorio, cuerpo } = tabla('mm-muestra__tabla', [
      [t('mowaMes.campana.muestra.col.numero'), false],
      [t('mowaMes.campana.muestra.col.dni'), false],
      [t('mowaMes.campana.muestra.col.segmento'), false],
      [t('mowaMes.campana.muestra.col.largo'), true],
      [t('mowaMes.campana.muestra.col.mensaje'), false],
      [t('mowaMes.campana.muestra.col.advertencias'), false],
    ], { apilable: true });
    pagina.filas.forEach((fila) => {
      const tr = document.createElement('tr');
      const numero = celda('td', fila.numero, 'mono', t('mowaMes.campana.muestra.col.numero'));
      if (fila.supervision) {
        const tag = document.createElement('span');
        tag.className = 'tag tag--neutral';
        tag.textContent = t('mowaMes.campana.muestra.supervision');
        numero.append(document.createElement('br'), tag);
      }
      // Same convention as the ingestion issues table: the code is data, shown
      // in mono with its full sentence as a hover title, not squeezed into a
      // pill (there is no short-label catalogue for warning codes).
      const advertencias = document.createElement('td');
      advertencias.className = 'mono';
      advertencias.dataset.etiqueta = t('mowaMes.campana.muestra.col.advertencias');
      fila.advertencias.forEach((codigo, indice) => {
        const nodo = document.createElement('span');
        nodo.title = traducirCodigo(codigo, codigo);
        appendBreakable(nodo, codigo);
        if (indice > 0) advertencias.append(document.createElement('br'));
        advertencias.append(nodo);
      });
      tr.append(
        numero,
        celda('td', fila.dni, 'mono', t('mowaMes.campana.muestra.col.dni')),
        celda('td', fila.segmento ?? '—', '', t('mowaMes.campana.muestra.col.segmento')),
        celda('td', formatNumber(fila.largo), 'num', t('mowaMes.campana.muestra.col.largo')),
        celda('td', fila.mensaje, '', t('mowaMes.campana.muestra.col.mensaje')),
        advertencias,
      );
      cuerpo.append(tr);
    });
    host.append(envoltorio);
    pintarPaginador(paginador, pagina);
  }

  function pintarArchivosPrevistos(previa: PrevisualizacionCampana): void {
    const lista = $<HTMLElement>('[data-archivos-previstos]');
    lista.replaceChildren();
    previa.archivos_previstos_por_filas.forEach((archivo, indice) => {
      const item = document.createElement('li');
      item.textContent = etiquetaArchivoPrevisto(archivo, indice, previa.archivos_previstos_por_filas.length);
      lista.append(item);
    });
  }

  function pintarEstadoCrear(): void {
    const boton = $<HTMLButtonElement>('[data-crear]');
    boton.disabled =
      !estado.previsualizacion ||
      !estado.previsualizacion.puede_crear ||
      estado.huellaInvalida ||
      estado.sinSpeech ||
      boton.dataset.loading === 'true';
  }

  /** The notice of the archived fields the speech reads; hidden with none, and with no preview to say it about. */
  function pintarArchivados(previa: PrevisualizacionCampana | null): void {
    const aviso = previa ? avisoDeCamposArchivados(previa.campos_archivados, 'campana') : null;
    $<HTMLElement>('[data-campos-archivados]').hidden = aviso === null;
    $<HTMLElement>('[data-campos-archivados-texto]').textContent = aviso ?? '';
  }

  function pintarResultado(): void {
    const previa = estado.previsualizacion;
    const panel = $<HTMLElement>('[data-panel-previsualizacion]');
    const error404 = $<HTMLElement>('[data-error-404]');
    const resultado = $<HTMLElement>('[data-resultado]');

    panel.hidden = seleccionUsable().usable === false;
    error404.hidden = !estado.error404;
    $<HTMLElement>('[data-error-404-detalle]').textContent = estado.error404 ?? '';
    resultado.hidden = !previa;

    if (!previa) {
      const resumen = $<HTMLElement>('[data-resumen]');
      if (resumen.textContent !== '') resumen.textContent = '';
      pintarArchivados(null);
      pintarEstadoCrear();
      return;
    }

    const textoResumen = resumenProblemasCampana(previa);
    const resumen = $<HTMLElement>('[data-resumen]');
    if (resumen.textContent !== textoResumen) resumen.textContent = textoResumen;
    pintarArchivados(previa);

    pintarCifras(previa);
    pintarExclusiones(previa);
    pintarMuestra(previa);
    pintarArchivosPrevistos(previa);
    pintarEstadoCrear();

    if (!estado.descripcionEditada) {
      $<HTMLInputElement>('#mm-descripcion').value = previa.descripcion_sugerida;
    }
    // Setting `value` fires no `input`: the counter and «Copiar» follow the suggestion by hand.
    pintarDescripcion();
  }

  async function previsualizar(): Promise<void> {
    pintarGuardia();
    const borrador = leerBorrador();
    if (!borrador) {
      estado.previsualizacion = null;
      estado.error404 = null;
      pintarResultado();
      return;
    }

    const problemas = problemasCampana(borrador);
    pintarProblemasCliente(problemas);
    if (!pintarPlantilla() || problemas.length > 0) {
      estado.previsualizacion = null;
      estado.error404 = null;
      pintarResultado();
      return;
    }

    controlPrevisualizacion?.abort();
    const control = new AbortController();
    controlPrevisualizacion = control;
    $<HTMLElement>('[data-panel-previsualizacion]').hidden = false;
    $<HTMLElement>('[data-previsualizacion-calculando]').hidden = false;

    try {
      const previa = await previsualizarCampana(entradaCampana(borrador), control.signal);
      if (control.signal.aborted) return;
      estado.previsualizacion = previa;
      estado.paginaExclusiones = 1;
      estado.paginaMuestra = 1;
      estado.error404 = null;
      estado.huellaInvalida = false;
      conFocoDePaginador(pintarResultado);
    } catch (caido) {
      if (caido instanceof DOMException && caido.name === 'AbortError') return;
      estado.previsualizacion = null;
      if (caido instanceof ApiError && caido.status === 404) {
        estado.error404 = caido.detail || t('common.errorBody');
      } else if (caido instanceof ApiError && caido.status === 400 && campoDeError(caido.cuerpo) === 'plantilla_nombre_archivo') {
        // The 400 names the template (an unclosed brace, or a variable the local list missed).
        // Any other 400 has no field and goes to the general notice below.
        estado.error404 = null;
        $<HTMLElement>('[data-plantilla-error]').textContent = caido.detail || t('common.errorBody');
        $<HTMLInputElement>('#mm-plantilla').setAttribute('aria-invalid', 'true');
      } else {
        estado.error404 = null;
        mostrarError(mensajeDeError(caido));
      }
      pintarResultado();
    } finally {
      if (controlPrevisualizacion === control) $<HTMLElement>('[data-previsualizacion-calculando]').hidden = true;
    }
  }

  function moverPagina(campo: 'paginaExclusiones' | 'paginaMuestra', delta: -1 | 1): void {
    const previa = estado.previsualizacion;
    if (!previa) return;
    estado[campo] += delta;
    conFocoDePaginador(() => (campo === 'paginaExclusiones' ? pintarExclusiones(previa) : pintarMuestra(previa)));
  }

  for (const [selector, campo] of [
    ['[data-exclusiones-pager]', 'paginaExclusiones'],
    ['[data-muestra-pager]', 'paginaMuestra'],
  ] as const) {
    const paginador = $<HTMLElement>(selector);
    paginador.querySelector('[data-page-prev]')!.addEventListener('click', () => moverPagina(campo, -1));
    paginador.querySelector('[data-page-next]')!.addEventListener('click', () => moverPagina(campo, 1));
  }

  // ---- Creation -----------------------------------------------------------------

  async function crear(confirmarLimite: boolean): Promise<void> {
    const borrador = leerBorrador();
    if (!borrador || !estado.previsualizacion) return;
    const boton = $<HTMLButtonElement>('[data-crear]');
    const error = $<HTMLElement>('[data-crear-error]');
    error.textContent = '';
    ocupado(boton, true);
    try {
      const campana = await crearCampana(entradaCreacion(borrador, estado.previsualizacion.speech.huella, confirmarLimite));
      estado.campanaCreada = campana;
      pintarCreada();
    } catch (caido) {
      if (caido instanceof ApiError && caido.status === 409) {
        // The 409's own `codigo` says which it is; a code this client does not
        // know is treated as the huella (the safer default: it blocks Crear
        // and asks for a fresh preview, rather than silently offering to
        // confirm a limit that may not be the real cause).
        if (caido.codigo === 'limite_excedido') {
          $<HTMLElement>('[data-limite-dialogo-detalle]').textContent = traducirPorPrefijo(
            'mowaMes.errorCampana',
            'limite_excedido',
            caido.detail || t('common.errorBody'),
          );
          void openWhenFree(dialogos.limite).then(() =>
            $<HTMLButtonElement>('[data-limite-cancelar]').focus(),
          );
        } else {
          estado.huellaInvalida = true;
          pintarEstadoCrear();
          error.textContent = t('mowaMes.errorCampana.huella_cambiada');
        }
      } else if (caido instanceof ApiError && caido.status === 400) {
        if (campoDeError(caido.cuerpo) === 'plantilla_nombre_archivo') {
          $<HTMLElement>('[data-plantilla-error]').textContent = caido.detail || t('common.errorBody');
          $<HTMLInputElement>('#mm-plantilla').setAttribute('aria-invalid', 'true');
          $<HTMLInputElement>('#mm-plantilla').focus();
        } else {
          error.textContent = caido.detail || t('common.errorBody');
        }
      } else {
        mostrarError(mensajeDeError(caido));
      }
    } finally {
      // `ocupado` always clears `disabled` to end the loading state; restore
      // whatever it should actually be (P4 needs it to stay disabled).
      ocupado(boton, false);
      pintarEstadoCrear();
    }
  }

  $<HTMLButtonElement>('[data-crear]').addEventListener('click', () => void crear(false));
  $<HTMLButtonElement>('[data-limite-confirmar]').addEventListener('click', () => {
    dialogos.limite.close();
    void crear(true);
  });

  // ---- Created campaign -----------------------------------------------------------

  /** An icon taken from the page's templates (rendered once by Astro, cloned per use). */
  function icono(nombre: 'copiar' | 'copiado' | 'descargar' | 'cargados' | 'supervision' | 'excluidos' | 'costo'): Node {
    return $<HTMLTemplateElement>(`template[data-icono-${nombre}]`).content.cloneNode(true);
  }

  function pintarCreada(): void {
    const campana = estado.campanaCreada;
    $<HTMLElement>('[data-formulario]').hidden = true;
    $<HTMLElement>('[data-panel-previsualizacion]').hidden = true;
    $<HTMLElement>('[data-guardia]').hidden = true;
    $<HTMLElement>('[data-selector]').hidden = true;
    const panel = $<HTMLElement>('[data-panel-creada]');
    panel.hidden = !campana;
    if (!campana) return;

    $<HTMLElement>('[data-creada-aviso-texto]').textContent = t('mowaMes.campana.subir.creada', { id: campana.id });
    $<HTMLAnchorElement>('[data-creada-seguimiento]').href = `/mowa-mes/seguimiento?campana=${campana.id}`;
    pintarArchivosCreados(campana);
    pintarDatosParaMes(campana);
  }

  /** Step 1: one download per file, in the order of `{archivo}`, with its real name. */
  function pintarArchivosCreados(campana: Campana): void {
    const lista = $<HTMLElement>('[data-creada-archivos]');
    lista.replaceChildren();
    [...campana.archivos]
      .sort((a, b) => a.numero - b.numero)
      .forEach((archivo) => {
        const item = document.createElement('li');
        item.className = 'mm-subir__archivo';
        const nombre = document.createElement('span');
        nombre.className = 'mono mm-subir__nombre';
        nombre.textContent = nombreArchivo(archivo.nombre, campana.id, archivo.numero);
        const detalle = document.createElement('span');
        detalle.className = 'muted mm-subir__detalle';
        detalle.textContent = t('mowaMes.campana.subir.archivoDetalle', {
          filas: formatNumber(archivo.filas),
          supervision: formatNumber(archivo.supervision),
          tamano: formatBytes(archivo.bytes),
        });
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.className = 'btn btn--sm';
        const spinner = document.createElement('span');
        spinner.className = 'btn__spinner';
        spinner.setAttribute('aria-hidden', 'true');
        const etiqueta = document.createElement('span');
        etiqueta.className = 'btn__label';
        etiqueta.textContent = t('mowaMes.seguimiento.archivos.descargar');
        boton.append(spinner, icono('descargar'), etiqueta);
        boton.setAttribute('aria-label', t('mowaMes.seguimiento.archivos.descargarAria', { n: archivo.numero }));
        boton.addEventListener('click', () => void descargar(campana, archivo, boton));
        item.append(nombre, detalle, boton);
        lista.append(item);
      });
  }

  /** Select a text so Ctrl+C is one key away when the copy was refused. */
  function seleccionar(nodo: HTMLElement): void {
    const seleccion = window.getSelection();
    if (!seleccion) return;
    seleccion.selectAllChildren(nodo);
  }

  let temporizadorCopia: number | undefined;
  /** Says it in the status region; emptied first so a second copy of the same words is read again. */
  function anunciarCopia(texto: string): void {
    const nodo = $<HTMLElement>('[data-creada-copia-estado]');
    window.clearTimeout(temporizadorCopia);
    nodo.textContent = '';
    temporizadorCopia = window.setTimeout(() => {
      nodo.textContent = texto;
    }, 100);
  }

  /** Step 2: each field of MES's form with its value and a button that copies exactly what is read. */
  function pintarDatosParaMes(campana: Campana): void {
    const lista = $<HTMLElement>('[data-creada-datos]');
    lista.replaceChildren();
    datosParaMes(campana).forEach((dato) => {
      const fila = document.createElement('div');
      fila.className = 'mm-subir__dato';
      const nombre = document.createElement('dt');
      nombre.textContent = dato.etiqueta;
      const valor = document.createElement('dd');
      const texto = document.createElement('span');
      texto.className = 'mono mm-subir__valor';
      texto.textContent = dato.valor;
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.className = 'btn btn--sm btn--icon';
      boton.setAttribute('aria-label', t('mowaMes.accion.copiar', { dato: dato.etiqueta }));
      boton.title = t('mowaMes.accion.copiar', { dato: dato.etiqueta });
      boton.append(icono('copiar'));
      let devolver: number | undefined;
      boton.addEventListener('click', async () => {
        const resultado = await copiarTexto(dato.valor);
        if (resultado === 'fallo') {
          seleccionar(texto);
          anunciarCopia(t('mowaMes.campana.subir.copiarFallo', { dato: dato.etiqueta }));
          return;
        }
        anunciarCopia(t('mowaMes.estado.copiado', { dato: dato.etiqueta }));
        // The icon says «copied» for 2 s, then goes back.
        boton.replaceChildren(icono('copiado'));
        window.clearTimeout(devolver);
        devolver = window.setTimeout(() => boton.replaceChildren(icono('copiar')), 2000);
      });
      valor.append(texto, boton);
      fila.append(nombre, valor);
      lista.append(fila);
    });
  }

  async function descargar(campana: Campana, archivo: ArchivoCampana, boton: HTMLButtonElement): Promise<void> {
    ocupado(boton, true);
    try {
      const descargado = await descargarArchivoCampana(campana.id, archivo.numero);
      guardarArchivo(descargado.blob, nombreArchivo(descargado.nombre, campana.id, archivo.numero));
      const resumen = leerResumenDescarga(descargado.resumen);
      const nodo = $<HTMLElement>('[data-creada-descarga-estado]');
      const texto = t('mowaMes.seguimiento.archivos.descargado', {
        archivo: resumen.archivo ?? archivo.numero,
        total: resumen.total ?? campana.archivos.length,
        filas: formatNumber(resumen.filas ?? archivo.filas),
        supervision: formatNumber(resumen.supervision ?? archivo.supervision),
      });
      nodo.textContent = texto;
      window.setTimeout(() => {
        if (nodo.textContent === texto) nodo.textContent = '';
      }, 4000);
    } catch (caido) {
      mostrarError(mensajeDeError(caido));
    } finally {
      ocupado(boton, false);
    }
  }

  $<HTMLButtonElement>('[data-creada-otra]').addEventListener('click', () => {
    window.location.reload();
  });

  // ---- Form change wiring -----------------------------------------------------------

  document.querySelectorAll<HTMLInputElement>('input[name="tipo_carga"], input[name="salida"]').forEach((radio) => {
    radio.addEventListener('change', () => programarPrevisualizacion());
  });
  $<HTMLInputElement>('[data-herramienta-keyword]').addEventListener('change', () => programarPrevisualizacion());
  $<HTMLInputElement>('[data-herramienta-blacklist]').addEventListener('change', () => programarPrevisualizacion());
  $<HTMLSelectElement>('#mm-speech').addEventListener('change', () => programarPrevisualizacion(0));
  $<HTMLInputElement>('#mm-whatsapp').addEventListener('input', () => programarPrevisualizacion());
  $<HTMLInputElement>('#mm-fecha-unica').addEventListener('input', () => programarPrevisualizacion());
  // ---- The description field (RF-MM-04): counter and «Copiar» -----------------------------

  const campoDescripcion = $<HTMLInputElement>('#mm-descripcion');
  const botonCopiar = $<HTMLButtonElement>('[data-descripcion-copiar]');
  const estadoDescripcion = $<HTMLElement>('[data-descripcion-estado]');
  /** A paste that did not fit has just been announced: the `input` that follows must not clear it. */
  let avisoDePegado = false;
  /** The timer of the pending message; cancelled if the text changes first. */
  let temporizadorDelAviso: number | undefined;
  /** Long enough for a screen reader to take the empty region as a change before the words come back. */
  const ESPERA_DEL_AVISO_MS = 100;

  /**
   * Says something in the status region. The region is emptied first and written a moment later: a
   * second copy repeats the same words, and a screen reader does not read a text that did not change.
   * One animation frame (~16 ms) is too little: some readers, NVDA among them, merge close changes.
   */
  function avisar(texto: string): void {
    window.clearTimeout(temporizadorDelAviso);
    estadoDescripcion.textContent = '';
    temporizadorDelAviso = window.setTimeout(() => {
      estadoDescripcion.textContent = texto;
    }, ESPERA_DEL_AVISO_MS);
  }

  function queCopiar(): string {
    return descripcionARegistrar(campoDescripcion.value, estado.previsualizacion?.descripcion_sugerida ?? '');
  }

  function pintarDescripcion(): void {
    const contador = $<HTMLElement>('[data-descripcion-contador]');
    contador.textContent = contadorDescripcion(campoDescripcion.value);
    // At the limit the number already says it: the tone only backs it up.
    contador.dataset.tope = String(campoDescripcion.value.length >= DESCRIPCION_MAXIMA);
    botonCopiar.setAttribute('aria-disabled', String(queCopiar() === ''));
  }

  /** The classic way: select what will be registered and ask the browser to copy it. */
  function seleccionarYCopiar(texto: string): boolean {
    if (campoDescripcion.value.trim() !== '') {
      // The field's own text, without the spaces at the ends: if the copy fails it stays selected.
      const inicio = campoDescripcion.value.length - campoDescripcion.value.trimStart().length;
      campoDescripcion.focus();
      campoDescripcion.setSelectionRange(inicio, inicio + texto.length);
      return document.execCommand('copy');
    }
    // Nothing written: the suggestion is what is copied, from an off-screen textarea.
    return copiarDesdeTextareaTemporal(texto);
  }

  botonCopiar.addEventListener('click', async () => {
    const texto = queCopiar();
    if (texto === '') return;
    const hayTextoEnElCampo = campoDescripcion.value.trim() !== '';
    const resultado = await copiarConRespaldo(texto, {
      escribir: navigator.clipboard?.writeText ? (t) => navigator.clipboard.writeText(t) : undefined,
      seleccionarYCopiar: () => seleccionarYCopiar(texto),
    });
    avisoDePegado = false;
    if (resultado === 'fallo') {
      avisar(
        t(hayTextoEnElCampo ? 'mowaMes.campana.descripcion.copiarFallo' : 'mowaMes.campana.descripcion.copiarFalloVacio'),
      );
      // With text, it stays selected in the field for Ctrl+C; without it, the focus goes back to the button.
      if (!hayTextoEnElCampo) botonCopiar.focus();
      return;
    }
    avisar(t('mowaMes.campana.descripcion.copiada'));
    botonCopiar.focus();
  });

  /**
   * Puts `pegado` where the selection is, as a paste would, already normalized and cut to what fits by
   * `textoDePegado`. If something was left out, say it once, so the end is not lost unnoticed.
   *
   * It goes in with `execCommand('insertText')`: that leaves an entry in the field's undo history (a paste
   * wrong by one key must be undone with Ctrl+Z) and fires `input` by itself. It needs no `maxlength`
   * care, the text arrives cut.
   * shortcut: if the browser refuses (`false` or an exception) it falls back to `setRangeText` and a
   * synthetic `input`, which leaves no undo entry; upgrade if a browser needs it.
   */
  function insertarEnElCampo(pegado: string): void {
    const inicio = campoDescripcion.selectionStart ?? campoDescripcion.value.length;
    const fin = campoDescripcion.selectionEnd ?? inicio;
    const { texto, cortado } = textoDePegado(campoDescripcion.value, inicio, fin, pegado);
    if (texto !== '') {
      // The `input` that follows must not clear the notice about what was left out.
      avisoDePegado = cortado;
      campoDescripcion.focus();
      campoDescripcion.setSelectionRange(inicio, fin);
      let insertado = false;
      try {
        insertado = document.execCommand('insertText', false, texto);
      } catch {
        // Falls through to `setRangeText`.
      }
      if (!insertado) {
        campoDescripcion.setRangeText(texto, inicio, fin, 'end');
        campoDescripcion.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
    if (cortado) avisar(t('mowaMes.campana.descripcion.pegadoCortado', { max: DESCRIPCION_MAXIMA }));
  }

  // The field of MES is one line. An `<input type="text">` deletes `\r` and `\n` when pasting, which glues
  // the words, and leaves U+2028 and U+2029: so the paste is done by hand, with the breaks as spaces.
  campoDescripcion.addEventListener('paste', (evento) => {
    evento.preventDefault();
    insertarEnElCampo(evento.clipboardData?.getData('text') ?? '');
  });

  campoDescripcion.addEventListener('drop', (evento) => {
    const soltado = evento.dataTransfer?.getData('text') ?? '';
    // shortcut: only a drop that carries a line break is done by hand, and it goes where the selection is,
    // not under the pointer (an input gives no point-to-caret); any other drop is the browser's.
    if (normalizarSaltos(soltado) === soltado) return;
    evento.preventDefault();
    insertarEnElCampo(soltado);
  });

  campoDescripcion.addEventListener('input', () => {
    // U+2028 and U+2029 can still arrive (a keyboard, an IME): they become a space, the cursor stays put.
    const limpio = normalizarSaltos(campoDescripcion.value);
    if (limpio !== campoDescripcion.value) {
      const { selectionStart: desde, selectionEnd: hasta } = campoDescripcion;
      // shortcut: assigning `value` clears the field's undo history in Chrome; it only happens when a U+2028 or
      // U+2029 is typed, which is rare. Upgrade: select the offending range and `execCommand('insertText', false, ' ')`,
      // which keeps the undo history (`setRangeText` does not either), if that gets reported.
      campoDescripcion.value = limpio;
      campoDescripcion.setSelectionRange(desde, hasta);
    }
    estado.descripcionEditada = true;
    // A message about the text that was there (copied, failed) is stale once it changes.
    if (avisoDePegado) avisoDePegado = false;
    else {
      window.clearTimeout(temporizadorDelAviso);
      estadoDescripcion.textContent = '';
    }
    pintarDescripcion();
  });
  $<HTMLInputElement>('#mm-plantilla').addEventListener('input', () => {
    estado.plantillaEditada = true;
    programarPrevisualizacion();
  });

  // ---- Boot ------------------------------------------------------------------------

  function sinConexion(si: boolean): void {
    $<HTMLElement>('[data-offline]').hidden = !si;
    $<HTMLElement>('[data-contenido]').hidden = si;
    document.dispatchEvent(new CustomEvent('healthchanged'));
  }

  const raiz = $<HTMLElement>('[data-selector]');
  let montado = false;

  // Subscribed before mounting, so no `seleccioncambiada` is ever missed.
  raiz.addEventListener(EVENTO_SELECCION, (event) => {
    estado.seleccion = (event as CustomEvent<EstadoSeleccion>).detail;
    pintarEditarEnCartera();
    // Choosing another saved selection takes away the notice of the one that was gone.
    if (estado.seleccion.guardada) $<HTMLElement>('[data-seleccion-borrada]').hidden = true;
    pintarGuardia();
    programarPrevisualizacion(0);
  });

  // ---- «Editar en Cartera» (RF-MM-09, M-F6, docs/mowa-mes-interfaz.md §4.7) ------------------------------------

  /** Where Cartera sends the analyst back to: this page. */
  const VUELTA = '/mowa-mes/campana';
  let controlador: ControladorSelector | null = null;
  let botonEditar: HTMLButtonElement | null = null;

  /** Everything the form holds now, for the draft that waits while the selection is edited in Cartera. */
  function leerBorradorEnPantalla(): BorradorEnPantalla {
    return {
      seleccionId: estado.seleccion?.guardada?.id ?? null,
      fechaCorte: estado.seleccion?.fechaCorte ?? null,
      descripcion: campoDescripcion.value,
      descripcionEditada: estado.descripcionEditada,
      plantilla: $<HTMLInputElement>('#mm-plantilla').value,
      plantillaEditada: estado.plantillaEditada,
      keyword: $<HTMLInputElement>('[data-herramienta-keyword]').checked,
      blacklist: $<HTMLInputElement>('[data-herramienta-blacklist]').checked,
      programacion: ($<HTMLInputElement>('input[name="programacion"]:checked')?.value ?? 'hora_determinada') as ModoDeProgramacion,
      fechaUnica: $<HTMLInputElement>('#mm-fecha-unica').value,
      fechasMultiples: [...estado.fechasMultiples],
      speech: $<HTMLSelectElement>('#mm-speech').value,
      whatsapp: $<HTMLInputElement>('#mm-whatsapp').value,
      supervisoresModo: $<HTMLInputElement>('input[name="supervisores_modo"]:checked')?.value === 'propios' ? 'propios' : 'defecto',
      supervisoresPropios: estado.supervisoresPropios.map((s) => ({ ...s })),
    };
  }

  /** A field set from the draft, then told so, so every handler the page already has runs as if it had been typed. */
  function poner(campo: HTMLInputElement | HTMLSelectElement, valor: string, evento: 'input' | 'change'): void {
    campo.value = valor;
    campo.dispatchEvent(new Event(evento, { bubbles: true }));
  }

  /** The draft taken back, put in the fields. What it names that is no longer there (a speech, a date) is left as it was. */
  function aplicarBorradorEnPantalla(b: BorradorEnPantalla): void {
    // The date of the cut is the selector's own control, set as if it had been chosen.
    const fecha = raiz.querySelector<HTMLSelectElement>('[data-selector-fecha]');
    if (fecha && b.fechaCorte && [...fecha.options].some((o) => o.value === b.fechaCorte)) poner(fecha, b.fechaCorte, 'change');
    // Untouched, the description keeps following the API's suggestion.
    if (b.descripcionEditada) poner(campoDescripcion, b.descripcion, 'input');
    if (b.plantillaEditada) poner($<HTMLInputElement>('#mm-plantilla'), b.plantilla, 'input');
    const keyword = $<HTMLInputElement>('[data-herramienta-keyword]');
    keyword.checked = b.keyword;
    keyword.dispatchEvent(new Event('change', { bubbles: true }));
    const blacklist = $<HTMLInputElement>('[data-herramienta-blacklist]');
    blacklist.checked = b.blacklist;
    blacklist.dispatchEvent(new Event('change', { bubbles: true }));

    const modo = document.querySelector<HTMLInputElement>(`input[name="programacion"][value="${b.programacion}"]`);
    if (modo) {
      modo.checked = true;
      modo.dispatchEvent(new Event('change', { bubbles: true }));
    }
    if (b.fechaUnica) poner($<HTMLInputElement>('#mm-fecha-unica'), b.fechaUnica, 'input');
    estado.fechasMultiples = b.fechasMultiples.length > 0 ? [...b.fechasMultiples] : [''];
    pintarFechasMultiples();

    const speech = $<HTMLSelectElement>('#mm-speech');
    if ([...speech.options].some((o) => o.value === b.speech)) poner(speech, b.speech, 'change');
    poner($<HTMLInputElement>('#mm-whatsapp'), b.whatsapp, 'input');

    estado.supervisoresPropios = b.supervisoresPropios.map((s) => ({ ...s }));
    const supervisores = document.querySelector<HTMLInputElement>(`input[name="supervisores_modo"][value="${b.supervisoresModo}"]`);
    if (supervisores) {
      supervisores.checked = true;
      supervisores.dispatchEvent(new Event('change', { bubbles: true }));
    }
    pintarSupervisoresPropios();
  }

  /** The button is on only with a saved selection to edit; without one it says what to do, in its `title`. */
  function pintarEditarEnCartera(): void {
    if (!botonEditar) return;
    const hay = Boolean(estado.seleccion?.guardada);
    botonEditar.disabled = !hay;
    if (hay) botonEditar.removeAttribute('title');
    else botonEditar.title = t('mowaMes.campana.editarEnCartera.inactivo');
  }

  /** «Editar en Cartera» goes next to the saved-selection list, which the selector draws and knows nothing of this. */
  function montarEditarEnCartera(): void {
    const campo = raiz.querySelector('[data-selector-guardada]')?.closest('.field');
    if (!campo) return;
    const boton = document.createElement('button');
    boton.type = 'button';
    boton.className = 'btn btn--sm mm-editar-cartera';
    const etiqueta = document.createElement('span');
    etiqueta.dataset.i18n = 'mowaMes.accion.editarEnCartera';
    etiqueta.textContent = t('mowaMes.accion.editarEnCartera');
    boton.append($<HTMLTemplateElement>('template[data-icono-editar-cartera]').content.cloneNode(true), etiqueta);
    boton.addEventListener('click', () => {
      const id = estado.seleccion?.guardada?.id;
      if (id === undefined) return;
      // The draft is a courtesy: if it cannot be kept the analyst still goes, and comes back to an empty form.
      guardarBorrador(almacenDeSesion(), leerBorradorEnPantalla());
      window.location.assign(enlaceEditarEnCartera(id, VUELTA));
    });
    campo.append(boton);
    botonEditar = boton;
    pintarEditarEnCartera();
  }

  /**
   * On opening: the draft is taken back (and deleted) and put in the form, and the selection is loaded: the
   * one `?seleccion=` names (saved in Cartera, perhaps as a new one) or, coming back without saving, the one the
   * draft had. If it is gone, none is chosen and the notice says why. Without a draft or a parameter, nothing.
   */
  function restaurarAlVolver(): void {
    if (!controlador) return;
    const borrador = tomarBorrador(almacenDeSesion());
    if (borrador) aplicarBorradorEnPantalla(borrador);
    const id = seleccionDeLaUrl(window.location.search) ?? borrador?.seleccionId ?? null;
    if (id !== null && !controlador.cargarGuardada(id)) $<HTMLElement>('[data-seleccion-borrada]').hidden = false;
    // The parameter did its work: a reload must not load it over what is there now.
    if (new URLSearchParams(window.location.search).has('seleccion')) {
      window.history.replaceState(null, '', window.location.pathname);
    }
  }

  async function arrancar(): Promise<void> {
    try {
      const [supervision, versiones, siguiente, configuracion] = await Promise.all([
        obtenerSupervision(),
        listarSpeech(),
        siguienteDiaGestionable(),
        obtenerConfiguracion(),
      ]);
      estado.supervisionConfigurada = supervision;
      estado.configuracion = configuracion;
      pintarBotonesDeVariables($<HTMLElement>('[data-plantilla-variables]'), $<HTMLInputElement>('#mm-plantilla'), configuracion.variables_plantilla);
      // Preloaded with the configured template, until the analyst edits it for this campaign.
      if (!estado.plantillaEditada) $<HTMLInputElement>('#mm-plantilla').value = configuracion.plantilla_nombre_archivo;
      estado.versionesSpeech = versiones;
      estado.siguienteDia = siguiente.fecha;
      pintarSpeech();
      pintarProgramacion();
      pintarFechasMultiples();
      // The suggested date only; the hour is a plain, editable convenience.
      $<HTMLInputElement>('#mm-fecha-unica').value = `${siguiente.fecha}T09:00`;

      if (!montado) {
        controlador = await montarSelector(raiz);
        montado = true;
        montarEditarEnCartera();
        restaurarAlVolver();
      }
      sinConexion(false);
    } catch (caido) {
      if (caido instanceof NetworkError) {
        sinConexion(true);
      } else {
        sinConexion(false);
        mostrarError(mensajeDeError(caido));
      }
    }
  }

  const reintentar = $<HTMLButtonElement>('[data-reintentar]');
  reintentar.addEventListener('click', async () => {
    ocupado(reintentar, true);
    try {
      await arrancar();
    } finally {
      ocupado(reintentar, false);
    }
  });

  document.addEventListener('languagechange', () => {
    applyTranslations();
    pintarPlantilla();
    pintarSpeech();
    pintarSupervisoresPropios();
    pintarFechasMultiples();
    pintarEditarEnCartera();
    pintarGuardia();
    pintarResultado();
    if (estado.campanaCreada) pintarCreada();
  });

  void arrancar();
</script>
