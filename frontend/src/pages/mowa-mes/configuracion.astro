---
/**
 * MOWA MES configuration (T-MM-F4): what every campaign starts from. The
 * connector's monthly limit, WhatsApp contact, rate and file-name template, and
 * the speech versions with their worst-case length. The default supervisors
 * and the working-day calendar are shared by every connector: `/supervisores`
 * and `/calendario`.
 *
 * Every panel saves on its own: they are independent settings, and a failed
 * save in one must not throw away edits in another. Like the other operating
 * screens this surface scrolls and keeps the shared tokens.
 */
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import VariantesSegmento from '../../components/VariantesSegmento.astro';
import '../../styles/mowa-mes.css';
import '../../styles/mowa-mes-speech-v2.css';
---

<Shell
  title="Configuración de MOWA MES — auto_cusco"
  description="Límite mensual, WhatsApp de contacto, tarifa, plantilla del nombre de los archivos y versiones de speech del conector SMS de MOWA MES."
>
  <div class="page">
    <header class="page__head">
      <p class="eyebrow" data-i18n="mowaMes.eyebrow">Canales · MOWA MES</p>
      <h1 class="page__title" data-i18n="mowaMes.config.title">Configuración de MOWA MES</h1>
      <p class="page__intro" data-i18n="mowaMes.config.intro">
        Lo que toda campaña toma por defecto. Cada bloque se guarda por separado.
      </p>
    </header>

    <section class="standIn" data-offline hidden aria-labelledby="mm-offline-title">
      <h2 class="standIn__title" id="mm-offline-title" data-i18n="console.offline.title">Sin conexión con la API</h2>
      <p class="standIn__body" data-i18n="console.offline.body">
        No se pudo contactar con el backend. Comprueba que esté en marcha y vuelve a intentarlo.
      </p>
      <button type="button" class="btn btn--primary" data-reintentar>
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__label" data-i18n="console.offline.retry">Reintentar</span>
      </button>
    </section>

    <div class="mm__contenido" data-contenido hidden>
      <!-- Transition: the supervisors and the calendar moved out of this screen (T-MM-C10, E1-A). -->
      <p class="notice notice--info" data-pantallas-nuevas>
        <Icon name="info" size={20} />
        <span>
          <span data-i18n="mowaMes.config.pantallasNuevas">Los supervisores y el calendario laboral ahora tienen su propia pantalla, en Configuración:</span>
          {' '}<a href="/supervisores" data-i18n="nav.supervisores">Supervisores</a> · <a href="/calendario" data-i18n="nav.calendario">Calendario laboral</a>.
        </span>
      </p>

      <!-- ---- Platform: monthly limit and WhatsApp contact ------------------ -->
      <section class="panel" aria-labelledby="mm-plataforma-title">
        <div class="panel__head">
          <h2 class="panel__title" id="mm-plataforma-title" data-i18n="mowaMes.plataforma.title">Plataforma</h2>
          <p class="mono muted mm__meta" data-plataforma-meta></p>
        </div>
        <form class="panel__body mm-plataforma" data-form-plataforma novalidate>
          <div class="field">
            <label class="field__label" for="mm-limite" data-i18n="mowaMes.plataforma.limite">Límite mensual de SMS</label>
            <input
              class="input"
              id="mm-limite"
              name="limite_mensual"
              type="number"
              inputmode="numeric"
              min="1"
              max="1000000000"
              step="1"
              required
              aria-describedby="mm-limite-hint"
            />
            <p class="field__hint" id="mm-limite-hint" data-limite-hint></p>
          </div>

          <div class="field">
            <label class="field__label" for="mm-registros" data-i18n="mowaMes.plataforma.registros">Filas por archivo</label>
            <input
              class="input"
              id="mm-registros"
              name="registros_por_archivo"
              type="number"
              inputmode="numeric"
              min="1"
              max="50000"
              step="1"
              required
              aria-describedby="mm-registros-hint"
            />
            <p class="field__hint" id="mm-registros-hint" data-registros-hint></p>
          </div>

          <div class="field">
            <label class="field__label" for="mm-bytes" data-i18n="mowaMes.plataforma.bytes">Tamaño máximo por archivo (bytes)</label>
            <input
              class="input"
              id="mm-bytes"
              name="bytes_por_archivo"
              type="number"
              inputmode="numeric"
              min="100000"
              max="2000000"
              step="1"
              required
              aria-describedby="mm-bytes-hint"
            />
            <p class="field__hint" id="mm-bytes-hint" data-bytes-hint></p>
          </div>

          <div class="field">
            <label class="field__label" for="mm-whatsapp" data-i18n="mowaMes.plataforma.whatsapp">WhatsApp de contacto</label>
            <input
              class="input"
              id="mm-whatsapp"
              name="whatsapp_contacto"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              maxlength="20"
              aria-describedby="mm-whatsapp-hint"
            />
            <p class="field__hint" id="mm-whatsapp-hint" data-i18n="mowaMes.plataforma.whatsapp.hint">
              Número de 9 dígitos. El speech lo convierte en https://wa.me/+51 y el número.
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="mm-tarifa" data-i18n="mowaMes.plataforma.tarifa">Tarifa por SMS (S/)</label>
            <input
              class="input mono"
              id="mm-tarifa"
              name="tarifa_sms"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              maxlength="12"
              aria-describedby="mm-tarifa-hint mm-tarifa-error"
            />
            <p class="field__hint" id="mm-tarifa-hint" data-i18n="mowaMes.plataforma.tarifa.hint">
              Decimal de 0 en adelante, con hasta 4 decimales (por ejemplo 0.02). Cada campaña guarda la tarifa vigente al crearse.
            </p>
            <p class="field__error" id="mm-tarifa-error" data-tarifa-error role="alert"></p>
          </div>

          <div class="field mm-plataforma__plantilla">
            <label class="field__label" for="mm-plantilla" data-i18n="mowaMes.plataforma.plantilla">Nombre de los archivos</label>
            <input
              class="input mono"
              id="mm-plantilla"
              name="plantilla_nombre_archivo"
              type="text"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="mm-plantilla-hint mm-plantilla-ejemplo mm-plantilla-error"
            />
            <div class="mm-variables" role="group" data-i18n-attr="aria-label:mowaMes.plantilla.variables" aria-label="Variables de la plantilla" data-plantilla-variables></div>
            <p class="field__hint" id="mm-plantilla-hint" data-i18n="mowaMes.plataforma.plantilla.hint">
              Es la plantilla de cada campaña nueva; en la campaña se puede cambiar solo para ella.
            </p>
            <div class="mm-nombre-archivo" id="mm-plantilla-ejemplo" data-plantilla-ejemplo></div>
            <p class="field__error" id="mm-plantilla-error" data-plantilla-error role="alert"></p>
          </div>

          <p class="notice notice--warning" data-sin-whatsapp hidden>
            <Icon name="triangle-alert" size={20} />
            <span data-i18n="mowaMes.plataforma.sinWhatsapp">
              Sin WhatsApp de contacto, los segmentos del speech que lo usan no se pueden generar.
            </span>
          </p>

          <p class="field__error" data-plataforma-error role="alert"></p>

          <div class="mm-form__foot">
            <button type="submit" class="btn btn--primary" data-plataforma-guardar>
              <span class="btn__spinner" aria-hidden="true"></span>
              <span class="btn__label" data-i18n="mowaMes.plataforma.guardar">Guardar plataforma</span>
            </button>
            <p class="mono muted" data-plataforma-estado role="status"></p>
          </div>
        </form>
      </section>

      <!-- ---- Speech versions ----------------------------------------------- -->
      <section class="panel mm-speech" aria-labelledby="mm-speech-title">
        <div class="panel__head">
          <h2 class="panel__title" id="mm-speech-title" data-i18n="mowaMes.speech.title">Speech por segmento</h2>
          <div class="mm-speech__version">
            <label class="field__label" for="mm-version" data-i18n="mowaMes.speech.version">Versión</label>
            <select class="input" id="mm-version" data-version></select>
          </div>
        </div>

        <form class="panel__body mm-form" data-form-speech novalidate>
          <p class="mono muted mm-nota" data-speech-meta></p>

          <!-- What can be done to the version on screen while it is enabled (RF-MM-28, RF-MM-29). -->
          <div class="mm-acciones" data-speech-acciones hidden>
            <button type="button" class="btn btn--sm" data-speech-renombrar>
              <Icon name="pencil" size={16} />
              <span data-i18n="mowaMes.accion.renombrar">Renombrar</span>
            </button>
            <button type="button" class="btn btn--sm" data-speech-deshabilitar>
              <span class="btn__spinner" aria-hidden="true"></span>
              <Icon name="power-off" size={16} />
              <span class="btn__label" data-i18n="mowaMes.accion.deshabilitar">Deshabilitar</span>
            </button>
          </div>

          <p class="notice notice--info" data-speech-inmutable hidden>
            <Icon name="lock" size={20} />
            <span data-speech-inmutable-texto></span>
          </p>

          <p class="notice notice--warning" data-speech-falta-whatsapp hidden>
            <Icon name="triangle-alert" size={20} />
            <span data-i18n="mowaMes.speech.faltaWhatsapp">
              Falta el WhatsApp de contacto y hay segmentos que usan [whatsapp]: no se pueden generar hasta configurarlo en Plataforma.
            </span>
          </p>

          <!-- The speech reads an archived additional field: in the campaign, the products that need it are left out
               (T-MM-F11, T-MM-F12). A warning, with its own texts: the engine's «sigue funcionando» would mislead. -->
          <p class="notice notice--warning" data-speech-archivados hidden>
            <Icon name="triangle-alert" size={20} />
            <span data-speech-archivados-texto></span>
          </p>

          <div class="notice notice--danger" data-speech-problemas hidden role="status">
            <Icon name="circle-alert" size={20} />
            <div>
              <strong data-i18n="mowaMes.speech.problemas">La API no acepta estas partes:</strong>
              <ul class="mm-problemas" data-speech-problemas-lista></ul>
            </div>
          </div>

          <p class="field__hint" data-speech-v1 data-i18n="mowaMes.speech.estructura">
            Mensaje = titular (8 caracteres) + parte 1 + fecha de vencimiento (dd/mm/aaaa) + parte 2. Donde dice [whatsapp] va el enlace al WhatsApp de contacto.
          </p>

          <p class="mm-speech__resumen" role="status" data-speech-v1 data-speech-resumen></p>

          <div class="table-scroll" data-speech-v1>
            <table class="table mm-speech__tabla table--apilable table--apilable-ancha">
              <thead>
                <tr>
                  <th scope="col" data-i18n="mowaMes.speech.col.segmento">Segmento</th>
                  <th scope="col" data-i18n="mowaMes.speech.col.parte1">Parte 1</th>
                  <th scope="col" data-i18n="mowaMes.speech.col.parte2">Parte 2</th>
                  <th scope="col" class="num" data-i18n="mowaMes.speech.col.largo">Largo máximo</th>
                  <th scope="col" data-i18n="mowaMes.speech.col.estado">Estado</th>
                </tr>
              </thead>
              <tbody data-speech-filas></tbody>
            </table>
          </div>

          <p class="mono muted mm-speech__calculo" data-speech-v1 data-speech-calculo></p>

          <!-- v2: the segment-by-segment editor, and the way a v1 becomes one. v1 above is untouched. -->
          <div class="mm-speech-v2" data-v2-convertir hidden>
            <p class="field__hint" id="mm-v2-convertir-hint" data-i18n="mowaMes.speech.v2.convertir.hint">
              Para personalizarla, conviértela a v2: obtienes un borrador con los mismos mensajes, que no se guarda hasta que lo confirmes.
            </p>
            <div class="mm-speech-v2__acciones">
              <button type="button" class="btn" data-v2-convertir-boton aria-describedby="mm-v2-convertir-hint">
                <span class="btn__spinner" aria-hidden="true"></span>
                <span class="btn__label" data-i18n="mowaMes.speech.v2.convertir.boton">Convertir a v2</span>
              </button>
            </div>
          </div>

          <div class="mm-speech-v2" data-v2-editor-bloque hidden>
            <p class="notice notice--info" data-v2-borrador hidden>
              <Icon name="info" size={20} />
              <span data-v2-borrador-texto></span>
            </p>
            <VariantesSegmento id="mm-speech-v2" etiqueta="Speech por segmento" claveEtiqueta="mowaMes.speech.title" />
            <!-- What GSM-7 deletes from the segment on screen (RF-MM-27); no live region: it would re-announce on every keystroke. -->
            <p class="notice notice--warning" data-borrados-v2 hidden>
              <Icon name="triangle-alert" size={20} />
              <span data-borrados-v2-texto></span>
            </p>
            <p class="field__hint" data-i18n="mowaMes.speech.v2.avisoSegmento">
              Con un producto real de muestra, el segmento sale de sus días de atraso ajustados a hoy, como si el mensaje se enviara hoy; en la campaña se ajustan a su fecha de envío.
            </p>
          </div>

          <p class="field__hint" data-speech-gsm7 hidden data-i18n="mowaMes.speech.gsm7">
            Al generar, se quitan las tildes, los signos que el SMS no admite se cambian por uno simple y los que no tienen equivalente se borran. La versión se guarda como la escribes.
          </p>

          <div class="mm-form__foot mm-speech__foot" data-speech-pie hidden>
            <div class="field mm-speech__nombre">
              <label class="field__label" for="mm-speech-nombre" data-i18n="mowaMes.speech.nombre">Nombre de la versión</label>
              <input class="input" id="mm-speech-nombre" type="text" maxlength="120" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn--primary" data-speech-guardar>
              <span class="btn__spinner" aria-hidden="true"></span>
              <span class="btn__label" data-speech-guardar-texto></span>
            </button>
            <button type="button" class="btn" data-speech-descartar data-i18n="mowaMes.descartar">
              Descartar cambios
            </button>
          </div>

          <p class="field__error" id="mm-speech-error" data-speech-error role="alert"></p>
          <p class="mono muted" data-speech-estado role="status"></p>
        </form>
      </section>

      <!-- ---- Disabled versions (RF-MM-29, RF-MM-30): folded, closed, and not shown with none --------------- -->
      <section class="panel mm-deshab" data-deshabilitadas hidden aria-labelledby="mm-deshab-title">
        <details>
          <summary class="panel__head">
            <Icon name="chevron-right" size={16} class="mm-deshab__flecha" />
            <h2 class="panel__title" id="mm-deshab-title" data-deshab-titulo></h2>
          </summary>
          <ul class="panel__body mm-deshab__lista" data-deshab-lista></ul>
        </details>
      </section>
    </div>
  </div>

  <!-- Rename a version (RF-MM-28): the dialog of the saved definitions (motor-texto-enriquecido-interfaz.md §10.1). -->
  <dialog class="dialog" data-dialog="renombrar" aria-labelledby="mm-renombrar-title">
    <form method="dialog" data-renombrar-form novalidate>
      <div class="dialog__head">
        <h2 id="mm-renombrar-title" data-renombrar-titulo></h2>
      </div>
      <div class="dialog__body">
        <div class="field">
          <label class="field__label" for="mm-renombrar-nombre" data-i18n="mowaMes.speech.renombrar.campo">Nombre nuevo</label>
          <input
            class="input"
            id="mm-renombrar-nombre"
            data-renombrar-nombre
            type="text"
            maxlength="120"
            autocomplete="off"
            aria-describedby="mm-renombrar-hint mm-renombrar-error"
          />
          <p class="field__hint" id="mm-renombrar-hint" data-i18n="mowaMes.speech.renombrar.hint">
            Las campañas siguen apuntando a esta versión: registran la versión, no su nombre.
          </p>
          <p class="field__error" id="mm-renombrar-error" data-renombrar-error role="alert"></p>
        </div>
      </div>
      <div class="dialog__foot">
        <button type="button" class="btn" data-close data-i18n="mowaMes.confirmar.cancelar">Cancelar</button>
        <button type="submit" class="btn btn--primary" data-renombrar-confirmar>
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__label" data-i18n="mowaMes.speech.renombrar.confirmar">Renombrar</span>
        </button>
      </div>
    </form>
  </dialog>

  <!-- Delete a disabled version for good (RF-MM-30, §4.6): the danger notice and the mandatory checkbox. -->
  <dialog class="dialog" data-dialog="eliminar" aria-labelledby="mm-eliminar-title">
    <div class="dialog__head">
      <h2 id="mm-eliminar-title" data-eliminar-titulo></h2>
    </div>
    <div class="dialog__body">
      <p class="notice notice--danger">
        <Icon name="triangle-alert" size={20} />
        <span data-i18n="mowaMes.confirmar.eliminar.cuerpoVersion">Se borra la versión y su texto. No se puede deshacer.</span>
      </p>
      <label class="choice choice--check">
        <input type="checkbox" data-eliminar-casilla />
        <span class="choice__body">
          <span class="choice__title" data-i18n="mowaMes.confirmar.eliminar.casilla">Entiendo que no se puede deshacer</span>
        </span>
      </label>
      <p class="field__error" data-eliminar-error role="alert"></p>
    </div>
    <div class="dialog__foot">
      <button type="button" class="btn" data-close data-eliminar-cancelar data-i18n="mowaMes.confirmar.cancelar">Cancelar</button>
      <button type="button" class="btn btn--danger" data-eliminar-aceptar>
        <span class="btn__spinner" aria-hidden="true"></span>
        <Icon name="trash-2" size={16} />
        <span class="btn__label" data-i18n="mowaMes.accion.eliminar">Eliminar definitivamente</span>
      </button>
    </div>
  </dialog>

  <!-- Icons for rows the script builds: rendered once here, cloned per row. -->
  <template data-icono-borrados><Icon name="triangle-alert" size={16} /></template>
  <template data-icono-ver><Icon name="eye" size={16} /></template>
  <template data-icono-habilitar><Icon name="power" size={16} /></template>
  <template data-icono-eliminar><Icon name="trash-2" size={16} /></template>
  <template data-icono-deshabilitada><Icon name="power-off" size={16} /></template>
  <template data-icono-original><Icon name="lock" size={16} /></template>

  <!-- ---- Generic failure ---------------------------------------------- -->
  <dialog class="dialog" data-dialog="error" aria-labelledby="mm-error-title">
    <div class="dialog__head">
      <h2 id="mm-error-title" data-i18n="common.error">Algo salió mal</h2>
    </div>
    <div class="dialog__body">
      <p class="notice notice--danger">
        <Icon name="circle-alert" size={20} />
        <span data-error-body></span>
      </p>
    </div>
    <div class="dialog__foot">
      <button type="button" class="btn btn--primary" data-close data-i18n="common.close">Cerrar</button>
    </div>
  </dialog>
</Shell>

<script>
  import { ApiError, NetworkError, mensajeDeError } from '../../lib/api';
  import { $, ocupado } from '../../lib/dom';
  import {
    crearSpeech,
    editarSpeech,
    eliminarSpeech,
    guardarConfiguracion,
    listarSpeech,
    modificarSpeech,
    obtenerConfiguracion,
    previsualizarPlantillaNombre,
    previsualizarSpeech,
    type ConfiguracionMowaMes,
    type LargoSegmento,
    type PartesEntrada,
    type PrevisualizacionSpeech,
    type VersionSpeech,
  } from '../../lib/api-mowa-mes';
  import { openWhenFree } from '../../lib/dialogs';
  import { notaVariablesDesconocidas, pintarBotonesDeVariables } from '../../lib/mowa-mes-plantilla';
  import { formatBytes, formatDateTime, formatNumber } from '../../lib/format';
  import { obtenerComoV2, problemasDeErrorSpeech } from '../../lib/api-speech-v2';
  import { SEPARADOR_BORRADOS, elementosBorrados, type CaracterQuitado } from '../../lib/mowa-mes-gsm7';
  import { avisoDeCamposArchivados } from '../../lib/mowa-mes-seguimiento';
  import { hayNombreNuevo } from '../../lib/renombrar-definicion';
  import {
    LARGO_NOMBRE_SPEECH,
    accionDeEliminar,
    clasificarErrorDeRenombrarSpeech,
    conVersion,
    deshabilitadas,
    estaHabilitada,
    habilitadas,
    sinVersion,
    versionesDelSelector,
  } from '../../lib/mowa-mes-speech-administracion';
  import { applyTranslations, t, traducirPorPrefijo } from '../../lib/i18n';
  import {
    entradaDeExpresiones,
    esV2,
    hayCambiosV2,
    mensajeDeProblema,
    nivelesDeV2,
    segmentosDeVersion,
    segmentosSinContenido,
    variantesDeVersion,
    type ProblemaSpeech,
  } from '../../lib/mowa-mes-speech-v2';
  import type { Segmento as SegmentoDeVariantes, Variante } from '../../lib/variantes';
  import {
    EVENTO_VARIANTES,
    montarVariantes,
    type ControladorVariantes,
    type EstadoVariantes,
  } from '../../scripts/variantes-segmento';
  import {
    borradorDesdeVersion,
    campoDeError,
    modoGuardado,
    nivelDeFila,
    rangoSegmento,
    resumenNiveles,
    RANGOS_CONFIGURACION,
    problemasConfiguracion,
    textoDeRango,
    tarifaEditable,
    tarifaNormalizada,
    type CampoConfiguracion,
    traducirCodigo,
  } from '../../lib/mowa-mes';

  /** Long enough to let a sentence be typed, short enough to feel live. */
  const ESPERA_PREVISUALIZACION = 400;

  const estado = {
    configuracion: null as ConfiguracionMowaMes | null,
    versiones: [] as VersionSpeech[],
    versionId: null as number | null,
    borrador: [] as PartesEntrada[],
    previsualizacion: null as PrevisualizacionSpeech | null,
    /**
     * The v2 speech on screen: a saved v2 version being edited, or the draft a v1 became (`borrador`,
     * not saved until the analyst confirms). `null` is the v1 screen, untouched.
     */
    v2: null as {
      borrador: boolean;
      baseId: number;
      nombreSugerido: string;
      variantes: Variante[];
      segmentos: SegmentoDeVariantes[];
      problemas: ProblemaSpeech[];
    } | null,
    /** What the editor last said about the open content: gates saving. */
    v2Editor: { pendiente: false, valida: true },
    largosV2: [] as LargoSegmento[],
  };

  const dialogos = {
    error: $<HTMLDialogElement>('[data-dialog="error"]'),
    renombrar: $<HTMLDialogElement>('[data-dialog="renombrar"]'),
    eliminar: $<HTMLDialogElement>('[data-dialog="eliminar"]'),
  };

  document.querySelectorAll<HTMLElement>('[data-close]').forEach((boton) => {
    boton.addEventListener('click', () => boton.closest('dialog')?.close());
  });

  // ---- Shared helpers -----------------------------------------------------------

  function mostrarError(error: unknown): void {
    $<HTMLElement>('[data-error-body]').textContent = mensajeDeError(error);
    void openWhenFree(dialogos.error);
  }

  /** A status line that says what just happened, then gets out of the way. */
  function avisar(nodo: HTMLElement, clave: string): void {
    nodo.textContent = t(clave);
    window.setTimeout(() => {
      if (nodo.textContent === t(clave)) nodo.textContent = '';
    }, 4000);
  }

  // ---- Platform ----------------------------------------------------------------

  const formPlataforma = $<HTMLFormElement>('[data-form-plataforma]');
  const inputLimite = $<HTMLInputElement>('#mm-limite');
  const inputRegistros = $<HTMLInputElement>('#mm-registros');
  const inputBytes = $<HTMLInputElement>('#mm-bytes');
  const inputWhatsapp = $<HTMLInputElement>('#mm-whatsapp');
  const inputTarifa = $<HTMLInputElement>('#mm-tarifa');
  const inputPlantilla = $<HTMLInputElement>('#mm-plantilla');
  const controlesPlataforma: Record<CampoConfiguracion, HTMLInputElement> = {
    limite_mensual: inputLimite,
    registros_por_archivo: inputRegistros,
    bytes_por_archivo: inputBytes,
  };

  function pintarPlataforma(): void {
    const config = estado.configuracion;
    if (!config) return;
    inputLimite.value = String(config.limite_mensual);
    inputRegistros.value = String(config.registros_por_archivo);
    inputBytes.value = String(config.bytes_por_archivo);
    inputWhatsapp.value = config.whatsapp_contacto ?? '';
    inputTarifa.value = tarifaEditable(config.tarifa_sms);
    inputPlantilla.value = config.plantilla_nombre_archivo;
    pintarBotonesDeVariables($<HTMLElement>('[data-plantilla-variables]'), inputPlantilla, config.variables_plantilla);
    pintarMetaPlataforma();
    void revisarPlantilla(0);
  }

  // ---- File-name template: live example, from the API ---------------------------------------

  let temporizadorPlantilla = 0;
  let controlPlantilla: AbortController | null = null;

  function pintarEjemplo(nombres: readonly string[]): void {
    const host = $<HTMLElement>('[data-plantilla-ejemplo]');
    host.replaceChildren(
      ...nombres.map((nombre, indice) => {
        const linea = document.createElement('p');
        const etiqueta = document.createElement('span');
        etiqueta.textContent = t(indice === 0 ? 'mowaMes.plantilla.primerArchivo' : 'mowaMes.plantilla.otroArchivo', {
          n: indice + 1,
        });
        const valor = document.createElement('span');
        valor.className = 'mono';
        valor.textContent = nombre;
        linea.append(etiqueta, ' ', valor);
        return linea;
      }),
    );
  }

  function errorDePlantilla(texto: string): void {
    $<HTMLElement>('[data-plantilla-error]').textContent = texto;
    inputPlantilla.setAttribute('aria-invalid', String(texto !== ''));
  }

  /**
   * The unknown-variable note is local, from the list the API sent; the name
   * itself, and any other reason (an unclosed brace), come from the API.
   */
  async function revisarPlantilla(espera = ESPERA_PREVISUALIZACION): Promise<void> {
    window.clearTimeout(temporizadorPlantilla);
    controlPlantilla?.abort();
    const variables = estado.configuracion?.variables_plantilla ?? [];
    const nota = notaVariablesDesconocidas(inputPlantilla.value, variables);
    errorDePlantilla(nota);
    if (nota !== '') {
      pintarEjemplo([]);
      return;
    }
    const control = new AbortController();
    controlPlantilla = control;
    await new Promise<void>((resolver) => {
      temporizadorPlantilla = window.setTimeout(resolver, espera);
    });
    if (control.signal.aborted) return;
    try {
      const respuesta = await previsualizarPlantillaNombre(inputPlantilla.value, control.signal);
      if (control.signal.aborted) return;
      errorDePlantilla('');
      pintarEjemplo(respuesta.nombres_ejemplo);
    } catch (caido) {
      if (caido instanceof DOMException && caido.name === 'AbortError') return;
      pintarEjemplo([]);
      errorDePlantilla(caido instanceof ApiError ? caido.detail || t('common.errorBody') : mensajeDeError(caido));
    }
  }

  function pintarMetaPlataforma(): void {
    const config = estado.configuracion;
    const limite = Number(inputLimite.value);
    $<HTMLElement>('[data-limite-hint]').textContent = Number.isInteger(limite) && limite > 0
      ? t('mowaMes.plataforma.limite.hint', { n: formatNumber(limite) })
      : textoDeRango('limite_mensual');
    $<HTMLElement>('[data-registros-hint]').textContent = t('mowaMes.plataforma.registros.hint', {
      max: formatNumber(RANGOS_CONFIGURACION.registros_por_archivo.maximo),
    });
    const bytes = Number(inputBytes.value);
    $<HTMLElement>('[data-bytes-hint]').textContent = t('mowaMes.plataforma.bytes.hint', {
      min: formatNumber(RANGOS_CONFIGURACION.bytes_por_archivo.minimo),
      max: formatNumber(RANGOS_CONFIGURACION.bytes_por_archivo.maximo),
      actual: Number.isInteger(bytes) && bytes > 0 ? formatBytes(bytes) : '—',
    });
    $<HTMLElement>('[data-plataforma-meta]').textContent = config?.actualizado_en
      ? t('mowaMes.actualizado', { fecha: formatDateTime(config.actualizado_en) })
      : '';
    $<HTMLElement>('[data-sin-whatsapp]').hidden = Boolean(config?.whatsapp_contacto);
  }

  function limpiarErrorPlataforma(): void {
    $<HTMLElement>('[data-plataforma-error]').textContent = '';
    $<HTMLElement>('[data-tarifa-error]').textContent = '';
    [inputLimite, inputRegistros, inputBytes, inputWhatsapp, inputTarifa].forEach((control) => {
      control.removeAttribute('aria-invalid');
    });
  }

  [inputLimite, inputRegistros, inputBytes].forEach((control) => {
    control.addEventListener('input', () => {
      limpiarErrorPlataforma();
      pintarMetaPlataforma();
    });
  });
  inputWhatsapp.addEventListener('input', limpiarErrorPlataforma);
  inputTarifa.addEventListener('input', limpiarErrorPlataforma);
  inputPlantilla.addEventListener('input', () => void revisarPlantilla());

  formPlataforma.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    limpiarErrorPlataforma();
    const error = $<HTMLElement>('[data-plataforma-error]');

    const invalidos = problemasConfiguracion({
      limite_mensual: inputLimite.value,
      registros_por_archivo: inputRegistros.value,
      bytes_por_archivo: inputBytes.value,
    });
    if (invalidos.length > 0) {
      error.textContent = invalidos.map((campo) => textoDeRango(campo)).join(' ');
      invalidos.forEach((campo) => controlesPlataforma[campo].setAttribute('aria-invalid', 'true'));
      controlesPlataforma[invalidos[0]].focus();
      return;
    }

    const tarifa = tarifaNormalizada(inputTarifa.value);
    if (tarifa === null) {
      $<HTMLElement>('[data-tarifa-error]').textContent = t('mowaMes.plataforma.tarifa.invalida');
      inputTarifa.setAttribute('aria-invalid', 'true');
      inputTarifa.focus();
      return;
    }
    if (notaVariablesDesconocidas(inputPlantilla.value, estado.configuracion?.variables_plantilla ?? []) !== '') {
      inputPlantilla.focus();
      return;
    }

    const whatsapp = inputWhatsapp.value.trim();
    const guardar = $<HTMLButtonElement>('[data-plataforma-guardar]');
    ocupado(guardar, true);
    try {
      estado.configuracion = await guardarConfiguracion({
        limite_mensual: Number(inputLimite.value.trim()),
        registros_por_archivo: Number(inputRegistros.value.trim()),
        bytes_por_archivo: Number(inputBytes.value.trim()),
        whatsapp_contacto: whatsapp === '' ? null : whatsapp,
        tarifa_sms: tarifa,
        plantilla_nombre_archivo: inputPlantilla.value,
      });
      pintarPlataforma();
      avisar($<HTMLElement>('[data-plataforma-estado]'), 'mowaMes.guardado');
      // The configured WhatsApp is what the speech preview builds links with.
      programarPrevisualizacion(0);
    } catch (caido) {
      if (caido instanceof ApiError && caido.status === 400) {
        // The 400 names the setting it is about (`campo`). Without one, the sentence
        // goes to the panel's general notice: the field is never guessed from its words.
        const detalle = caido.detail || t('common.errorBody');
        const campo = campoDeError(caido.cuerpo);
        if (campo === 'tarifa_sms') {
          $<HTMLElement>('[data-tarifa-error]').textContent = detalle;
          inputTarifa.setAttribute('aria-invalid', 'true');
          inputTarifa.focus();
        } else if (campo === 'plantilla_nombre_archivo') {
          errorDePlantilla(detalle);
          inputPlantilla.focus();
        } else {
          error.textContent = detalle;
          const control =
            campo === 'whatsapp_contacto'
              ? inputWhatsapp
              : campo === null
                ? null
                : controlesPlataforma[campo];
          control?.setAttribute('aria-invalid', 'true');
          control?.focus();
        }
      } else {
        error.textContent = mensajeDeError(caido);
      }
    } finally {
      ocupado(guardar, false);
    }
  });

  // ---- Speech ------------------------------------------------------------------

  const formSpeech = $<HTMLFormElement>('[data-form-speech]');
  const selectVersion = $<HTMLSelectElement>('[data-version]');
  const inputNombre = $<HTMLInputElement>('#mm-speech-nombre');
  let temporizadorPrevisualizacion = 0;
  let controlPrevisualizacion: AbortController | null = null;

  const versionActual = (): VersionSpeech | null =>
    estado.versiones.find((v) => v.id === estado.versionId) ?? null;

  function etiquetaVersion(version: VersionSpeech): string {
    const marcas = [];
    if (version.original) marcas.push(t('mowaMes.speech.marca.original'));
    if (version.usada) marcas.push(t('mowaMes.speech.marca.usada'));
    if (!estaHabilitada(version)) marcas.push(t('mowaMes.speech.marca.deshabilitada'));
    return marcas.length ? `${version.nombre} (${marcas.join(', ')})` : version.nombre;
  }

  /** The selector lists the enabled versions, and the disabled one on screen so it still says what the editor shows. */
  function pintarVersiones(): void {
    selectVersion.replaceChildren();
    versionesDelSelector(estado.versiones, estado.versionId).forEach((version) => {
      const opcion = document.createElement('option');
      opcion.value = String(version.id);
      opcion.textContent = etiquetaVersion(version);
      selectVersion.append(opcion);
    });
    if (estado.versionId !== null) selectVersion.value = String(estado.versionId);
    pintarDeshabilitadas();
  }

  /** A text of the screen's status line, which then gets out of the way (an announcement with a name in it). */
  function anunciar(texto: string): void {
    const nodo = $<HTMLElement>('[data-speech-estado]');
    nodo.textContent = texto;
    window.setTimeout(() => {
      if (nodo.textContent === texto) nodo.textContent = '';
    }, 4000);
  }

  /** The row of a disabled version: its name and tags, and Ver, Habilitar and Eliminar (or why it cannot be). */
  function filaDeshabilitada(version: VersionSpeech): HTMLElement {
    const fila = document.createElement('li');
    fila.className = 'mm-deshab__fila';
    fila.dataset.version = String(version.id);

    const nombre = document.createElement('span');
    nombre.className = 'mm-deshab__nombre';
    nombre.id = `mm-deshab-nombre-${version.id}`;
    nombre.textContent = version.nombre;

    const marcas = document.createElement('span');
    marcas.className = 'mm-deshab__marcas';
    // «Deshabilitada» is neutral and «Original» is info, as the catalogue says (§3.2): two states, two tones.
    const etiqueta = (icono: 'deshabilitada' | 'original', clave: string, tono: 'neutral' | 'info'): HTMLElement => {
      const tag = document.createElement('span');
      tag.className = `tag tag--${tono}`;
      tag.append(
        $<HTMLTemplateElement>(`template[data-icono-${icono}]`).content.cloneNode(true),
        document.createTextNode(t(clave)),
      );
      return tag;
    };
    marcas.append(etiqueta('deshabilitada', 'mowaMes.estado.deshabilitada', 'neutral'));
    if (version.original) marcas.append(etiqueta('original', 'mowaMes.estado.original', 'info'));

    // The button's name is its own text and then the row's name («Ver «Borrable»»), so «Ver», «Habilitar» and
    // «Eliminar» tell the rows apart in a list of buttons too, where a description is not read. It starts with
    // the visible text (WCAG 2.5.3).
    const boton = (icono: 'ver' | 'habilitar' | 'eliminar', clave: string, clase: string): HTMLButtonElement => {
      const nodo = document.createElement('button');
      nodo.type = 'button';
      nodo.id = `mm-deshab-${icono}-${version.id}`;
      nodo.className = `btn btn--sm ${clase}`.trim();
      nodo.setAttribute('aria-labelledby', `${nodo.id} ${nombre.id}`);
      nodo.append(
        $<HTMLTemplateElement>(`template[data-icono-${icono}]`).content.cloneNode(true),
        document.createTextNode(t(clave)),
      );
      return nodo;
    };
    const ver = boton('ver', 'mowaMes.accion.ver', '');
    ver.addEventListener('click', () => verVersion(version.id));
    const habilitar = boton('habilitar', 'mowaMes.accion.habilitar', '');
    habilitar.addEventListener('click', () => void habilitarVersion(version));
    const acciones = document.createElement('div');
    acciones.className = 'mm-acciones';
    acciones.append(ver, habilitar);

    // Deleting is offered only when the API says it can be done; otherwise the reason takes its place.
    const eliminar = accionDeEliminar(version);
    if (eliminar.tipo === 'boton') {
      const borrar = boton('eliminar', 'mowaMes.accion.eliminar', 'btn--danger');
      borrar.addEventListener('click', () => void pedirEliminar(version));
      acciones.append(borrar);
    }

    fila.append(nombre, marcas, acciones);
    if (eliminar.tipo === 'motivo') {
      const motivo = document.createElement('p');
      motivo.className = 'field__hint mm-deshab__motivo';
      motivo.textContent = t(`mowaMes.errorSpeech.${eliminar.clave}`);
      fila.append(motivo);
    }
    return fila;
  }

  /** «Versiones deshabilitadas (N)»: shown only when there is one, and closed. */
  function pintarDeshabilitadas(): void {
    const lista = deshabilitadas(estado.versiones);
    $<HTMLElement>('[data-deshabilitadas]').hidden = lista.length === 0;
    $<HTMLElement>('[data-deshab-titulo]').textContent = t('mowaMes.configuracion.deshabilitadas.titulo', {
      n: formatNumber(lista.length),
    });
    $<HTMLElement>('[data-deshab-lista]').replaceChildren(...lista.map(filaDeshabilitada));
  }

  function elegirVersion(id: number | null): void {
    estado.versionId = id;
    const version = versionActual();
    estado.borrador = version ? borradorDesdeVersion(version) : [];
    estado.previsualizacion = null;
    estado.largosV2 = [];
    // A saved v2 opens in the v2 editor; a v1 (or none) in the table of parts, exactly as before.
    estado.v2 =
      version && esV2(version)
        ? {
            borrador: false,
            baseId: version.id,
            nombreSugerido: '',
            variantes: variantesDeVersion(version),
            segmentos: segmentosDeVersion(version),
            problemas: [],
          }
        : null;
    fuenteV2 = '';
    inputNombre.value = version && modoGuardado(version) === 'editar' ? version.nombre : '';
    $<HTMLElement>('[data-speech-error]').textContent = '';
    pintarVersiones();
    pintarSpeech();
    programarPrevisualizacion(0);
  }

  /**
   * «Al enviar se borran: …» (RF-MM-27, §10.2). The elements are what the backend says is deleted, in
   * its order and each one once; a visible one in mono, an invisible one by its name with its code point
   * in mono. An empty list hides the host: a segment with nothing deleted has no line.
   */
  function pintarBorrados(host: HTMLElement, quitados: readonly CaracterQuitado[]): void {
    const elementos = elementosBorrados(quitados);
    host.hidden = elementos.length === 0;
    if (elementos.length === 0) {
      host.replaceChildren();
      return;
    }
    const icono = $<HTMLTemplateElement>('template[data-icono-borrados]').content.cloneNode(true);
    const texto = document.createElement('span');
    texto.dataset.borradosTexto = '';
    texto.append(`${t('mowaMes.speech.borrados.prefijo')} `);
    elementos.forEach((elemento, i) => {
      if (i > 0) texto.append(SEPARADOR_BORRADOS);
      if (elemento.nombre === null) {
        const visible = document.createElement('span');
        visible.className = 'mono';
        visible.dataset.borradoVisible = '';
        visible.textContent = elemento.caracter;
        texto.append(visible);
        return;
      }
      const nombre = document.createElement('span');
      nombre.dataset.borradoNombre = '';
      nombre.textContent = elemento.nombre;
      const codigo = document.createElement('span');
      codigo.className = 'mono';
      codigo.dataset.borradoCodigo = '';
      codigo.textContent = elemento.codigo;
      texto.append(nombre, ' ', codigo);
    });
    host.replaceChildren(icono, texto);
  }

  /**
   * The notice of an archived additional field the speech reads: sheets loaded after archiving no longer bring
   * it, so in the campaign the products that need it are left out. Hidden when there is none, and also when
   * there is no preview to say it about.
   */
  function pintarArchivados(campos: Parameters<typeof avisoDeCamposArchivados>[0]): void {
    const aviso = avisoDeCamposArchivados(campos, 'editor');
    $<HTMLElement>('[data-speech-archivados]').hidden = aviso === null;
    $<HTMLElement>('[data-speech-archivados-texto]').textContent = aviso ?? '';
  }

  /** v2: the line of the segment on screen, under the editor. */
  function pintarBorradosV2(): void {
    const seleccionado = ctlV2?.estado().seleccionado ?? null;
    const segmento = seleccionado === null ? undefined : estado.largosV2.find((s) => s.segmento === seleccionado);
    pintarBorrados($<HTMLElement>('[data-borrados-v2]'), segmento?.caracteres_quitados ?? []);
  }

  function pintarSpeech(): void {
    const version = versionActual();
    // Rename and disable are for an enabled version; a disabled one is read, and enabled from its list.
    $<HTMLElement>('[data-speech-acciones]').hidden = !version || !estaHabilitada(version);
    mostrarRama();
    $<HTMLElement>('[data-speech-gsm7]').hidden = !version;
    if (estado.v2 && version) {
      pintarSpeechV2(version);
      return;
    }
    const filas = $<HTMLElement>('[data-speech-filas]');
    filas.replaceChildren();

    if (!version) {
      $<HTMLElement>('[data-speech-meta]').textContent = '';
      $<HTMLElement>('[data-speech-inmutable]').hidden = true;
      pintarEstadoSpeech();
      return;
    }

    const meta = [t('mowaMes.speech.creada', { fecha: formatDateTime(version.creado_en) })];
    const base = estado.versiones.find((v) => v.id === version.basada_en_id);
    if (base) meta.push(t('mowaMes.speech.basadaEn', { nombre: base.nombre }));
    $<HTMLElement>('[data-speech-meta]').textContent = meta.join('  ·  ');

    // A v1 is always immutable now (RF-MM-17, M3): it is used in campaigns as it is, and converted to change it.
    $<HTMLElement>('[data-speech-inmutable]').hidden = false;
    $<HTMLElement>('[data-speech-inmutable-texto]').textContent = t(
      estaHabilitada(version) ? 'mowaMes.speech.inmutable.v1' : 'mowaMes.speech.inmutable.deshabilitada',
    );

    estado.borrador.forEach((parte) => {
      const info = version.partes.find((p) => p.segmento === parte.segmento);
      const fila = document.createElement('tr');
      fila.dataset.segmento = parte.segmento;

      const segmento = document.createElement('th');
      segmento.scope = 'row';
      // The stacked card reads segment, length, status, and then the parts with their example.
      segmento.dataset.orden = '1';
      const nombre = document.createElement('span');
      nombre.className = 'mm-speech__segmento';
      nombre.textContent = info?.etiqueta ?? parte.segmento;
      const rango = document.createElement('span');
      rango.className = 'mono muted mm-speech__rango';
      if (info) {
        const { clave, params } = rangoSegmento(info);
        rango.textContent = t(clave, params);
      }
      segmento.append(nombre, rango);

      // A v1 is only read: the parts are text, with their spaces and line breaks as they were written.
      const celdas = (['parte_1', 'parte_2'] as const).map((campo) => {
        const celda = document.createElement('td');
        celda.dataset.etiqueta = t(campo === 'parte_1' ? 'mowaMes.speech.col.parte1' : 'mowaMes.speech.col.parte2');
        const texto = document.createElement('span');
        texto.className = 'mm-speech__parte-texto';
        texto.dataset.campo = campo;
        texto.textContent = parte[campo];
        celda.append(texto);
        return celda;
      });

      const largo = document.createElement('td');
      largo.className = 'num mm-speech__largo';
      largo.dataset.largo = '';
      largo.dataset.etiqueta = t('mowaMes.speech.col.largo');
      // Segment, length and status rise to the top of the stacked block, ahead of the parts.
      largo.dataset.orden = '1';
      largo.textContent = '—';

      const nivel = document.createElement('td');
      nivel.dataset.etiqueta = t('mowaMes.speech.col.estado');
      nivel.dataset.orden = '1';
      const tags = document.createElement('span');
      tags.className = 'mm-speech__nivel';
      tags.dataset.nivelTags = '';
      // Inside the segment's own row, so it reads with its headers; the parts
      // point at it with aria-describedby.
      const ejemplo = document.createElement('p');
      ejemplo.className = 'mono mm-speech__ejemplo';
      ejemplo.id = `mm-ejemplo-${parte.segmento}`;
      ejemplo.dataset.ejemplo = '';
      const borrados = document.createElement('p');
      borrados.className = 'mm-speech__borrados';
      borrados.dataset.borrados = '';
      borrados.hidden = true;
      nivel.append(tags, borrados, ejemplo);

      fila.append(segmento, ...celdas, largo, nivel);
      filas.append(fila);
    });

    pintarPrevisualizacion();
    pintarEstadoSpeech();
  }

  function pintarEstadoSpeech(): void {
    const version = versionActual();
    const guardar = $<HTMLButtonElement>('[data-speech-guardar]');
    const texto = $<HTMLElement>('[data-speech-guardar-texto]');
    const descartar = $<HTMLButtonElement>('[data-speech-descartar]');

    if (!version) {
      guardar.disabled = true;
      descartar.disabled = true;
      texto.textContent = t('mowaMes.speech.guardar.editar');
      return;
    }

    const cambios = estado.v2 !== null && (estado.v2.borrador || hayCambiosV2(version, estado.v2.variantes));
    // A draft of a v1 is always saved as a new version: nothing of it exists yet.
    const modo = estado.v2?.borrador ? 'nueva' : modoGuardado(version);
    const renombrada = modo === 'editar' && inputNombre.value.trim() !== version.nombre;
    texto.textContent = t(modo === 'editar' ? 'mowaMes.speech.guardar.editar' : 'mowaMes.speech.guardar.nueva');
    guardar.disabled = guardar.dataset.loading === 'true' || !(cambios || renombrada);
    descartar.disabled = !cambios && !renombrada;
  }

  function pintarPrevisualizacion(): void {
    const vista = estado.previsualizacion;
    const filas = document.querySelectorAll<HTMLTableRowElement>('[data-speech-filas] tr[data-segmento]');

    filas.forEach((fila) => {
      const segmento = vista?.segmentos.find((s) => s.segmento === fila.dataset.segmento);
      const largo = fila.querySelector<HTMLElement>('[data-largo]')!;
      const nivelCelda = fila.querySelector<HTMLElement>('[data-nivel-tags]')!;
      const ejemplo = fila.querySelector<HTMLElement>('[data-ejemplo]');
      const borrados = fila.querySelector<HTMLElement>('[data-borrados]')!;
      nivelCelda.replaceChildren();

      if (!segmento || !vista) {
        largo.textContent = '—';
        fila.dataset.nivelLargo = '';
        if (ejemplo) ejemplo.textContent = '';
        pintarBorrados(borrados, []);
        return;
      }
      pintarBorrados(borrados, segmento.caracteres_quitados);

      // A segment with no maximum (`largo_maximo` null) shows "—" and no level, the same
      // criterion as when the WhatsApp is missing; a number never goes to `formatNumber` as null.
      const nivel = nivelDeFila(segmento);
      fila.dataset.nivelLargo = nivel ?? '';
      largo.textContent =
        segmento.falta_whatsapp || segmento.largo_maximo === null ? '—' : formatNumber(segmento.largo_maximo);

      if (nivel !== null) {
        const tag = document.createElement('span');
        const variante = { ok: 'vigente', advertencia: 'advertencia', excede: 'error', falta_whatsapp: 'neutral' }[nivel];
        tag.className = `tag tag--${variante}`;
        tag.textContent = t(`mowaMes.speech.nivel.${nivel}`);
        nivelCelda.append(tag);
      }

      if (segmento.codigo) {
        const detalle = document.createElement('span');
        detalle.className = 'mm-speech__detalle';
        detalle.textContent = traducirCodigo(segmento.codigo, segmento.codigo);
        nivelCelda.append(detalle);
      }
      if (segmento.usa_whatsapp) {
        const usa = document.createElement('span');
        usa.className = 'tag tag--neutral';
        usa.textContent = t('mowaMes.speech.usaWhatsapp');
        nivelCelda.append(usa);
      }

      if (ejemplo) {
        ejemplo.textContent = segmento.ejemplo
          ? t('mowaMes.speech.ejemplo', { mensaje: segmento.ejemplo })
          : t('mowaMes.speech.sinEjemplo');
      }
    });

    const faltaWhatsapp = Boolean(vista?.segmentos.some((s) => s.falta_whatsapp));
    $<HTMLElement>('[data-speech-falta-whatsapp]').hidden = !faltaWhatsapp;

    const problemas = vista?.problemas ?? [];
    $<HTMLElement>('[data-speech-problemas]').hidden = problemas.length === 0;
    const lista = $<HTMLElement>('[data-speech-problemas-lista]');
    lista.replaceChildren();
    problemas.forEach((problema) => {
      const item = document.createElement('li');
      const donde = problema.segmento
        ? (versionActual()?.partes.find((p) => p.segmento === problema.segmento)?.etiqueta ?? problema.segmento)
        : null;
      item.textContent = donde ? `${donde}: ${problema.detalle}` : problema.detalle;
      lista.append(item);
    });

    // Written only when it changes: a live region re-announces every write,
    // and a preview that did not move levels has nothing new to say.
    const resumen = $<HTMLElement>('[data-speech-resumen]');
    const textoResumen = vista ? resumenNiveles(vista.segmentos) : '';
    if (resumen.textContent !== textoResumen) resumen.textContent = textoResumen;

    $<HTMLElement>('[data-speech-calculo]').textContent = vista
      ? `${t('mowaMes.speech.calculo', {
          advertencia: vista.largo_advertencia,
          maximo: vista.largo_maximo,
        })} ${t('mowaMes.speech.calculoUnidad')}`
      : '';
  }

  function programarPrevisualizacion(espera: number): void {
    window.clearTimeout(temporizadorPrevisualizacion);
    temporizadorPrevisualizacion = window.setTimeout(() => void previsualizar(), espera);
  }

  async function previsualizar(): Promise<void> {
    if (!versionActual()) return;
    if (estado.v2) return previsualizarV2();
    controlPrevisualizacion?.abort();
    const control = new AbortController();
    controlPrevisualizacion = control;
    formSpeech.dataset.calculando = 'true';

    try {
      estado.previsualizacion = await previsualizarSpeech({ partes: estado.borrador }, control.signal);
      pintarPrevisualizacion();
    } catch (caido) {
      if (caido instanceof DOMException && caido.name === 'AbortError') return;
      estado.previsualizacion = null;
      pintarPrevisualizacion();
      $<HTMLElement>('[data-speech-error]').textContent = mensajeDeError(caido);
    } finally {
      if (controlPrevisualizacion === control) delete formSpeech.dataset.calculando;
    }
  }

  // ---- Speech v2 ---------------------------------------------------------------

  const v2El = {
    convertir: $<HTMLElement>('[data-v2-convertir]'),
    boton: $<HTMLButtonElement>('[data-v2-convertir-boton]'),
    bloque: $<HTMLElement>('[data-v2-editor-bloque]'),
    borrador: $<HTMLElement>('[data-v2-borrador]'),
    borradorTexto: $<HTMLElement>('[data-v2-borrador-texto]'),
    raiz: $<HTMLElement>('#mm-speech-v2'),
  };
  let ctlV2: ControladorVariantes | null = null;
  let montandoV2: Promise<void> | null = null;
  /** Which content the editor was last given, so a repaint does not re-feed (and re-validate) it. */
  let fuenteV2 = '';

  /** The first segment control the analyst can see: a button (wide screens) or the select (narrow). */
  function enfocarEditorV2(): void {
    const visibles = [
      ...v2El.raiz.querySelectorAll<HTMLElement>('[data-segmento-botones] button, [data-segmento-select]'),
    ].filter((n) => n.offsetParent !== null);
    visibles[0]?.focus();
  }

  /** v1 is hidden only while a v2 is on screen; its markup and code are the same either way. */
  function mostrarRama(): void {
    const enV2 = estado.v2 !== null;
    document.querySelectorAll<HTMLElement>('[data-speech-v1]').forEach((nodo) => {
      nodo.hidden = enV2;
    });
    v2El.bloque.hidden = !enV2;
    if (!enV2) pintarArchivados([]);
    const version = versionActual();
    // A disabled version is only read, whatever its format: nothing to save, nothing to convert (RF-MM-29).
    const soloLectura = version !== null && !estaHabilitada(version);
    // A v1 is only read (RF-MM-17, M3): there is nothing to save until it is converted.
    $<HTMLElement>('[data-speech-pie]').hidden = !enV2 || soloLectura;
    v2El.convertir.hidden = enV2 || !version || esV2(version) || soloLectura;
  }

  async function asegurarEditorV2(): Promise<ControladorVariantes | null> {
    if (ctlV2) return ctlV2;
    if (!estado.v2) return null;
    if (!montandoV2) {
      v2El.raiz.addEventListener(EVENTO_VARIANTES, (evento) => {
        const detalle = (evento as CustomEvent<EstadoVariantes>).detail;
        estado.v2Editor = { pendiente: detalle.pendiente, valida: detalle.valida };
        // What a test (or a script) can wait on: the editor has finished validating every segment.
        v2El.raiz.dataset.pendiente = String(detalle.pendiente);
        if (detalle.origen === 'usuario' && estado.v2) {
          estado.v2.variantes = detalle.variantes.map((v) => ({ ...v }));
          programarPrevisualizacion(ESPERA_PREVISUALIZACION);
        }
        // The segment on screen can change with no click or change on our side (saving jumps to an empty
        // one, a problem is opened from the list, the chosen segment disappears): every such change ends
        // in this event, so the line follows the segment from here too.
        pintarBorradosV2();
        pintarEstadoSpeech();
      });
      const segmentos = estado.v2.segmentos;
      // Choosing a segment by hand repaints at once, without waiting for the editor to validate it.
      v2El.raiz.addEventListener('click', () => pintarBorradosV2());
      v2El.raiz.addEventListener('change', () => pintarBorradosV2());
      montandoV2 = montarVariantes(v2El.raiz, {
        contexto: 'mowa_mes.speech',
        segmentos,
        porDefecto: null,
        variantes: estado.v2.variantes,
        // No default content: every segment carries its own message (RF-MM-14).
        conPorDefecto: false,
        resumen: 'ninguno',
      }).then((ctl) => {
        ctlV2 = ctl;
        fuenteV2 = 'montado';
      });
    }
    await montandoV2;
    return ctlV2;
  }

  function nombreDelSegmento(clave: string | null): string {
    if (clave === null) return '';
    return estado.v2?.segmentos.find((s) => s.clave === clave)?.etiqueta ?? clave;
  }

  function mostrarProblemasV2(problemas: ProblemaSpeech[]): void {
    const caja = $<HTMLElement>('[data-speech-problemas]');
    const lista = $<HTMLElement>('[data-speech-problemas-lista]');
    caja.hidden = problemas.length === 0;
    lista.replaceChildren();
    for (const problema of problemas) {
      const item = document.createElement('li');
      const donde = nombreDelSegmento(problema.segmento);
      const texto = mensajeDeProblema(problema);
      item.textContent = donde ? t('mowaMes.speech.v2.problema', { segmento: donde, mensaje: texto }) : texto;
      lista.append(item);
    }
  }

  function pintarSpeechV2(version: VersionSpeech): void {
    const v2 = estado.v2!;
    const meta = [t('mowaMes.speech.creada', { fecha: formatDateTime(version.creado_en) })];
    const base = estado.versiones.find((v) => v.id === version.basada_en_id);
    if (base) meta.push(t('mowaMes.speech.basadaEn', { nombre: base.nombre }));
    $<HTMLElement>('[data-speech-meta]').textContent = meta.join('  ·  ');

    // The same rule as v1 (RF-MM-17): the original and a used version never change. A disabled one is not
    // even edited into a new version: it is read until it is enabled (RF-MM-29).
    const deshabilitada = !estaHabilitada(version);
    const inmutable = deshabilitada || (!v2.borrador && modoGuardado(version) === 'nueva');
    $<HTMLElement>('[data-speech-inmutable]').hidden = !inmutable;
    // Only a used v2 is immutable: the original is a v1, which has its own notice.
    $<HTMLElement>('[data-speech-inmutable-texto]').textContent = t(
      deshabilitada ? 'mowaMes.speech.inmutable.deshabilitada' : 'mowaMes.speech.inmutable.usada',
    );
    inputNombre.placeholder =
      v2.borrador && v2.nombreSugerido
        ? v2.nombreSugerido
        : modoGuardado(version) === 'nueva'
          ? t('mowaMes.speech.nombre.automatico')
          : '';

    v2El.borrador.hidden = !v2.borrador;
    if (v2.borrador) {
      v2El.borradorTexto.textContent = t('mowaMes.speech.v2.borrador', { base: version.nombre });
    }
    $<HTMLElement>('[data-speech-falta-whatsapp]').hidden = true;
    pintarArchivados([]);
    mostrarProblemasV2(v2.problemas);

    void asegurarEditorV2().then((ctl) => {
      if (!ctl || !estado.v2) return;
      const fuente = `${versionActual()?.id ?? ''}:${estado.v2.borrador ? 'borrador' : 'guardada'}`;
      if (fuenteV2 !== fuente) {
        fuenteV2 = fuente;
        ctl.fijarSegmentos(estado.v2.segmentos);
        ctl.fijarVariantes({ porDefecto: null, variantes: estado.v2.variantes });
      }
      // The editor's own read-only mode, set every time: it outlives the version that asked for it.
      ctl.fijarSoloLectura(deshabilitada);
      pintarBorradosV2();
    });
    pintarBorradosV2();
    pintarEstadoSpeech();
  }

  async function previsualizarV2(): Promise<void> {
    const v2 = estado.v2;
    if (!v2) return;
    const expresiones = entradaDeExpresiones(v2.variantes);
    const ctl = await asegurarEditorV2();
    if (expresiones.length === 0) {
      estado.largosV2 = [];
      ctl?.fijarNiveles({});
      pintarBorradosV2();
      pintarArchivados([]);
      return;
    }
    controlPrevisualizacion?.abort();
    const control = new AbortController();
    controlPrevisualizacion = control;
    formSpeech.dataset.calculando = 'true';
    try {
      const vista = await previsualizarSpeech({ expresiones }, control.signal);
      if (estado.v2 !== v2) return;
      estado.largosV2 = vista.segmentos;
      ctl?.fijarNiveles(nivelesDeV2(vista.segmentos));
      pintarBorradosV2();
      $<HTMLElement>('[data-speech-falta-whatsapp]').hidden = !vista.segmentos.some((s) => s.falta_whatsapp);
      pintarArchivados(vista.campos_archivados);
      mostrarProblemasV2(vista.problemas);
    } catch (caido) {
      if (caido instanceof DOMException && caido.name === 'AbortError') return;
      // A preview that failed says nothing about archived fields.
      pintarArchivados([]);
      if (caido instanceof ApiError && caido.status === 400) {
        const problemas = problemasDeErrorSpeech(caido);
        if (problemas.length > 0) mostrarProblemasV2(problemas);
        else $<HTMLElement>('[data-speech-error]').textContent = mensajeDeError(caido);
        return;
      }
      $<HTMLElement>('[data-speech-error]').textContent = mensajeDeError(caido);
    } finally {
      if (controlPrevisualizacion === control) delete formSpeech.dataset.calculando;
    }
  }

  v2El.boton.addEventListener('click', async () => {
    const version = versionActual();
    if (!version || esV2(version)) return;
    ocupado(v2El.boton, true);
    try {
      const borrador = await obtenerComoV2(version.id);
      // Nothing is saved: this is a draft until «Guardar como versión nueva».
      estado.v2 = {
        borrador: true,
        baseId: borrador.basada_en_id,
        nombreSugerido: borrador.nombre_sugerido,
        variantes: variantesDeVersion(borrador),
        segmentos: segmentosDeVersion(borrador),
        problemas: borrador.problemas,
      };
      fuenteV2 = '';
      inputNombre.value = '';
      $<HTMLElement>('[data-speech-error]').textContent = '';
      pintarSpeech();
      programarPrevisualizacion(0);
      // The button that was pressed is now hidden: focus goes to the editor, where the work is. The
      // list of segments no longer repaints after each validation, so the focus placed once the
      // editor is mounted stays on its button.
      await asegurarEditorV2();
      enfocarEditorV2();
    } catch (caido) {
      $<HTMLElement>('[data-speech-error]').textContent = mensajeDeError(caido);
    } finally {
      ocupado(v2El.boton, false);
    }
  });

  /** Typed content that leaving this version would drop. */
  function hayCambiosPendientes(): boolean {
    const version = versionActual();
    return estado.v2 ? estado.v2.borrador || (version !== null && hayCambiosV2(version, estado.v2.variantes)) : false;
  }

  selectVersion.addEventListener('change', () => {
    const version = versionActual();
    const pendientes = hayCambiosPendientes();
    if (version && pendientes) {
      // Switching versions would silently drop typed parts; ask by staying put
      // and telling what to do instead.
      selectVersion.value = String(estado.versionId);
      $<HTMLElement>('[data-speech-error]').textContent = t('mowaMes.speech.cambiosPendientes');
      return;
    }
    elegirVersion(Number(selectVersion.value));
  });

  inputNombre.addEventListener('input', () => {
    $<HTMLElement>('[data-speech-error]').textContent = '';
    inputNombre.removeAttribute('aria-invalid');
    pintarEstadoSpeech();
  });

  $<HTMLButtonElement>('[data-speech-descartar]').addEventListener('click', () => {
    elegirVersion(estado.versionId);
  });

  formSpeech.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    const version = versionActual();
    // Only a v2 is saved: a v1 has no footer (RF-MM-17, M3), the backend refuses its parts.
    if (!version || !estado.v2 || !estaHabilitada(version)) return;

    const error = $<HTMLElement>('[data-speech-error]');
    error.textContent = '';
    const modo = modoGuardado(version);
    const nombre = inputNombre.value.trim();

    if (modo === 'editar' && nombre === '') {
      error.textContent = t('mowaMes.speech.error.nombreVacio');
      inputNombre.setAttribute('aria-invalid', 'true');
      inputNombre.setAttribute('aria-describedby', 'mm-speech-error');
      inputNombre.focus();
      return;
    }

    // A segment with nothing, or an editor that still has problems, is not sent (§4).
    const vacios = segmentosSinContenido(estado.v2.variantes, estado.v2.segmentos);
    if (vacios.length > 0) {
      error.textContent = t('mowaMes.speech.v2.error.sinContenido', {
        segmentos: vacios.map((v) => v.etiqueta).join(', '),
      });
      ctlV2?.seleccionar(vacios[0].clave);
      return;
    }
    if (estado.v2Editor.pendiente || !estado.v2Editor.valida) {
      error.textContent = t(
        estado.v2Editor.pendiente ? 'mowaMes.speech.v2.error.pendiente' : 'mowaMes.speech.v2.error.editor',
      );
      return;
    }

    const guardar = $<HTMLButtonElement>('[data-speech-guardar]');
    ocupado(guardar, true);
    try {
      const guardada =
        modo === 'editar'
          ? await editarSpeech(version.id, { nombre, expresiones: entradaDeExpresiones(estado.v2.variantes) })
          : await crearSpeech({
              nombre: nombre || null,
              basada_en_id: estado.v2.borrador ? estado.v2.baseId : version.id,
              expresiones: entradaDeExpresiones(estado.v2.variantes),
            });
      estado.versiones = await listarSpeech();
      ocupado(guardar, false);
      elegirVersion(guardada.id);
      avisar(
        $<HTMLElement>('[data-speech-estado]'),
        modo === 'editar' ? 'mowaMes.speech.guardada' : 'mowaMes.speech.creadaNueva',
      );
    } catch (caido) {
      if (caido instanceof ApiError && caido.status === 409 && modo === 'editar') {
        // Either a campaign used it meanwhile or the name is taken; the reason
        // says which, and a fresh list makes the version read-only if needed.
        error.textContent = caido.detail || t('mowaMes.speech.error.usada');
        const borrador = estado.borrador;
        estado.versiones = await listarSpeech().catch(() => estado.versiones);
        pintarVersiones();
        estado.borrador = borrador;
        pintarSpeech();
      } else if (caido instanceof ApiError && caido.status === 400) {
        // The backend's located problems: each says its segment and the catalogue its code is from.
        const problemas = problemasDeErrorSpeech(caido);
        if (problemas.length > 0) {
          mostrarProblemasV2(problemas);
          error.textContent = caido.detail;
        } else {
          error.textContent = mensajeDeError(caido);
        }
      } else if (caido instanceof ApiError && caido.status === 409) {
        error.textContent = t('mowaMes.speech.error.nombreRepetido');
        inputNombre.setAttribute('aria-invalid', 'true');
        inputNombre.setAttribute('aria-describedby', 'mm-speech-error');
        inputNombre.focus();
      } else {
        error.textContent = mensajeDeError(caido);
      }
    } finally {
      ocupado(guardar, false);
      pintarEstadoSpeech();
    }
  });

  // ---- Administering versions (RF-MM-28 to RF-MM-30) ------------------------------------

  const botonRenombrar = $<HTMLButtonElement>('[data-speech-renombrar]');
  const botonDeshabilitar = $<HTMLButtonElement>('[data-speech-deshabilitar]');
  const formRenombrar = $<HTMLFormElement>('[data-renombrar-form]');
  const inputRenombrar = $<HTMLInputElement>('[data-renombrar-nombre]');
  const errorRenombrar = $<HTMLElement>('[data-renombrar-error]');
  const confirmarRenombrar = $<HTMLButtonElement>('[data-renombrar-confirmar]');
  let renombrando = false;

  /** «Renombrar» is off while there is nothing to do (the same name, edge spaces aside) or a rename is on its way. */
  function pintarConfirmarRenombrar(): void {
    const actual = versionActual()?.nombre ?? '';
    confirmarRenombrar.disabled = renombrando || !hayNombreNuevo(actual, inputRenombrar.value);
    confirmarRenombrar.dataset.loading = renombrando ? 'true' : 'false';
  }

  function abrirRenombrar(): void {
    const version = versionActual();
    if (!version) return;
    $<HTMLElement>('[data-renombrar-titulo]').textContent = t('mowaMes.speech.renombrar.titulo', { nombre: version.nombre });
    inputRenombrar.value = version.nombre;
    inputRenombrar.maxLength = LARGO_NOMBRE_SPEECH;
    errorRenombrar.textContent = '';
    inputRenombrar.removeAttribute('aria-invalid');
    pintarConfirmarRenombrar();
    void openWhenFree(dialogos.renombrar).then(() => {
      inputRenombrar.focus();
      inputRenombrar.select();
    });
  }

  /** The reason under the field, in the screen's own words: the backend's `detail` is Spanish prose. */
  function textoDeErrorDeRenombrar(error: unknown): string {
    const clasificado = clasificarErrorDeRenombrarSpeech(error);
    if (clasificado.tipo === 'repetido') return t('mowaMes.speech.renombrar.repetido');
    if (clasificado.tipo === 'invalido') return t('mowaMes.speech.renombrar.invalido', { max: LARGO_NOMBRE_SPEECH });
    return mensajeDeError(error);
  }

  botonRenombrar.addEventListener('click', abrirRenombrar);
  // Closing by any way (Cancel, Escape, a rename that worked) returns the focus to the button.
  dialogos.renombrar.addEventListener('close', () => botonRenombrar.focus());

  inputRenombrar.addEventListener('input', () => {
    errorRenombrar.textContent = '';
    inputRenombrar.removeAttribute('aria-invalid');
    pintarConfirmarRenombrar();
  });

  formRenombrar.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    const version = versionActual();
    if (!version || renombrando || !hayNombreNuevo(version.nombre, inputRenombrar.value)) return;
    renombrando = true;
    errorRenombrar.textContent = '';
    pintarConfirmarRenombrar();
    try {
      const renombrada = await modificarSpeech(version.id, { nombre: inputRenombrar.value.trim() });
      // The footer's name field follows only if it still held the old name: what was typed there stays.
      if (inputNombre.value === version.nombre) inputNombre.value = renombrada.nombre;
      estado.versiones = conVersion(estado.versiones, renombrada);
      dialogos.renombrar.close();
      pintarVersiones();
      pintarSpeech();
      anunciar(t('mowaMes.speech.renombrar.hecho', { nombre: renombrada.nombre }));
    } catch (error) {
      errorRenombrar.textContent = textoDeErrorDeRenombrar(error);
      inputRenombrar.setAttribute('aria-invalid', 'true');
      inputRenombrar.focus();
    } finally {
      renombrando = false;
      pintarConfirmarRenombrar();
    }
  });

  /** Leaving the version on screen would drop what was typed: say so where the analyst is, and stay. */
  function avisarCambiosPendientes(): void {
    $<HTMLElement>('[data-speech-error]').textContent = t('mowaMes.speech.cambiosPendientes');
    selectVersion.scrollIntoView({ block: 'center' });
    selectVersion.focus();
  }

  botonDeshabilitar.addEventListener('click', async () => {
    const version = versionActual();
    if (!version) return;
    if (hayCambiosPendientes()) {
      avisarCambiosPendientes();
      return;
    }
    ocupado(botonDeshabilitar, true);
    try {
      const nueva = await modificarSpeech(version.id, { habilitada: false });
      estado.versiones = conVersion(estado.versiones, nueva);
      pintarVersiones();
      // Still on screen, now read-only: the editor's mode and the padlock notice follow.
      pintarSpeech();
      anunciar(t('mowaMes.configuracion.deshabilitada', { nombre: nueva.nombre }));
      // The button that was pressed is gone with the actions: the focus goes to the selector.
      selectVersion.focus();
    } catch (caido) {
      mostrarError(caido);
    } finally {
      ocupado(botonDeshabilitar, false);
    }
  });

  /** «Ver»: the disabled version opens in the editor, read-only, above. */
  function verVersion(id: number): void {
    if (hayCambiosPendientes()) {
      avisarCambiosPendientes();
      return;
    }
    elegirVersion(id);
    selectVersion.scrollIntoView({ block: 'center' });
    selectVersion.focus();
  }

  /** The row that follows a disabled version in its list, or the selector when it was the last. */
  function enfocarSiguienteDeshabilitada(id: number | null): void {
    const fila = id === null ? null : document.querySelector<HTMLElement>(`[data-deshab-lista] [data-version="${id}"] button`);
    (fila ?? selectVersion).focus();
  }

  async function habilitarVersion(version: VersionSpeech): Promise<void> {
    const lista = deshabilitadas(estado.versiones);
    const siguiente = lista[lista.findIndex((v) => v.id === version.id) + 1]?.id ?? null;
    try {
      const nueva = await modificarSpeech(version.id, { habilitada: true });
      estado.versiones = conVersion(estado.versiones, nueva);
      pintarVersiones();
      // If it was the one on screen it is editable again (unless a campaign used it).
      if (estado.versionId === nueva.id) pintarSpeech();
      anunciar(t('mowaMes.configuracion.habilitada', { nombre: nueva.nombre }));
      enfocarSiguienteDeshabilitada(siguiente);
    } catch (caido) {
      mostrarError(caido);
    }
  }

  // Deleting for good: the danger notice and the mandatory checkbox (§4.6).
  const casillaEliminar = $<HTMLInputElement>('[data-eliminar-casilla]');
  const aceptarEliminar = $<HTMLButtonElement>('[data-eliminar-aceptar]');
  const errorEliminar = $<HTMLElement>('[data-eliminar-error]');
  let porEliminar: VersionSpeech | null = null;
  let eliminando = false;

  function pintarAceptarEliminar(): void {
    aceptarEliminar.disabled = eliminando || !casillaEliminar.checked;
    aceptarEliminar.dataset.loading = eliminando ? 'true' : 'false';
  }

  casillaEliminar.addEventListener('change', pintarAceptarEliminar);

  async function pedirEliminar(version: VersionSpeech): Promise<void> {
    porEliminar = version;
    $<HTMLElement>('[data-eliminar-titulo]').textContent = t('mowaMes.confirmar.eliminar.tituloVersion', {
      nombre: version.nombre,
    });
    casillaEliminar.checked = false;
    errorEliminar.textContent = '';
    pintarAceptarEliminar();
    await openWhenFree(dialogos.eliminar);
    // Neither deleting nor a keystroke by accident: the focus starts on «Cancelar».
    $<HTMLButtonElement>('[data-eliminar-cancelar]').focus();
  }

  aceptarEliminar.addEventListener('click', async () => {
    const version = porEliminar;
    if (!version || eliminando || !casillaEliminar.checked) return;
    const lista = deshabilitadas(estado.versiones);
    const siguiente = lista[lista.findIndex((v) => v.id === version.id) + 1]?.id ?? null;
    eliminando = true;
    errorEliminar.textContent = '';
    pintarAceptarEliminar();
    try {
      await eliminarSpeech(version.id);
      dialogos.eliminar.close();
      estado.versiones = sinVersion(estado.versiones, version.id);
      // If it was the one on screen, the screen goes back to the first enabled version.
      if (estado.versionId === version.id) elegirVersion(habilitadas(estado.versiones)[0]?.id ?? null);
      else pintarVersiones();
      anunciar(t('mowaMes.configuracion.eliminada', { nombre: version.nombre }));
      enfocarSiguienteDeshabilitada(siguiente);
    } catch (caido) {
      // A 409 carries its `codigo` (the list says what can go, so this is a race): its own text, inside the dialog.
      errorEliminar.textContent =
        caido instanceof ApiError && caido.codigo
          ? traducirPorPrefijo('mowaMes.errorSpeech', caido.codigo, mensajeDeError(caido))
          : mensajeDeError(caido);
      // The list may be out of date: read it again, quietly.
      if (caido instanceof ApiError) {
        void listarSpeech()
          .then((versiones) => {
            estado.versiones = versiones;
            pintarVersiones();
          })
          .catch(() => undefined);
      }
    } finally {
      eliminando = false;
      pintarAceptarEliminar();
    }
  });

  // ---- Boot --------------------------------------------------------------------

  function sinConexion(si: boolean): void {
    $<HTMLElement>('[data-offline]').hidden = !si;
    $<HTMLElement>('[data-contenido]').hidden = si;
    document.dispatchEvent(new CustomEvent('healthchanged'));
  }

  async function arrancar(): Promise<void> {
    try {
      const [configuracion, versiones] = await Promise.all([obtenerConfiguracion(), listarSpeech()]);

      estado.configuracion = configuracion;
      estado.versiones = versiones;

      sinConexion(false);
      pintarPlataforma();
      // The original comes first in the list; a fresh screen starts from the first enabled version.
      elegirVersion(habilitadas(versiones)[0]?.id ?? null);
    } catch (caido) {
      if (caido instanceof NetworkError) {
        sinConexion(true);
      } else {
        sinConexion(false);
        mostrarError(caido);
      }
    }
  }

  const reintentar = $<HTMLButtonElement>('[data-reintentar]');
  reintentar.addEventListener('click', async () => {
    ocupado(reintentar, true);
    try {
      await arrancar();
    } finally {
      ocupado(reintentar, false);
    }
  });

  // A language switch repaints what the script drew, keeping every draft.
  document.addEventListener('languagechange', () => {
    applyTranslations();
    pintarMetaPlataforma();
    void revisarPlantilla(0);
    pintarVersiones();
    pintarSpeech();
  });

  void arrancar();
</script>
