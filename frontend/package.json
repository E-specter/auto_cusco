{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contrato": "node herramientas/contrato/generar.mjs",
    "contrato:comprobar": "node herramientas/contrato/generar.mjs --comprobar",
    "tipos": "astro sync && tsc --noEmit -p tsconfig.json",
    "verificar": "npm run contrato:comprobar && astro check && npm run tipos && npm run build:produccion && npm run test && npm run test:e2e",
    "build:produccion": "astro build && node herramientas/comprobar-build-produccion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.4",
    "lucide-static": "^1.45.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
