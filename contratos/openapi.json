    },
    "/archivos-carga": {
      "post": {
        "tags": [
          "archivos de carga"
        ],
        "summary": "Generar Archivo",
        "description": "Genera la carga completa y devuelve el archivo (RF-09, RF-13, RF-15).\n\nEl resumen viaja en cabeceras `X-Carga-*` porque el cuerpo es el archivo;\nel detalle de los errores se consulta en `/previsualizacion`.",
        "operationId": "generar_archivo_archivos_carga_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeticionGeneracion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "El archivo de carga en el formato pedido",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=\"<nombre>.<extension>\"",
                "schema": {
                  "type": "string"
                }
              },
              "X-Carga-Generados": {
                "description": "Filas escritas en el archivo",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "X-Carga-Disponibles": {
                "description": "Productos que cumplen la seleccion completa",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "X-Carga-Solicitados": {
                "description": "Cantidad de productos pedida",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "X-Carga-Suficiente": {
                "description": "1 si habia al menos tantos productos como se pidieron, 0 si no",
                "schema": {
                  "type": "string",
                  "enum": [
                    "0",
                    "1"
                  ]
                }
              },
              "X-Carga-Errores": {
                "description": "Campos que no se pudieron generar; el detalle esta en /previsualizacion",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "La peticion no se puede atender tal como viene; el motivo esta en detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalleError"
                }
              }
            }
          },
          "404": {
            "description": "No existe lo pedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalleError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
