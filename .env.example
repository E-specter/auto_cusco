# Plantilla de variables de entorno — copiar a .env y completar con valores reales.
# .env nunca se versiona (ver .gitignore). Este archivo (.env.example) sí se versiona
# y debe mantenerse actualizado cada vez que se agregue una variable nueva.

# ---------- Base de datos (PostgreSQL, ver docs/architecture.md) ----------
# El rol y la base de datos se crean con backend/scripts/init_db.sql
# (ejecutar una vez, como superusuario de PostgreSQL, ver instrucciones en ese script).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auto_cusco
DB_USER=auto_cusco_app
# Usa solo letras y numeros. Evita: @, % seguido de dos hexadecimales (p. ej. %40),
# la secuencia ${ y un espacio seguido de #. Detalle en docs/setup.md, seccion 6.1.
DB_PASSWORD=changeme

# ---------- API: origenes permitidos (CORS) ----------
# Lista separada por comas de los origenes del frontend. Vacio = la API no envia
# cabeceras CORS. En desarrollo no hace falta: el dev server de Astro redirige
# /api al backend, asi que el navegador ve un solo origen.
# Ejemplo: CORS_ORIGENES=http://localhost:4321,https://app.midominio.pe
CORS_ORIGENES=

# ---------- Backend (FastAPI, ver backend/AGENTS.md) ----------
# BACKEND_ENV=development

# ---------- Frontend (Astro) ----------
# Ninguna variable requerida todavía. Si se agrega alguna pública, debe
# prefijarse con PUBLIC_ (convención de Astro) para poder usarse en el cliente,
# p. ej.: PUBLIC_API_URL=http://localhost:8000
