# Datos: no versionar contenido real, solo la estructura de carpetas
data/sabanas/**
!data/sabanas/.gitkeep
!data/sabanas/**/
data/output/**
!data/output/.gitkeep
!data/output/**/.gitkeep
!data/output/**/
data/*.db
data/*.db-journal
data/*.sqlite3

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Astro
node_modules/
dist/
.astro/

# Entorno
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db

# Herramientas de diseño (impeccable): las capturas y el servidor de preguntas
# son artefactos de una sesión; el contrato de superficie sí se versiona.
.impeccable/review/
.impeccable/questions/

# Adjuntos compartidos en el chat (ejemplos de plataformas con datos de cobranza):
# se leen como referencia, nunca se versionan.
archivos_anexo_chat/
